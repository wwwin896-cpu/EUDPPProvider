---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article' | 'product';
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = 'EU DPP Provider | Enterprise EU Battery Passport Platform & Sovereign Data Vault',
  description = 'Turnkey EU Battery Passport compliance (Regulation EU 2023/1542). Enterprise DPP software licensing and fully managed 10-year data hosting with zero-knowledge privacy.',
  image = 'https://www.eudppprovider.com/og-image.png',
  canonicalUrl = Astro.url.href,
  type = 'website'
} = Astro.props;

const siteUrl = 'https://www.eudppprovider.com';

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "EU DPP Provider",
      "url": siteUrl,
      "logo": `${siteUrl}/eudpp_logo_light.svg`,
      "description": "Enterprise EU Battery Passport Software and Managed DPP Data Hosting Provider.",
      "sameAs": [
        "https://www.linkedin.com/company/eu-dpp-provider"
      ]
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}/#software`,
      "name": "EU DPP Enterprise Suite",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Cloud, On-Premise, Kubernetes",
      "offers": {
        "@type": "Offer",
        "priceCurrency": "EUR",
        "description": "Enterprise Software Licensing & Managed Data Vault Hosting for EU Battery Passports"
      }
    }
  ]
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Tags for Multi-language SEO -->
    <link rel="alternate" hreflang="x-default" href="https://www.eudppprovider.com/" />
    <link rel="alternate" hreflang="en" href="https://www.eudppprovider.com/" />
    <link rel="alternate" hreflang="zh" href="https://www.eudppprovider.com/zh/" />
    <link rel="alternate" hreflang="de" href="https://www.eudppprovider.com/de/" />
    <link rel="alternate" hreflang="fr" href="https://www.eudppprovider.com/fr/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="EU DPP Provider" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#EEF2F6] text-slate-900 flex flex-col min-h-screen antialiased selection:bg-cyan-500 selection:text-white">
    
    <Header />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
