---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article' | 'product';
  faqs?: FaqItem[];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const siteUrl = 'https://eudppprovider.com';

const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const defaultCanonical = `${siteUrl}${currentPath === '//' ? '/' : currentPath}`;

const {
  title = 'EU DPP Provider | Enterprise EU Battery Passport Platform & Sovereign Data Vault',
  description = 'Turn supply chain records into an audit-proof data chain. Turnkey enterprise software, 10-year sovereign data vault, ZKP formula secrecy, and official EU Registry filing support (Regulation EU 2023/1542).',
  image = `${siteUrl}/og-image.png`,
  canonicalUrl = defaultCanonical,
  type = 'website',
  faqs = []
} = Astro.props;

// Build multi-layered JSON-LD graph
const schemaGraph: any[] = [
  {
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "EU DPP Provider",
    "url": siteUrl,
    "logo": `${siteUrl}/eudpp_logo_light.svg`,
    "description": "Enterprise EU Battery Passport Software and Managed DPP Data Vault Hosting Provider under Regulation (EU) 2023/1542.",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "info@eudppprovider.com",
      "contactType": "Customer Support and Compliance Desk",
      "availableLanguage": ["English", "Chinese", "German", "French", "Dutch"]
    },
    "sameAs": [
      "https://github.com/wwwin896-cpu/EUDPPProvider"
    ]
  },
  {
    "@type": "SoftwareApplication",
    "@id": `${siteUrl}/#software`,
    "name": "EU DPP Enterprise Suite",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Cloud, On-Premise, Kubernetes, Linux",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "description": "Enterprise Software Licensing & Managed Data Vault Hosting for EU Battery Passports"
    }
  },
  {
    "@type": "Service",
    "@id": `${siteUrl}/#service`,
    "name": "10-Year Managed Sovereign DPP Data Vault",
    "provider": {
      "@id": `${siteUrl}/#organization`
    },
    "serviceType": "Digital Product Passport Data Hosting & Regulatory Filing Support",
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "European Union"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "EU Battery Passport Compliance Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "EV Traction Battery Passport"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "LMT & E-Bike Battery Passport (≤25kg)"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Stationary Storage BESS Battery Passport (>2kWh)"
          }
        }
      ]
    }
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": siteUrl
      },
      ...(currentPath !== '/' && currentPath !== '/zh/' && currentPath !== '/de/' && currentPath !== '/fr/' && currentPath !== '/nl/' ? [
        {
          "@type": "ListItem",
          "position": 2,
          "name": title.split('|')[0].trim(),
          "item": canonicalUrl
        }
      ] : [])
    ]
  }
];

if (faqs && faqs.length > 0) {
  schemaGraph.push({
    "@type": "FAQPage",
    "@id": `${canonicalUrl}#faq`,
    "mainEntity": faqs.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  });
}

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": schemaGraph
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Tags for Multi-language SEO (Unified Bare Domain) -->
    <link rel="alternate" hreflang="x-default" href="https://eudppprovider.com/" />
    <link rel="alternate" hreflang="en" href="https://eudppprovider.com/" />
    <link rel="alternate" hreflang="zh" href="https://eudppprovider.com/zh/" />
    <link rel="alternate" hreflang="de" href="https://eudppprovider.com/de/" />
    <link rel="alternate" hreflang="fr" href="https://eudppprovider.com/fr/" />
    <link rel="alternate" hreflang="nl" href="https://eudppprovider.com/nl/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="EU DPP Provider" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#EEF2F6] text-slate-800 font-sans min-h-screen flex flex-col antialiased selection:bg-cyan-500 selection:text-white">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
