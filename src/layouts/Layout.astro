---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article' | 'product';
  faqs?: FaqItem[];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const siteUrl = 'https://eudppprovider.com';

const rawPath = Astro.url.pathname;
const cleanSlug = rawPath.replace(/^\/(zh|de|fr|nl)(\/|$)/, '/').replace(/^\//, '');
const normalizedSlug = cleanSlug ? `${cleanSlug.replace(/\/$/, '')}/` : '';

const hreflangEn = `${siteUrl}/${normalizedSlug}`;
const hreflangZh = `${siteUrl}/zh/${normalizedSlug}`;
const hreflangDe = `${siteUrl}/de/${normalizedSlug}`;
const hreflangFr = `${siteUrl}/fr/${normalizedSlug}`;
const hreflangNl = `${siteUrl}/nl/${normalizedSlug}`;
const hreflangDefault = hreflangEn;

const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const defaultCanonical = `${siteUrl}${currentPath === '//' ? '/' : currentPath}`;

const {
  title: rawTitle = 'EU DPP Provider | Enterprise EU Battery Passport Platform & Sovereign Data Vault',
  description = 'Turn supply chain records into an audit-proof data chain. Turnkey enterprise software, 10-year sovereign data vault, ZKP formula secrecy, and official EU Registry filing support (Regulation EU 2023/1542).',
  image = `${siteUrl}/og-image.png`,
  canonicalUrl = defaultCanonical,
  type = 'website',
  faqs = [],
  noHreflang = false,
  noindex = false,
  article = null
} = Astro.props;

// Keep SERP titles within display width: drop the brand suffix only when the
// full string would be truncated by search engines.
const brandSuffix = ' | EU DPP Provider';
const title =
  rawTitle.length > 60 && rawTitle.endsWith(brandSuffix)
    ? rawTitle.slice(0, -brandSuffix.length)
    : rawTitle;

// Build multi-layered JSON-LD graph (Pure B2B Professional Entity)
const schemaGraph: any[] = [
  {
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "EU DPP Provider",
    "legalName": "SUZHOU GEEKTION TECHNOLOGY CO.,LTD / EU DPP Provider",
    "taxID": "91320509MAEM4DKR87",
    "url": siteUrl,
    "logo": `${siteUrl}/eudpp_logo_light.svg`,
    "description": "Enterprise EU Battery Passport Software and Managed DPP Data Vault Hosting Provider under Regulation (EU) 2023/1542.",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "info@eudppprovider.com",
      "telephone": "+49-69-96758827",
      "contactType": "Customer Support and Compliance Desk",
      "availableLanguage": ["English", "Chinese", "German", "French", "Dutch"]
    }
  },
  {
    "@type": "SoftwareApplication",
    "@id": `${siteUrl}/#software`,
    "name": "EU DPP Enterprise Suite",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Cloud, On-Premise, Kubernetes, Linux",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "description": "Enterprise Software Licensing & Managed Data Vault Hosting for EU Battery Passports"
    }
  },
  {
    "@type": "Service",
    "@id": `${siteUrl}/#service`,
    "name": "10-Year Managed Sovereign DPP Data Vault",
    "provider": {
      "@id": `${siteUrl}/#organization`
    },
    "serviceType": "Digital Product Passport Data Hosting & Regulatory Filing Support",
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "European Union"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "EU Battery Passport Compliance Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "EV Traction Battery Passport"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "LMT & E-Bike Battery Passport (≤25kg)"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Stationary Storage BESS Battery Passport (>2kWh)"
          }
        }
      ]
    }
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": siteUrl
      },
      ...(currentPath !== '/' && currentPath !== '/zh/' && currentPath !== '/de/' && currentPath !== '/fr/' && currentPath !== '/nl/' ? [
        {
          "@type": "ListItem",
          "position": 2,
          "name": title.split('|')[0].trim(),
          "item": canonicalUrl
        }
      ] : [])
    ]
  }
];

if (article) {
  schemaGraph.push({
    "@type": ["Article", "TechArticle"],
    "@id": `${canonicalUrl}#article`,
    "headline": article.headline || title,
    "description": description,
    "datePublished": article.datePublished,
    "dateModified": article.dateModified || article.datePublished,
    "inLanguage": lang,
    "author": {
      "@type": "Organization",
      "name": article.author || "EU DPP Regulatory Research Team",
      "url": `${siteUrl}/about/`
    },
    "publisher": { "@id": `${siteUrl}/#organization` },
    "mainEntityOfPage": { "@id": canonicalUrl },
    "about": (article.about || []).map((name: string) => ({ "@type": "Thing", "name": name })),
    "isAccessibleForFree": true
  });
}

if (faqs && faqs.length > 0) {
  schemaGraph.push({
    "@type": "FAQPage",
    "@id": `${canonicalUrl}#faq`,
    "mainEntity": faqs.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  });
}

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": schemaGraph
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Deep-Page Aware Hreflang Clusters (Pointing to Matching Language Translations) -->
    {!noHreflang && (
      <>
        <link rel="alternate" hreflang="x-default" href={hreflangDefault} />
        <link rel="alternate" hreflang="en" href={hreflangEn} />
        <link rel="alternate" hreflang="zh" href={hreflangZh} />
        <link rel="alternate" hreflang="de" href={hreflangDe} />
        <link rel="alternate" hreflang="fr" href={hreflangFr} />
        <link rel="alternate" hreflang="nl" href={hreflangNl} />
      </>
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="EU DPP Provider" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

    <!-- Zero-Tracking Local / System Font Stack (GDPR Compliant, No External Google Font Calls) -->
    <style is:global>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      }
      code, pre, .font-mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      }
    </style>
  </head>
  <body class="bg-[#EEF2F6] text-slate-800 font-sans min-h-screen flex flex-col antialiased selection:bg-cyan-500 selection:text-white">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- GDPR / ePrivacy Compliant Cookie Consent Banner -->
    <div id="cookie-consent-banner" class="fixed bottom-4 left-4 right-4 sm:left-auto sm:right-6 sm:max-w-md z-50 p-5 rounded-2xl bg-[#F0F4F8]/95 backdrop-blur-xl border border-white/90 shadow-[10px_10px_30px_rgba(209,217,230,0.8),-10px_-10px_30px_rgba(255,255,255,0.95)] transition-all duration-300">
      <div class="flex items-start gap-3">
        <span class="text-xl">🍪</span>
        <div class="space-y-2 text-xs text-slate-700">
          <div class="font-bold text-slate-900 text-sm">Privacy & Data Governance</div>
          <p class="leading-relaxed">
            We use strictly essential technical cookies to ensure high availability, security, and multi-language routing. No third-party behavioral trackers or foreign ad scripts are executed.
          </p>
          <div class="flex items-center gap-3 pt-1">
            <button id="cookie-accept-btn" class="neo-btn-primary px-4 py-1.5 text-xs">
              Accept Essential
            </button>
            <a href="/privacy/" class="text-[11px] font-bold text-cyan-700 hover:underline">
              Privacy Policy →
            </a>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const banner = document.getElementById('cookie-consent-banner');
        const acceptBtn = document.getElementById('cookie-accept-btn');
        const isConsentGiven = localStorage.getItem('eudpp_cookie_consent');

        if (isConsentGiven) {
          if (banner) banner.classList.add('hidden');
        } else {
          if (banner) banner.classList.remove('hidden');
        }

        if (acceptBtn && banner) {
          acceptBtn.addEventListener('click', () => {
            localStorage.setItem('eudpp_cookie_consent', 'essential_granted');
            banner.classList.add('hidden');
          });
        }
      });
    </script>
  </body>
</html>
