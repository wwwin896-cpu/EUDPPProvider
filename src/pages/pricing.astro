---
import Layout from '../layouts/Layout.astro';
import PricingCalculator from '../components/PricingCalculator.astro';
---

<Layout
  title="Pricing & Deployment Models | EU DPP Provider"
  description="Transparent pricing for EU Battery Passport compliance: Enterprise DPP Software Licenses vs. Turnkey Managed Data Hosting plans."
>
  <div class="py-24 md:py-32 bg-stone-50">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-mono font-medium text-stone-600 uppercase tracking-widest bg-stone-100 px-3.5 py-1.5 rounded-full border border-stone-200">
          Transparent Deployment Options
        </span>
        <h1 class="text-4xl sm:text-6xl font-semibold text-stone-900 tracking-tight mt-6 mb-6">
          Tailored for Every Stage of the Battery Supply Chain
        </h1>
        <p class="text-lg sm:text-xl text-stone-500 leading-relaxed font-normal">
          Whether you produce 5,000 industrial packs or 5 million EV cell modules per year, choose the pricing architecture that maximizes your ROI and compliance speed.
        </p>
      </div>

      <PricingCalculator />

      <!-- Comparison Feature Table (Airy Minimal Table) -->
      <div class="bg-white p-8 sm:p-12 rounded-3xl border border-stone-200 shadow-soft my-20 max-w-5xl mx-auto overflow-x-auto">
        <h3 class="text-2xl font-bold text-stone-900 mb-8">Feature & Architecture Comparison</h3>
        <table class="w-full text-left text-sm border-collapse">
          <thead>
            <tr class="border-b border-stone-200 text-stone-400">
              <th class="py-4 px-4 font-medium">Feature / Capability</th>
              <th class="py-4 px-4 text-stone-900 font-bold">1. Enterprise Software License</th>
              <th class="py-4 px-4 text-emerald-800 font-bold">2. Managed Data Vault Hosting</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100 text-stone-600 font-normal">
            <tr>
              <td class="py-4 px-4 font-semibold text-stone-900">Target Audience</td>
              <td class="py-4 px-4">Tier-1 Cell/Pack Makers, OEMs, Gigafactories</td>
              <td class="py-4 px-4">Battery Exporters, Material Suppliers, ESS Integrators</td>
            </tr>
            <tr>
              <td class="py-4 px-4 font-semibold text-stone-900">Deployment Location</td>
              <td class="py-4 px-4">Customer Private Cloud / On-Premise Airgap</td>
              <td class="py-4 px-4">EU DPP Provider Sovereign Cloud (Frankfurt/Paris)</td>
            </tr>
            <tr>
              <td class="py-4 px-4 font-semibold text-stone-900">Passport Volume Quota</td>
              <td class="py-4 px-4"><strong class="text-stone-900 font-bold">Unlimited</strong> (No per-passport charge)</td>
              <td class="py-4 px-4">Tiered by annual active passport count</td>
            </tr>
            <tr>
              <td class="py-4 px-4 font-semibold text-stone-900">Infrastructure Maintenance</td>
              <td class="py-4 px-4">Managed by Client IT / DevOps</td>
              <td class="py-4 px-4">100% Fully Managed by EU DPP Provider (99.99% SLA)</td>
            </tr>
            <tr>
              <td class="py-4 px-4 font-semibold text-stone-900">PCF Carbon Calculator</td>
              <td class="py-4 px-4">Self-hosted calculation engine & database</td>
              <td class="py-4 px-4">Automated calculation upon BOM upload</td>
            </tr>
            <tr>
              <td class="py-4 px-4 font-semibold text-stone-900">Supply Chain ZKP Privacy</td>
              <td class="py-4 px-4">Native cryptography microservice</td>
              <td class="py-4 px-4">Managed zero-knowledge verification service</td>
            </tr>
            <tr>
              <td class="py-4 px-4 font-semibold text-stone-900">Integration Customization</td>
              <td class="py-4 px-4">Deep SAP/MES/BMS bespoke hooks</td>
              <td class="py-4 px-4">Standard REST Webhooks & Excel Batch Import</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Book CTA -->
      <div class="text-center space-y-4">
        <h3 class="text-3xl font-semibold text-stone-900">Need a Formal Enterprise Quote?</h3>
        <p class="text-base text-stone-500 max-w-lg mx-auto font-normal">
          Contact our pricing team for a customized volume evaluation and ROI analysis.
        </p>
        <a href="/contact" class="inline-flex px-8 py-4 rounded-xl bg-stone-900 text-white font-medium text-base hover:bg-stone-800 transition-colors shadow-soft">
          Request Custom Proposal &rarr;
        </a>
      </div>

    </div>
  </div>
</Layout>
