---
import Layout from '../layouts/Layout.astro';
import PricingCalculator from '../components/PricingCalculator.astro';
---

<Layout
  title="Pricing & Deployment Models | EU DPP Provider"
  description="Transparent enterprise pricing, pilot packages, and interactive deployment calculator for EU Battery Passport software and 10-year sovereign data vault hosting."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Transparent Commercial Framework</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Transparent Pricing & <br class="hidden sm:inline" />
        <span class="text-cyan-600">Deployment Calculator</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        Predictable cost structures for battery cell manufacturers, pack assemblers, and automotive OEMs. Choose between private cloud software licensing or turnkey Frankfurt sovereign vault hosting.
      </p>
    </div>

    <!-- Pricing Calculator & Matrix Component -->
    <PricingCalculator />

    <!-- 3 Tier Commercial Matrix Summary -->
    <div class="mt-16 max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6 text-xs sm:text-sm">
      
      <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="text-xs font-mono font-bold text-cyan-700 uppercase tracking-wider">Pilot Evaluation</div>
          <h3 class="text-xl font-bold text-slate-900 mt-1 mb-2">Early Adopter Pilot</h3>
          <div class="text-2xl font-extrabold text-slate-900 font-mono mb-3">€4,800 <span class="text-xs font-normal text-slate-500">/ single project</span></div>
          <p class="text-slate-600 leading-relaxed">
            Ideal for battery manufacturers needing fast, low-risk compliance pre-validation before volume production.
          </p>
          <ul class="mt-4 space-y-2 text-slate-700">
            <li>✓ 1–3 Battery Pack SKUs</li>
            <li>✓ 90+ Field Gap Analysis</li>
            <li>✓ Frankfurt Sandbox Access</li>
            <li>✓ DG GROW Schema Pre-Validation</li>
          </ul>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200">
          <a href="/contact/" class="text-cyan-700 font-bold hover:underline">Apply for Pilot →</a>
        </div>
      </div>

      <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between border-2 border-cyan-500/40 relative">
        <div class="absolute -top-3 right-6 bg-cyan-600 text-white text-[10px] font-bold px-3 py-0.5 rounded-full uppercase tracking-wider">Most Popular</div>
        <div>
          <div class="text-xs font-mono font-bold text-cyan-700 uppercase tracking-wider">10-Year Turnkey</div>
          <h3 class="text-xl font-bold text-slate-900 mt-1 mb-2">Managed Sovereign Vault</h3>
          <div class="text-2xl font-extrabold text-slate-900 font-mono mb-3">From €12,500 <span class="text-xs font-normal text-slate-500">/ year</span></div>
          <p class="text-slate-600 leading-relaxed">
            Full compliance outsourcing to our ISO 27001 certified Frankfurt data center with 10-year data persistence.
          </p>
          <ul class="mt-4 space-y-2 text-slate-700">
            <li>✓ Up to 100,000 Battery Packs/yr</li>
            <li>✓ 99.9% Uptime SLA Guarantee</li>
            <li>✓ 30-Day Regulatory Schema Updates</li>
            <li>✓ Zero-Knowledge Proof Privacy Shield</li>
          </ul>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200">
          <a href="/contact/" class="neo-btn-primary text-xs w-full text-center inline-block">Request Vault Scoping →</a>
        </div>
      </div>

      <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="text-xs font-mono font-bold text-slate-500 uppercase tracking-wider">Private Infrastructure</div>
          <h3 class="text-xl font-bold text-slate-900 mt-1 mb-2">Enterprise Software Suite</h3>
          <div class="text-2xl font-extrabold text-slate-900 font-mono mb-3">Custom License <span class="text-xs font-normal text-slate-500">/ on-premise</span></div>
          <p class="text-slate-600 leading-relaxed">
            Perpetual or multi-year software licensing for Tier-1 cell makers and automotive OEMs requiring on-premise control.
          </p>
          <ul class="mt-4 space-y-2 text-slate-700">
            <li>✓ Unlimited Serialized Packs</li>
            <li>✓ Native MES / ERP / BMS Connectors</li>
            <li>✓ Zero Per-Scan or Transaction Fees</li>
            <li>✓ Full Source & Infrastructure Control</li>
          </ul>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200">
          <a href="/contact/" class="text-slate-800 font-bold hover:underline">Contact Solutions Desk →</a>
        </div>
      </div>

    </div>

  </div>
</Layout>
