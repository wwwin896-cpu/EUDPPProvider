---
import Layout from '../layouts/Layout.astro';
import PricingCalculator from '../components/PricingCalculator.astro';
---

<Layout
  title="Pricing & Deployment Models | EU DPP Provider"
  description="Transparent commercial models for EU Battery Passport compliance: Enterprise DPP Software Licenses vs. Turnkey Managed Data Hosting plans."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Commercial Delivery Models</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Transparent Pricing & <br class="hidden sm:inline" />
        <span class="text-cyan-600">Enterprise Deployment</span>
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-600 leading-relaxed max-w-2xl mx-auto">
        Choose between full code ownership via Enterprise Software Licensing or effortless delegated compliance with our 10-Year Managed Sovereign Vault.
      </p>

      <div class="mt-6 flex justify-center gap-4">
        <a href="mailto:info@eudppprovider.com" class="neo-btn-primary">
          Request Commercial Scoping →
        </a>
      </div>
    </div>

    <!-- Pricing Calculator Cards Component -->
    <div class="mb-16">
      <PricingCalculator />
    </div>

    <!-- Comparison Table (Clean Neomorphic Surface) -->
    <div class="neo-surface p-8 sm:p-10 max-w-5xl mx-auto">
      <h3 class="text-lg font-bold text-slate-900 mb-6 text-center">Comprehensive Delivery Feature Matrix</h3>
      
      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="py-3 px-4 text-slate-400 font-bold uppercase tracking-wider">Capability / Dimension</th>
              <th class="py-3 px-4 text-cyan-800 font-bold uppercase tracking-wider">Enterprise Software License</th>
              <th class="py-3 px-4 text-green-800 font-bold uppercase tracking-wider">Managed Data Vault (10-Yr)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200/60 text-slate-700">
            <tr>
              <td class="py-3 px-4 font-semibold text-slate-900">Hosting Environment</td>
              <td class="py-3 px-4">Client's Private Cloud (AWS/Azure/Alibaba EU)</td>
              <td class="py-3 px-4 font-semibold text-green-700">EU Sovereign Cloud (Frankfurt/Munich)</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-slate-900">Source Code & Schemas</td>
              <td class="py-3 px-4 font-semibold text-cyan-700">Full Enterprise License & Open APIs</td>
              <td class="py-3 px-4">Fully Managed API Gateway & Webhook Hub</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-slate-900">Per-Scan / Per-Passport Fee</td>
              <td class="py-3 px-4 font-semibold text-green-700">Zero (€0) - Unlimited Serialization</td>
              <td class="py-3 px-4">Predictable Tiered Volume SaaS</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-slate-900">EU Commission Registry Bridge</td>
              <td class="py-3 px-4">Automated Direct Connector Included</td>
              <td class="py-3 px-4 font-semibold text-green-700">Fully Managed eIDAS QSeal & UPI Sync</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-semibold text-slate-900">Regulatory SLA Guarantee</td>
              <td class="py-3 px-4">Annual Maintenance & Version Upgrades</td>
              <td class="py-3 px-4 font-semibold text-green-700">10-Year Active Hosting + 30-Day Legal Patch</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</Layout>
