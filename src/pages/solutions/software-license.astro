---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Enterprise DPP Software License | On-Premise & Private Cloud | EU DPP Provider"
  description="Procure independent Enterprise DPP software licensing for complete data sovereignty, custom ERP/MES/BMS integrations, and unlimited battery serialization."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Enterprise Software License</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Enterprise DPP Software <br class="hidden sm:inline" />
        <span class="text-cyan-600">On-Premise & Private Cloud</span>
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-600 leading-relaxed max-w-2xl mx-auto">
        Procure full commercial software licenses for deployment in your own sovereign IT infrastructure (AWS, Azure, Alibaba Cloud EU, or bare-metal data centers).
      </p>

      <div class="mt-6 flex justify-center gap-4">
        <a href="mailto:info@eudppprovider.com" class="neo-btn-primary">
          Request Software Architecture Briefing →
        </a>
      </div>
    </div>

    <!-- Core Advantages Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-16">
      
      <div class="neo-surface p-7">
        <div class="w-10 h-10 rounded-2xl bg-cyan-100 text-cyan-700 flex items-center justify-center font-bold text-lg mb-4">
          🔐
        </div>
        <h3 class="text-base font-bold text-slate-900 mb-2">100% Code & Data Sovereignty</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Full ownership of database schemas, cryptographic private keys, and application runtime within your enterprise perimeter.
        </p>
      </div>

      <div class="neo-surface p-7">
        <div class="w-10 h-10 rounded-2xl bg-green-100 text-green-700 flex items-center justify-center font-bold text-lg mb-4">
          ♾️
        </div>
        <h3 class="text-base font-bold text-slate-900 mb-2">Unlimited Volume & Scans</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Predictable flat-fee enterprise licensing. Zero per-passport creation penalties, zero scan-rate charges, and unlimited production volume.
        </p>
      </div>

      <div class="neo-surface p-7">
        <div class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-lg mb-4">
          🔄
        </div>
        <h3 class="text-base font-bold text-slate-900 mb-2">Continuous EU Rule Updates</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Includes ongoing software updates as the European Commission releases new delegated acts and amended PEFCR methodologies.
        </p>
      </div>

    </div>

    <!-- Bottom Action Card -->
    <div class="neo-surface p-8 max-w-4xl mx-auto text-center">
      <h3 class="text-lg font-bold text-slate-900">Inquire About Enterprise Licensing</h3>
      <p class="text-xs text-slate-500 mt-1 max-w-lg mx-auto">
        Speak with our enterprise licensing desk to receive an architecture review and commercial proposal.
      </p>
      <div class="mt-5">
        <a href="mailto:info@eudppprovider.com" class="neo-btn-primary inline-flex items-center gap-2">
          <span>Email: info@eudppprovider.com</span>
        </a>
      </div>
    </div>

  </div>
</Layout>
