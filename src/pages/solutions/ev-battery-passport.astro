---
import Layout from '../../layouts/Layout.astro';
import BatteryPassportViewer from '../../components/BatteryPassportViewer.astro';
---

<Layout
  title="EV Battery Passport Solutions | EU DPP Provider"
  description="Full-lifecycle Digital Product Passport compliance for electric vehicle (EV) battery packs under Regulation (EU) 2023/1542."
>
  <div class="py-16 bg-radial-gradient">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl">
        <span class="text-xs font-bold font-mono text-brand-400 uppercase tracking-widest bg-brand-500/10 px-3 py-1 rounded-full border border-brand-500/20">
          Automotive & Traction Batteries
        </span>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mt-4 mb-6">
          EV Battery Passport (Article 77 & 78) Compliance Engine
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          From cell manufacturing and pack assembly to OEM vehicle integration and end-of-life recycling, EU DPP Provider delivers the complete data infrastructure mandated for electric vehicles sold in the European Union.
        </p>
      </div>

      <!-- Feature Matrix -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 my-16">
        <div class="glass-card p-6 border border-slate-800">
          <div class="text-2xl mb-2">⚡</div>
          <h3 class="text-lg font-bold text-white mb-2">Automotive OEM & Tier-1 Integration</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Seamlessly bridge battery manufacturing MES with OEM vehicle assembly lines. Link VIN (Vehicle Identification Number) with individual Battery Passport UIDs.
          </p>
        </div>

        <div class="glass-card p-6 border border-slate-800">
          <div class="text-2xl mb-2">🔋</div>
          <h3 class="text-lg font-bold text-white mb-2">Dynamic SoH / Telemetry Hooks</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Connect vehicle on-board BMS data to provide certified State of Health (SoH) and capacity throughput readings for second-life vehicle trade-ins and repurposing.
          </p>
        </div>

        <div class="glass-card p-6 border border-slate-800">
          <div class="text-2xl mb-2">🛡️</div>
          <h3 class="text-lg font-bold text-white mb-2">OEM Brand Identity White-Labeling</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Display your car brand's bespoke design on public consumer scan portals while maintaining rigorous EU authority verification channels.
          </p>
        </div>
      </div>

      <!-- Live Simulator -->
      <div class="my-16">
        <div class="text-center mb-8">
          <h2 class="text-2xl font-bold text-white">Live EV Battery Passport Interactive Model</h2>
          <p class="text-xs text-slate-400 mt-1">Simulate an actual EV traction pack scan below</p>
        </div>
        <BatteryPassportViewer />
      </div>

      <!-- CTA -->
      <div class="p-8 rounded-2xl bg-gradient-to-r from-brand-900/60 via-slate-900 to-brand-950 border border-brand-500/30 text-center space-y-4">
        <h3 class="text-2xl font-bold text-white">Equip Your EV Battery Portfolio for 2027</h3>
        <p class="text-sm text-slate-300 max-w-xl mx-auto">
          Schedule an automotive compliance consultation and review our technical integration API documentation.
        </p>
        <a href="/contact" class="inline-flex px-6 py-3 rounded-xl bg-brand-500 text-white font-bold text-sm hover:opacity-90">
          Book Automotive Demo &rarr;
        </a>
      </div>

    </div>
  </div>
</Layout>
