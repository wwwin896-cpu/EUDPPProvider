---
import Layout from '../../layouts/Layout.astro';
import BatteryPassportViewer from '../../components/BatteryPassportViewer.astro';
---

<Layout
  title="EV Battery Passport Solutions | EU DPP Provider"
  description="Full-lifecycle Digital Product Passport compliance for electric vehicle (EV) battery packs under Regulation (EU) 2023/1542."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Automotive Traction Batteries</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        EV Battery Passport <br class="hidden sm:inline" />
        <span class="text-cyan-600">Enterprise Solutions</span>
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-600 leading-relaxed max-w-2xl mx-auto">
        End-to-end regulatory compliance for traction battery systems powering electric passenger cars, buses, and commercial transport under Article 77 of Regulation (EU) 2023/1542.
      </p>

      <div class="mt-6 flex justify-center gap-4">
        <a href="mailto:info@eudppprovider.com" class="neo-btn-primary">
          Request EV Battery Scoping →
        </a>
      </div>
    </div>

    <!-- Live Interactive Viewer -->
    <div class="mb-16">
      <BatteryPassportViewer />
    </div>

    <!-- Core Features Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-16">
      
      <div class="neo-surface p-7">
        <div class="w-10 h-10 rounded-2xl bg-cyan-100 text-cyan-700 flex items-center justify-center font-bold text-lg mb-4">
          🚗
        </div>
        <h3 class="text-base font-bold text-slate-900 mb-2">OEM Vehicle VIN Pairing</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Dynamic synchronization between battery pack serials, vehicle VIN, and OEM digital twin architectures via ISO 15118 and Catena-X data spaces.
        </p>
      </div>

      <div class="neo-surface p-7">
        <div class="w-10 h-10 rounded-2xl bg-green-100 text-green-700 flex items-center justify-center font-bold text-lg mb-4">
          ⚡
        </div>
        <h3 class="text-base font-bold text-slate-900 mb-2">Carbon Footprint (CFD)</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Pre-built PEFCR modeling for ternary NMC and LFP chemistries, generating certified Carbon Footprint Declarations for European homologation.
        </p>
      </div>

      <div class="neo-surface p-7">
        <div class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-lg mb-4">
          🔒
        </div>
        <h3 class="text-base font-bold text-slate-900 mb-2">BOM Privacy Shield</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Protect cell active material formulations and supplier purchase prices through zero-knowledge cryptographic proofs.
        </p>
      </div>

    </div>

    <!-- Bottom Action Card -->
    <div class="neo-surface p-8 max-w-4xl mx-auto text-center">
      <h3 class="text-lg font-bold text-slate-900">Discuss Your EV Battery Passport Implementation</h3>
      <p class="text-xs text-slate-500 mt-1 max-w-lg mx-auto">
        Connect with our automotive battery compliance desk for technical consultation.
      </p>
      <div class="mt-5">
        <a href="mailto:info@eudppprovider.com" class="neo-btn-primary inline-flex items-center gap-2">
          <span>Email: info@eudppprovider.com</span>
        </a>
      </div>
    </div>

  </div>
</Layout>
