---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Managed DPP Data Hosting & Vault | Zero-Knowledge Cloud | EU DPP Provider"
  description="Turnkey battery passport hosting: EU compliance, PCF calculation, GS1 resolver and multi-party ZKP verification in our sovereign EU cloud."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">10-Year Managed SLA</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Sovereign EU Data Vault & <br class="hidden sm:inline" />
        <span class="text-green-700">Managed Compliance Hosting</span>
      </h1>
      <p class="mt-4 text-sm sm:text-base text-slate-600 leading-relaxed max-w-2xl mx-auto">
        A turnkey European cloud vault managing all technical compliance, eIDAS 2.0 digital seals, EU Commission Registry synchronization, and 10-year QR code resolution.
      </p>

      <div class="mt-6 flex justify-center gap-4">
        <a href="mailto:info@eudppprovider.com" class="neo-btn-primary">
          Inquire About Data Vault Hosting →
        </a>
      </div>
    </div>

    <!-- Core Guarantees Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-16">
      
      <div class="neo-surface p-7 border-green-500/20">
        <div class="w-10 h-10 rounded-2xl bg-green-100 text-green-700 flex items-center justify-center font-bold text-lg mb-4">
          🛡️
        </div>
        <h3 class="text-base font-bold text-slate-900 mb-2">ISO 27001 European Cloud</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Hosted in sovereign data centers in Frankfurt and Munich. Fully compliant with GDPR, EU Data Act, and European cybersecurity standards.
        </p>
      </div>

      <div class="neo-surface p-7 border-green-500/20">
        <div class="w-10 h-10 rounded-2xl bg-cyan-100 text-cyan-700 flex items-center justify-center font-bold text-lg mb-4">
          ⚡
        </div>
        <h3 class="text-base font-bold text-slate-900 mb-2">99.9% High Availability SLA</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Typical sub-800ms QR scan resolution worldwide, with automated multi-region failover and real-time uptime monitoring.
        </p>
      </div>

      <div class="neo-surface p-7 border-green-500/20">
        <div class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-lg mb-4">
          🏛️
        </div>
        <h3 class="text-base font-bold text-slate-900 mb-2">Full Regulatory Adaptation</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Our regulatory team monitors European Commission delegated acts and updates your passport schema within 30 days of legal amendments.
        </p>
      </div>

    </div>

    <!-- Bottom Action Card -->
    <div class="neo-surface p-8 max-w-4xl mx-auto text-center">
      <h3 class="text-lg font-bold text-slate-900">Explore Managed Data Hosting</h3>
      <p class="text-xs text-slate-500 mt-1 max-w-lg mx-auto">
        Speak with our data operations team to review hosting SLAs, security compliance, and onboarding.
      </p>
      <div class="mt-5">
        <a href="mailto:info@eudppprovider.com" class="neo-btn-primary inline-flex items-center gap-2">
          <span>Email: info@eudppprovider.com</span>
        </a>
      </div>
    </div>

  </div>
</Layout>
