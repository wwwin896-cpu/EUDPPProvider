---
import Layout from '../layouts/Layout.astro';
import ComplianceCountdown from '../components/ComplianceCountdown.astro';
import BatteryPassportViewer from '../components/BatteryPassportViewer.astro';
import PricingCalculator from '../components/PricingCalculator.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title="EU DPP Provider | Enterprise EU Battery Passport Software & Managed Data Vault"
  description="Turnkey EU Battery Passport compliance platform (Regulation EU 2023/1542). Enterprise software license or fully managed DPP data hosting with Zero-Knowledge BOM protection."
>
  <!-- Hero Section (Airy, Editorial, Swiss Minimalist Typography) -->
  <section class="relative pt-24 pb-28 md:pt-32 md:pb-36 overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 relative z-10 text-center">
      
      <!-- Regulatory Pill Badge -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-medium bg-stone-100 text-stone-700 border border-stone-200/90 shadow-xs mb-8">
        <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
        <span>{t('hero.badge')}</span>
      </div>

      <!-- Hero Headline (Large, confident, refined) -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-semibold text-stone-900 tracking-tighter leading-[1.1] max-w-5xl mx-auto">
        {t('hero.title.prefix')} <br class="hidden sm:inline" />
        <span class="text-stone-900 underline decoration-stone-300 underline-offset-8">
          {t('hero.title.highlight')}
        </span> <br class="hidden sm:inline" />
        {t('hero.title.suffix')}
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl lg:text-2xl text-stone-600 max-w-3xl mx-auto mt-8 leading-relaxed font-normal">
        {t('hero.subtitle')}
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-10">
        <a
          href="/contact"
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-stone-900 hover:bg-stone-800 text-white font-medium text-base shadow-soft hover:shadow-float transition-all hover:scale-[1.01]"
        >
          {t('hero.cta.primary')} &rarr;
        </a>
        <a
          href="/pricing"
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-white border border-stone-200/90 hover:bg-stone-50 text-stone-800 font-medium text-base shadow-soft transition-colors"
        >
          {t('hero.cta.secondary')}
        </a>
      </div>

      <!-- Trust Badges (Minimalist Grid) -->
      <div class="pt-16 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto text-left">
        <div class="p-5 rounded-2xl bg-white border border-stone-200/80 shadow-xs">
          <div class="text-xs text-stone-400 font-medium">Compliance Target</div>
          <div class="text-sm font-semibold text-stone-900 mt-1">EU 2023/1542 (Art. 77)</div>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-stone-200/80 shadow-xs">
          <div class="text-xs text-stone-400 font-medium">Serialization Protocol</div>
          <div class="text-sm font-semibold text-stone-900 mt-1">GS1 Digital Link 2D</div>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-stone-200/80 shadow-xs">
          <div class="text-xs text-stone-400 font-medium">Trade Secret Shield</div>
          <div class="text-sm font-semibold text-emerald-800 mt-1">Zero-Knowledge Proofs</div>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-stone-200/80 shadow-xs">
          <div class="text-xs text-stone-400 font-medium">Data Sovereignty</div>
          <div class="text-sm font-semibold text-stone-900 mt-1">Catena-X Aligned</div>
        </div>
      </div>

    </div>
  </section>

  <!-- Countdown & Regulatory Roadmap -->
  <section class="py-16 md:py-24 bg-stone-100/60 border-y border-stone-200/80">
    <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
      <ComplianceCountdown />
    </div>
  </section>

  <!-- Interactive Digital Battery Passport Simulation -->
  <section class="py-24 md:py-32 bg-stone-50">
    <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-medium bg-stone-100 text-stone-700 border border-stone-200 mb-4">
          Interactive Simulation
        </div>
        <h2 class="text-3xl sm:text-5xl font-semibold text-stone-900 tracking-tight">
          {t('viewer.title')}
        </h2>
        <p class="text-lg text-stone-500 mt-3 font-normal leading-relaxed">
          {t('viewer.subtitle')}
        </p>
      </div>

      <BatteryPassportViewer />

    </div>
  </section>

  <!-- Dual Delivery Model -->
  <section class="py-24 md:py-32 bg-stone-100/60 border-y border-stone-200/80">
    <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
      <PricingCalculator />
    </div>
  </section>

  <!-- 4 Core Pillars of Technical Superiority -->
  <section class="py-24 md:py-32 bg-stone-50">
    <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
      
      <div class="text-center max-w-3xl mx-auto mb-20">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-medium bg-stone-100 text-stone-700 border border-stone-200 mb-4">
          Technical Architecture
        </div>
        <h2 class="text-3xl sm:text-5xl font-semibold text-stone-900 tracking-tight">
          Engineered for High-Throughput Battery Supply Chains
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
        
        <div class="bg-white p-8 rounded-3xl border border-stone-200/80 shadow-soft space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-stone-100 text-stone-800 flex items-center justify-center font-bold text-xl">
            🌱
          </div>
          <h3 class="text-lg font-bold text-stone-900">Automated PCF Carbon Engine</h3>
          <p class="text-sm text-stone-500 leading-relaxed font-normal">
            PEFCR-compliant lifecycle greenhouse gas calculations across Raw Material, Manufacturing, Distribution, and Recycling stages.
          </p>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-stone-200/80 shadow-soft space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-stone-100 text-stone-800 flex items-center justify-center font-bold text-xl">
            🔒
          </div>
          <h3 class="text-lg font-bold text-stone-900">Zero-Knowledge BOM Privacy</h3>
          <p class="text-sm text-stone-500 leading-relaxed font-normal">
            Suppliers prove regulatory compliance and material origins without exposing proprietary chemical formulas or commercial procurement pricing.
          </p>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-stone-200/80 shadow-soft space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-stone-100 text-stone-800 flex items-center justify-center font-bold text-xl">
            🏷️
          </div>
          <h3 class="text-lg font-bold text-stone-900">High-Speed GS1 Serialization</h3>
          <p class="text-sm text-stone-500 leading-relaxed font-normal">
            Laser-etching & 2D QR code generation at 120+ packs/min. Native GS1 Digital Link resolver with global low-latency CDN routing.
          </p>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-stone-200/80 shadow-soft space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-stone-100 text-stone-800 flex items-center justify-center font-bold text-xl">
            ⚖️
          </div>
          <h3 class="text-lg font-bold text-stone-900">OECD Due Diligence Tracker</h3>
          <p class="text-sm text-stone-500 leading-relaxed font-normal">
            Chain of custody for critical raw materials (Cobalt, Lithium, Nickel, Graphite) with third-party audit verification hooks.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Final CTA Callout (Refined Minimalist Banner) -->
  <section class="py-24 md:py-32 bg-stone-900 text-white relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-6 sm:px-8 lg:px-12 text-center relative z-10 space-y-6">
      <h2 class="text-3xl sm:text-5xl font-semibold tracking-tight text-white">
        Ready to Launch Your EU Battery Passport?
      </h2>
      <p class="text-base sm:text-lg text-stone-300 max-w-2xl mx-auto font-normal leading-relaxed">
        Speak with our senior EU compliance engineers. Receive a customized gap analysis and architecture roadmap for your battery product portfolio.
      </p>
      <div class="pt-6 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contact"
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-white hover:bg-stone-100 text-stone-900 font-semibold text-base shadow-soft transition-all hover:scale-[1.01]"
        >
          Schedule a Technical Consultation &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>
