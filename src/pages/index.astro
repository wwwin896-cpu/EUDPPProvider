---
import Layout from '../layouts/Layout.astro';
import ComplianceCountdown from '../components/ComplianceCountdown.astro';
import BatteryPassportViewer from '../components/BatteryPassportViewer.astro';
import PricingCalculator from '../components/PricingCalculator.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title="EU DPP Provider | Enterprise EU Battery Passport Software & Managed Data Vault"
  description="Pass EU Battery Passport audits in 6 weeks. Turnkey enterprise software, 10-year sovereign data vault, ZKP formula secrecy, and official EU Registry certification."
>

  <!-- ==================== HERO SECTION (Clean, Punchy, Neomorphic) ==================== -->
  <section class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Top Pill Badge -->
    <div class="eyebrow-pill mb-6 mx-auto">
      <span class="w-2 h-2 rounded-full bg-cyan-600 animate-pulse"></span>
      <span>Regulation (EU) 2023/1542 · Battery Passport Ready</span>
    </div>

    <!-- Punchy Marketing Headline -->
    <h1 class="text-4xl sm:text-6xl lg:text-[64px] font-extrabold tracking-tight leading-[1.08] text-slate-900 max-w-4xl mx-auto">
      Pass EU Battery Passport Audits. <br class="hidden sm:inline" />
      <span class="text-cyan-600">In 6 Weeks.</span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
      QR codes are just the entry point — what passes customs is the verifiable data chain behind them. We deliver your first compliant battery passport model in 6 weeks.
    </p>

    <!-- Tactile CTA Row -->
    <div class="mt-8 flex flex-wrap justify-center gap-4 items-center">
      <a
        href={`/${lang === 'en' ? '' : lang + '/'}contact`}
        class="neo-btn-primary inline-flex items-center gap-2"
      >
        <span>Apply for 6-Week Pilot →</span>
      </a>

      <a
        href="mailto:info@eudppprovider.com"
        class="neo-pill px-6 py-3 rounded-full text-xs font-bold text-slate-800 hover:text-cyan-700 flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>info@eudppprovider.com</span>
      </a>
    </div>

    <!-- Soft UI Countdown Capsule -->
    <div class="mt-14">
      <ComplianceCountdown />
    </div>

  </section>

  <!-- ==================== 3 CORE PILLARS (Clean Tactile Cards) ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="eyebrow-pill mb-2">Our Capabilities</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        Complete Cross-Border Compliance
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Card 1 -->
      <div class="neo-surface p-7 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-2xl bg-cyan-100 text-cyan-700 flex items-center justify-center font-bold text-lg mb-4">
            💻
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Enterprise Software</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Deploy independent DPP software on your own private cloud. Full data sovereignty, zero per-scan fees, and direct MES/ERP connectors.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/solutions/software-license" class="text-xs font-bold text-cyan-600 hover:text-cyan-700">Explore Software →</a>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="neo-surface p-7 flex flex-col justify-between border-green-500/20">
        <div>
          <div class="w-10 h-10 rounded-2xl bg-green-100 text-green-700 flex items-center justify-center font-bold text-lg mb-4">
            🛡️
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">10-Year Data Vault</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Delegate hosting to our sovereign EU vault. Guaranteed 99.9% uptime, 30-day regulatory updates, and ZKP formula secrecy.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/solutions/managed-data-hosting" class="text-xs font-bold text-green-700 hover:text-green-800">Explore Vault Hosting →</a>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="neo-surface p-7 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-lg mb-4">
            🏛️
          </div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">EU Registry & eIDAS</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Turnkey agency for EU Login, QSeal/QES digital seal creation, DigiCert QTSP certification, and EU Commission Registry receipt issuance.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/compliance/eu-battery-regulation-2023-1542" class="text-xs font-bold text-amber-700 hover:text-amber-800">EU Registry Guide →</a>
        </div>
      </div>

    </div>

  </section>

  <!-- ==================== INTERACTIVE PASSPORT DEMO ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="eyebrow-pill mb-2">Interactive Experience</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        4-Tier Role-Based Passport Simulation
      </h2>
      <p class="text-xs text-slate-500 mt-2">
        Test how consumers, customs, recyclers, and OEMs see differentiated data permissions.
      </p>
    </div>

    <BatteryPassportViewer />
  </section>

  <!-- ==================== 6-WEEK PILOT STEPPER ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="eyebrow-pill mb-2">Fast-Track Delivery</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        6-Week Single Model Pilot
      </h2>
      <p class="text-xs text-slate-500 mt-2">
        Prove regulatory conformity before enterprise-wide scaling. Tangible deliverables each week.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-5 gap-3.5">
      <div class="neo-surface p-4 text-center">
        <div class="text-[11px] font-mono font-bold text-cyan-600">Week 01</div>
        <div class="text-xs font-bold text-slate-900 mt-1">Field Audit</div>
        <div class="text-[10px] text-slate-500 mt-0.5">Assign field owners</div>
      </div>
      <div class="neo-surface p-4 text-center">
        <div class="text-[11px] font-mono font-bold text-cyan-600">Week 02</div>
        <div class="text-xs font-bold text-slate-900 mt-1">Data Model</div>
        <div class="text-[10px] text-slate-500 mt-0.5">7 domain mapping</div>
      </div>
      <div class="neo-surface p-4 text-center">
        <div class="text-[11px] font-mono font-bold text-cyan-600">Week 03–04</div>
        <div class="text-xs font-bold text-slate-900 mt-1">Connector ETL</div>
        <div class="text-[10px] text-slate-500 mt-0.5">Read-only MES sync</div>
      </div>
      <div class="neo-surface p-4 text-center">
        <div class="text-[11px] font-mono font-bold text-amber-600">Week 05</div>
        <div class="text-xs font-bold text-slate-900 mt-1">Reconciliation</div>
        <div class="text-[10px] text-slate-500 mt-0.5">≥95% completeness</div>
      </div>
      <div class="neo-surface p-4 text-center border-green-500/30">
        <div class="text-[11px] font-mono font-bold text-green-700">Week 06</div>
        <div class="text-xs font-bold text-slate-900 mt-1">Live Registry</div>
        <div class="text-[10px] text-green-800 font-bold mt-0.5">Official receipt issued</div>
      </div>
    </div>
  </section>

  <!-- ==================== DUAL COMMERCIAL MODELS ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="eyebrow-pill mb-2">Deployment Choices</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        Tailored to Your Enterprise IT Strategy
      </h2>
    </div>

    <PricingCalculator />
  </section>

  <!-- ==================== FINAL ACTION CARD ==================== -->
  <section class="py-16 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="neo-surface p-8 sm:p-12 text-center bg-gradient-to-br from-[#F0F4F8] to-cyan-50/40 border border-cyan-200/60">
      <div class="eyebrow-pill mb-3 mx-auto">Get Started Today</div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Ready to Launch Your 6-Week Pilot?
      </h2>
      <p class="mt-3 text-sm text-slate-600 max-w-xl mx-auto">
        Speak directly with our battery compliance engineers to review your battery specs and get started.
      </p>

      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="mailto:info@eudppprovider.com" class="neo-btn-primary">
          Contact: info@eudppprovider.com
        </a>
        <a href="/about" class="neo-pill px-6 py-3 rounded-full text-xs font-bold text-slate-800 hover:text-cyan-700">
          About Our Team & Infrastructure →
        </a>
      </div>
    </div>
  </section>

</Layout>
