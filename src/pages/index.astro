---
import Layout from '../layouts/Layout.astro';
import ComplianceCountdown from '../components/ComplianceCountdown.astro';
import BatteryPassportViewer from '../components/BatteryPassportViewer.astro';
import CrossIndustryDPP from '../components/CrossIndustryDPP.astro';
import PricingCalculator from '../components/PricingCalculator.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title="EU DPP Provider | Enterprise EU Battery Passport Platform & Sovereign Data Vault"
  description="Turn supply chain records into an audit-proof data chain. Turnkey enterprise software, 10-year sovereign data vault, ZKP formula secrecy, and official EU Registry certification."
>

  <!-- ==================== HERO SECTION (Clean, Punchy, Neomorphic) ==================== -->
  <section class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Top Pill Badge -->
    <div class="eyebrow-pill mb-6 mx-auto">
      <span class="w-2 h-2 rounded-full bg-cyan-600 animate-pulse"></span>
      <span>Regulation (EU) 2023/1542 · Battery Passport Ready</span>
    </div>

    <!-- Punchy Marketing Headline -->
    <h1 class="text-4xl sm:text-5xl lg:text-[58px] font-extrabold tracking-tight leading-[1.12] text-slate-900 max-w-4xl mx-auto">
      Enterprise EU Battery Passport Platform <br class="hidden sm:inline" />
      <span class="text-cyan-600">& Sovereign Data Vault</span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
      QR codes are just the entry point — what passes customs is the verifiable data chain behind them. We bridge upstream supply chain records into an audit-proof data chain under Regulation (EU) 2023/1542.
    </p>

    <!-- Tactile CTA Row -->
    <div class="mt-8 flex flex-wrap justify-center gap-4 items-center">
      <a
        href={`/${lang === 'en' ? '' : lang + '/'}contact`}
        class="neo-btn-primary inline-flex items-center gap-2"
      >
        <span>Request Technical Scoping →</span>
      </a>

      <a
        href="mailto:info@eudppprovider.com"
        class="neo-pill px-6 py-3 rounded-full text-xs sm:text-sm font-bold text-slate-800 hover:text-cyan-700 flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>info@eudppprovider.com</span>
      </a>
    </div>

    <!-- Soft UI Countdown Capsule -->
    <div class="mt-14">
      <ComplianceCountdown />
    </div>

  </section>

  <!-- ==================== BANNER SECTION 1: INDUSTRIAL FACTORY VERIFICATION ==================== -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/60 min-h-[460px] flex items-center">
      
      <!-- Background Image -->
      <img 
        src="/images/banner_factory_scan.webp" 
        alt="Industrial Battery Pack Laser Marking and Scan Verification" 
        class="absolute inset-0 w-full h-full object-cover object-center"
      />

      <!-- High-End Dark Gradient Overlay for Maximum Legibility -->
      <div class="absolute inset-0 bg-gradient-to-r from-navy-900/95 via-navy-900/80 to-navy-900/30 backdrop-blur-[2px]"></div>

      <!-- Foreground Text & Badge Content -->
      <div class="relative z-10 p-8 sm:p-12 lg:p-16 max-w-2xl text-white">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 mb-5">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span>Industrial Traceability in Action</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-[1.15] text-white">
          From Factory Laser Etching to <br />
          <span class="text-cyan-400">EU Customs Clearance</span>
        </h2>

        <p class="mt-4 text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
          Permanent GS1 Digital Link 2D barcodes laser-marked directly on battery pack enclosures. Instantly resolvable by customs surveillance, testing laboratories, and certified recyclers worldwide.
        </p>

        <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 border-t border-white/15 text-xs">
          <div>
            <div class="font-mono text-cyan-400 font-bold text-base sm:text-lg">Sub-50ms</div>
            <div class="text-slate-400 mt-0.5">Global DNS Resolution</div>
          </div>
          <div>
            <div class="font-mono text-green-400 font-bold text-base sm:text-lg">eIDAS 2.0</div>
            <div class="text-slate-400 mt-0.5">PAdES Baseline Sealed</div>
          </div>
          <div class="hidden sm:block">
            <div class="font-mono text-cyan-400 font-bold text-base sm:text-lg">ISO/IEC 15459</div>
            <div class="text-slate-400 mt-0.5">Global Unique Barcode</div>
          </div>
        </div>

        <div class="mt-8">
          <a href="/platform/gs1-qr-serialization" class="btn-primary-cyan inline-flex items-center gap-2 text-xs sm:text-sm font-bold">
            <span>Explore Factory Serialization →</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== 3 CORE PILLARS (Clean Tactile Cards) ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="eyebrow-pill mb-2">Our Capabilities</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        Complete Cross-Border Compliance
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Card 1 -->
      <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-cyan-100 text-cyan-700 flex items-center justify-center font-bold text-xl mb-4">
            💻
          </div>
          <h3 class="text-lg lg:text-xl font-bold text-slate-900 mb-2">Enterprise Software</h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            Deploy independent DPP software on your own private cloud. Full data sovereignty, zero per-scan fees, and direct MES/ERP connectors.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/solutions/software-license" class="text-xs sm:text-sm font-bold text-cyan-600 hover:text-cyan-700">Explore Software →</a>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between border-green-500/20">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-green-100 text-green-700 flex items-center justify-center font-bold text-xl mb-4">
            🛡️
          </div>
          <h3 class="text-lg lg:text-xl font-bold text-slate-900 mb-2">10-Year Data Vault</h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            Delegate hosting to our sovereign EU vault. Guaranteed 99.9% uptime, 30-day regulatory updates, and ZKP formula secrecy.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/solutions/managed-data-hosting" class="text-xs sm:text-sm font-bold text-green-700 hover:text-green-800">Explore Vault Hosting →</a>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-xl mb-4">
            🏛️
          </div>
          <h3 class="text-lg lg:text-xl font-bold text-slate-900 mb-2">EU Registry & eIDAS</h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            Turnkey agency for EU Login, QSeal/QES digital seal creation, DigiCert QTSP certification, and EU Commission Registry receipt issuance.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/compliance/eu-dpp-registry-guide" class="text-xs sm:text-sm font-bold text-amber-700 hover:text-amber-800">EU Registry Guide →</a>
        </div>
      </div>

    </div>

  </section>

  <!-- ==================== INTERACTIVE PASSPORT DEMO ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="eyebrow-pill mb-2">Interactive Experience</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        4-Tier Role-Based Passport Simulation
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-2">
        Test how consumers, customs, recyclers, and OEMs see differentiated data permissions.
      </p>
    </div>

    <BatteryPassportViewer />
  </section>

  <!-- ==================== CROSS-INDUSTRY ESPR DPP EXTENSIBILITY ==================== -->
  <CrossIndustryDPP />

  <!-- ==================== BANNER SECTION 2: EU SOVEREIGN COMMAND VAULT ==================== -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/60 min-h-[460px] flex items-center">
      
      <!-- Background Image -->
      <img 
        src="/images/banner_sovereign_vault.webp" 
        alt="Sovereign EU Cloud Command Center in Frankfurt" 
        class="absolute inset-0 w-full h-full object-cover object-center"
      />

      <!-- Dark Vignette Overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-navy-950/95 via-navy-900/80 to-navy-900/40 backdrop-blur-[2px]"></div>

      <!-- Foreground Content -->
      <div class="relative z-10 p-8 sm:p-12 lg:p-16 max-w-2xl text-white">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-green-500/20 text-green-300 border border-green-400/30 mb-5">
          <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
          <span>Frankfurt & Munich Nodes · ISO 27001</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-[1.15] text-white">
          Sovereign EU Data Vault & <br />
          <span class="text-green-400">24/7 Compliance Control</span>
        </h2>

        <p class="mt-4 text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
          Deploy your battery passport in Europe's most secure ISO 27001 data centers. Full GDPR and EU Data Act compliance, zero-leak trade secret protection, and guaranteed 10-year active lifecycle SLA.
        </p>

        <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 border-t border-white/15 text-xs">
          <div>
            <div class="font-mono text-green-400 font-bold text-base sm:text-lg">99.9%</div>
            <div class="text-slate-400 mt-0.5">Uptime SLA Guarantee</div>
          </div>
          <div>
            <div class="font-mono text-cyan-400 font-bold text-base sm:text-lg">30 Days</div>
            <div class="text-slate-400 mt-0.5">EU Legal Schema Patch</div>
          </div>
          <div class="hidden sm:block">
            <div class="font-mono text-green-400 font-bold text-base sm:text-lg">10 Years</div>
            <div class="text-slate-400 mt-0.5">Lifecycle Storage SLA</div>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-4 items-center">
          <a href="/solutions/managed-data-hosting" class="btn-primary-cyan inline-flex items-center gap-2 text-xs sm:text-sm font-bold">
            <span>Explore Data Vault Hosting →</span>
          </a>
          <a href="mailto:info@eudppprovider.com" class="btn-ghost-hero inline-flex items-center gap-2 text-xs sm:text-sm">
            <span>info@eudppprovider.com</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== PHASED IMPLEMENTATION STEPPER ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="eyebrow-pill mb-2">Structured Delivery</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        Phased Implementation Framework
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-2">
        A predictable, milestone-driven delivery process ensuring your battery passport passes all Notified Body and EU Registry checks.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-5 gap-3.5">
      <div class="neo-surface p-4 text-center">
        <div class="text-[11px] font-mono font-bold text-cyan-600">Phase 01</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900 mt-1">Field Gap Audit</div>
        <div class="text-[10px] sm:text-xs text-slate-500 mt-0.5">Assign data owners</div>
      </div>
      <div class="neo-surface p-4 text-center">
        <div class="text-[11px] font-mono font-bold text-cyan-600">Phase 02</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900 mt-1">Data Modeling</div>
        <div class="text-[10px] sm:text-xs text-slate-500 mt-0.5">7 domain mapping</div>
      </div>
      <div class="neo-surface p-4 text-center">
        <div class="text-[11px] font-mono font-bold text-cyan-600">Phase 03</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900 mt-1">Connector Ingestion</div>
        <div class="text-[10px] sm:text-xs text-slate-500 mt-0.5">Read-only MES sync</div>
      </div>
      <div class="neo-surface p-4 text-center">
        <div class="text-[11px] font-mono font-bold text-amber-600">Phase 04</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900 mt-1">Reconciliation</div>
        <div class="text-[10px] sm:text-xs text-slate-500 mt-0.5">≥95% completeness</div>
      </div>
      <div class="neo-surface p-4 text-center border-green-500/30">
        <div class="text-[11px] font-mono font-bold text-green-700">Phase 05</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900 mt-1">Registry Filing</div>
        <div class="text-[10px] sm:text-xs text-green-800 font-bold mt-0.5">Official receipt issued</div>
      </div>
    </div>
  </section>

  <!-- ==================== DUAL COMMERCIAL MODELS ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="eyebrow-pill mb-2">Deployment Choices</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        Tailored to Your Enterprise IT Strategy
      </h2>
    </div>

    <PricingCalculator />
  </section>

  <!-- ==================== FINAL ACTION CARD ==================== -->
  <section class="py-16 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="neo-surface p-8 sm:p-12 text-center bg-gradient-to-br from-[#F0F4F8] to-cyan-50/40 border border-cyan-200/60">
      <div class="eyebrow-pill mb-3 mx-auto">Get Started Today</div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Ready to Launch Your Battery Passport Implementation?
      </h2>
      <p class="mt-3 text-xs sm:text-sm text-slate-600 max-w-xl mx-auto">
        Speak directly with our battery compliance engineers to review your battery specs and get started.
      </p>

      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="mailto:info@eudppprovider.com" class="neo-btn-primary">
          Contact: info@eudppprovider.com
        </a>
        <a href="/about" class="neo-pill px-6 py-3 rounded-full text-xs sm:text-sm font-bold text-slate-800 hover:text-cyan-700">
          About Our Team & Infrastructure →
        </a>
      </div>
    </div>
  </section>

</Layout>
