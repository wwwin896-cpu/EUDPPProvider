---
import Layout from '../layouts/Layout.astro';
import ComplianceCountdown from '../components/ComplianceCountdown.astro';
import BatteryPassportViewer from '../components/BatteryPassportViewer.astro';
import PricingCalculator from '../components/PricingCalculator.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title="EU DPP Provider | Enterprise EU Battery Passport Software & Managed Data Vault"
  description="Turn battery passport compliance into an audit-ready data chain. 6-week single model pilot, dual EU/CN compliance, ZKP privacy protection, and 10-year sovereign data hosting."
>

  <!-- ==================== HERO SECTION (Sovereign Navy Gradient) ==================== -->
  <section class="hero-gradient text-white pt-24 pb-20 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-4xl">
        <!-- Top Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase text-cyan-200 bg-white/[0.06] border border-white/[0.14] mb-6">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span>EU Regulation 2023/1542 · Battery Passport Ready</span>
        </div>

        <!-- Display Headline -->
        <h1 class="text-4xl sm:text-6xl lg:text-[62px] font-extrabold tracking-tight leading-[1.04] text-white">
          Turn Battery Passports into an <br class="hidden sm:inline" />
          <em class="not-italic text-cyan-500">Audit-Ready Data Chain</em>
        </h1>

        <!-- Lead Paragraph -->
        <p class="mt-6 text-lg sm:text-[19px] leading-relaxed text-white/75 max-w-2xl font-normal">
          The QR code is merely an entry point; what passes EU audit is the verifiable chain behind it. Prove full compliance for your first battery model in <strong>6 weeks</strong> with our turnkey software or sovereign 10-year data vault.
        </p>

        <!-- CTA Row -->
        <div class="mt-8 flex flex-wrap gap-4 items-center">
          <a
            href={`/${lang === 'en' ? '' : lang + '/'}contact`}
            class="btn-primary-cyan inline-flex items-center gap-2 shadow-lg"
          >
            <span>Apply for 6-Week Pilot Model →</span>
          </a>
          
          <a
            href="mailto:info@eudppprovider.com"
            class="btn-ghost-hero inline-flex items-center gap-2"
          >
            <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span>info@eudppprovider.com</span>
          </a>
        </div>
      </div>

      <!-- 4-Column Metrics Bar -->
      <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-0 border border-white/[0.12] rounded-2xl overflow-hidden bg-white/[0.03] backdrop-blur-sm">
        <div class="p-5 sm:p-6 border-b sm:border-b-0 border-r border-white/[0.1]">
          <div class="font-mono text-xs uppercase tracking-wider text-cyan-500 font-semibold">Delivery Pilot</div>
          <div class="text-base sm:text-lg font-semibold text-white mt-1.5">6 Weeks · Scan-Ready</div>
        </div>
        <div class="p-5 sm:p-6 border-b sm:border-b-0 md:border-r border-white/[0.1]">
          <div class="font-mono text-xs uppercase tracking-wider text-cyan-500 font-semibold">Dual Alignment</div>
          <div class="text-base sm:text-lg font-semibold text-white mt-1.5">EU 70+ & CN 96 Fields</div>
        </div>
        <div class="p-5 sm:p-6 border-r border-white/[0.1]">
          <div class="font-mono text-xs uppercase tracking-wider text-cyan-500 font-semibold">Formula Privacy</div>
          <div class="text-base sm:text-lg font-semibold text-white mt-1.5">ZKP Zero-Leak Shield</div>
        </div>
        <div class="p-5 sm:p-6">
          <div class="font-mono text-xs uppercase tracking-wider text-cyan-500 font-semibold">Managed Hosting SLA</div>
          <div class="text-base sm:text-lg font-semibold text-white mt-1.5">10-Year Guarantee · 99.9%</div>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== 6-WEEK PILOT ROADMAP SECTION ==================== -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="eyebrow mb-2">01 · Proven Fast-Track Methodology</div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900">
          From Gap Audit to Live Passport in 6 Weeks
        </h2>
        <p class="mt-4 text-base text-slate-500 leading-relaxed">
          We prove compliance on a single model before scaling to full production lines. Every stage has tangible, auditable deliverables.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
        
        <div class="panel-card p-5 border-t-4 border-t-cyan-500">
          <div class="font-mono text-xs font-bold text-cyan-600 mb-1">Week 01</div>
          <h4 class="text-sm font-bold text-slate-900 mb-2">Gap Inventory</h4>
          <p class="text-xs text-slate-500 leading-relaxed">
            Audit 70+ EU data points against ERP/MES/PLM/BMS. Flag unassigned fields and assign owners.
          </p>
          <div class="mt-3 text-[11px] font-mono text-cyan-700 bg-cyan-50 px-2 py-1 rounded">
            → Field Responsibility Matrix
          </div>
        </div>

        <div class="panel-card p-5 border-t-4 border-t-cyan-600">
          <div class="font-mono text-xs font-bold text-cyan-600 mb-1">Week 02</div>
          <h4 class="text-sm font-bold text-slate-900 mb-2">Data Modeling</h4>
          <p class="text-xs text-slate-500 leading-relaxed">
            Map fields into 7 core data domains. Standardize calculations, PEFCR rules, and validation checks.
          </p>
          <div class="mt-3 text-[11px] font-mono text-cyan-700 bg-cyan-50 px-2 py-1 rounded">
            → Frozen Unified Model Table
          </div>
        </div>

        <div class="panel-card p-5 border-t-4 border-t-navy-600">
          <div class="font-mono text-xs font-bold text-navy-600 mb-1">Week 03–04</div>
          <h4 class="text-sm font-bold text-slate-900 mb-2">System Ingestion</h4>
          <p class="text-xs text-slate-500 leading-relaxed">
            Deploy read-only connectors for automated incremental synchronization and anomaly alerts.
          </p>
          <div class="mt-3 text-[11px] font-mono text-navy-800 bg-slate-100 px-2 py-1 rounded">
            → Live ETL Pipeline & Dashboard
          </div>
        </div>

        <div class="panel-card p-5 border-t-4 border-t-amber-500">
          <div class="font-mono text-xs font-bold text-amber-600 mb-1">Week 05</div>
          <h4 class="text-sm font-bold text-slate-900 mb-2">Audit & Reconciliation</h4>
          <p class="text-xs text-slate-500 leading-relaxed">
            Sample verification, upstream fill-in. Release only after reaching ≥95% field completeness.
          </p>
          <div class="mt-3 text-[11px] font-mono text-amber-700 bg-amber-50 px-2 py-1 rounded">
            → 95%+ Audit Compliance Report
          </div>
        </div>

        <div class="panel-card p-5 border-t-4 border-t-green-600">
          <div class="font-mono text-xs font-bold text-green-700 mb-1">Week 06</div>
          <h4 class="text-sm font-bold text-slate-900 mb-2">Registry & Live QR</h4>
          <p class="text-xs text-slate-500 leading-relaxed">
            Generate verifiable passport, register on EU Commission Registry, and activate 4-tier access.
          </p>
          <div class="mt-3 text-[11px] font-mono text-green-800 bg-green-50 px-2 py-1 rounded">
            → Scan-Ready DPP + Official Receipt
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ==================== LIVE PASSPORT DEMO SECTION ==================== -->
  <section class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <div class="eyebrow mb-2">02 · Interactive Verification</div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900">
          Experience the 4-Tier Role-Based Passport
        </h2>
        <p class="mt-4 text-base text-slate-500 leading-relaxed">
          Regulation (EU) 2023/1542 mandates distinct information access for consumers, authorities, dismantlers, and manufacturers. Toggle roles below to test the permission resolver.
        </p>
      </div>

      <!-- Passport Viewer Mockup -->
      <div class="max-w-5xl mx-auto">
        <BatteryPassportViewer />
      </div>

    </div>
  </section>

  <!-- ==================== COUNTDOWN SECTION (Sovereign Navy 800) ==================== -->
  <section class="py-20 bg-navy-900 border-b border-navy-800 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ComplianceCountdown />
    </div>
  </section>

  <!-- ==================== DUAL-SYSTEM & DATA BORDER COMPLIANCE ==================== -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="eyebrow mb-2">03 · Cross-Border Data Sovereignty</div>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900">
            Raw Data Stays Home. Only Disclosure Fields Cross Borders.
          </h2>
          <p class="mt-4 text-slate-600 text-base leading-relaxed">
            Battery manufacturers face strict data export regulations. Our architecture executes all calculations in domestic cleanrooms, enforcing whitelist export engines with zero-knowledge proof protection.
          </p>

          <div class="mt-6 space-y-3 text-sm text-slate-600">
            <div class="flex items-start gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200">
              <span class="text-cyan-600 font-bold">01</span>
              <span><strong>4-Tier Classification:</strong> Public, Regulatory, Legitimate Interest, and Forbidden Export.</span>
            </div>
            <div class="flex items-start gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200">
              <span class="text-green-600 font-bold">02</span>
              <span><strong>Strict Whitelist Engine:</strong> Only registered regulatory fields leave the border; new fields blocked by default.</span>
            </div>
            <div class="flex items-start gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200">
              <span class="text-amber-600 font-bold">03</span>
              <span><strong>Full Audit Logs:</strong> Every access and export is timestamped and cryptographically logged for audit replay.</span>
            </div>
          </div>
        </div>

        <div class="panel-card p-8 bg-slate-50">
          <h3 class="text-lg font-bold text-slate-900 mb-4 flex items-center justify-between">
            <span>Dual Alignment Comparison</span>
            <span class="text-xs font-mono font-bold px-2 py-0.5 bg-cyan-100 text-cyan-800 rounded">1 Code · 2 Outputs</span>
          </h3>

          <div class="space-y-4 text-xs">
            <div class="p-3 bg-white rounded-xl border border-slate-200">
              <div class="font-bold text-slate-900 text-sm mb-1">🇪🇺 EU Battery Passport (EU 2023/1542)</div>
              <p class="text-slate-500">70+ Data Points: Annex XIII categories, PEFCR Carbon Footprint, Due Diligence, GS1 Digital Link UPI registration on EU Registry.</p>
            </div>

            <div class="p-3 bg-white rounded-xl border border-slate-200">
              <div class="font-bold text-slate-900 text-sm mb-1">🇨🇳 China National Traceability Code (24-Digit ID)</div>
              <p class="text-slate-500">96 Information Fields: 54 basic, 24 operational, 18 recycling. Real-time uplink to National Comprehensive Battery Platform.</p>
            </div>

            <div class="p-3 bg-green-50 rounded-xl border border-green-200 text-green-900 font-medium">
              💡 <strong>Unified Model Advantage:</strong> Collect raw parameters once, output to both China and EU platforms without paying double integration costs.
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== DELIVERY MODELS (Software vs Hosting) ==================== -->
  <section class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <div class="eyebrow mb-2">04 · Commercial Engagement</div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900">
          Two Ways to Achieve Battery Passport Compliance
        </h2>
        <p class="mt-4 text-base text-slate-500 leading-relaxed">
          Whether you want full on-premise code ownership or effortless delegated cloud hosting, we have the tailored enterprise solution.
        </p>
      </div>

      <PricingCalculator />

    </div>
  </section>

  <!-- ==================== FINAL CTA BANNER ==================== -->
  <section class="py-20 hero-gradient text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-white/10 text-cyan-300 border border-white/20 mb-6">
        Ready for Production Delivery
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        Start with a Single Model. Prove It in 6 Weeks.
      </h2>
      <p class="mt-5 text-lg text-white/75 max-w-2xl mx-auto">
        Speak directly with our solutions team to begin your gap assessment and pilot scoping.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="mailto:info@eudppprovider.com" class="btn-primary-cyan">
          Contact: info@eudppprovider.com
        </a>
        <a href={`/${lang === 'en' ? '' : lang + '/'}about`} class="btn-ghost-hero">
          Learn About Our Engineering Team →
        </a>
      </div>
    </div>
  </section>

</Layout>
