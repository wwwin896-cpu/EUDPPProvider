---
import Layout from '../../layouts/Layout.astro';
import PricingCalculator from '../../components/PricingCalculator.astro';
---

<Layout
  title="Implementatiemodellen & Integratie | EU DPP Provider"
  description="Gestructureerde B2B-leveringsmodellen voor het EU Batterijpaspoort: beheerd soeverein cloudabonnement vs. turnkey on-premise bedrijfssoftware."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Commerciële & Technische Architectuur</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Enterprise Leveringsmodellen <br />
        <span class="text-cyan-600">& 4-Stappen Implementatieroadmap</span>
      </h1>
      <p class="mt-6 text-base sm:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
        Kies tussen onze 10-jarige soevereine datakluis in Frankfurt en volledige software-implementatie op uw eigen bedrijfsservers.
      </p>
    </div>

    <div class="max-w-5xl mx-auto">
      <PricingCalculator />
    </div>
  </div>
</Layout>
