---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="90+ EU Batterijpaspoort Verplichte Gegevens Checklist | EU DPP Provider"
  description="Specificatie van de 7 gegevensdomeinen en 90+ verplichte attributen onder Verordening (EU) 2023/1542 Bijlage XIII."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Verordening (EU) 2023/1542 · Bijlage XIII</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        90+ Verplichte Batterijpaspoort Gegevensvereisten
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Overzicht van de 7 nalevingsdomeinen en rolgebaseerde toegangsniveaus voor batterijfabrikanten.
      </p>
    </div>
  </div>
</Layout>
