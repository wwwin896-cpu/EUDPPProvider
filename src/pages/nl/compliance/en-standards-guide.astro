---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="EN 18220:2026 & EN 18219:2026 Technische Gids | EU DPP Provider"
  description="Geharmoniseerde Europese normen onder Standaardisatiebesluit (EU) 2026/1736: EN 18220 (2D-Barcodes) en EN 18219 (UPI Identificatoren)."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Standaardisatiebesluit (EU) 2026/1736</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Geharmoniseerde Normen: <br class="hidden sm:inline" />
        <span class="text-cyan-600">EN 18220 & EN 18219</span>
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Specificaties voor lasergravure op batterijbehuizingen en Unique Product Identifiers (UPI).
      </p>
    </div>
  </div>
</Layout>
