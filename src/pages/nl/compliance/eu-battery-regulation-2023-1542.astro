---
import Layout from '../../../layouts/Layout.astro';
import ComplianceCountdown from '../../../components/ComplianceCountdown.astro';
---

<Layout
  title="EU Batterijverordening 2023/1542 | EU DPP Provider"
  description="Diepgaande analyse van Verordening (EU) 2023/1542 vereisten, Artikel 77/78 Batterijpaspoort mandaten, handhavingstijdlijn vanaf 2027 en technische checklist."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Header -->
    <div class="text-center max-w-4xl mx-auto mb-16">
      <div class="eyebrow-pill mb-4 mx-auto">Regelgevend Kenniscentrum</div>
      
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.15] max-w-3xl mx-auto">
        EU Batterijverordening <br class="hidden sm:inline" />
        <span class="text-cyan-600">(EU 2023/1542) Nalevingsgids</span>
      </h1>

      <p class="mt-5 text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Verordening (EU) 2023/1542 van de Europese Unie vormt 's werelds meest uitgebreide regelgevingskader voor batterijontwerp, traceerbaarheid, koolstofboekhouding en recycling.
      </p>

      <div class="mt-8 flex justify-center gap-4">
        <a href="mailto:info@eudppprovider.com" class="neo-btn-primary">
          Nalevingsbeoordeling Aanvragen →
        </a>
      </div>
    </div>

    <!-- Countdown Component -->
    <div class="mb-16">
      <ComplianceCountdown />
    </div>

    <!-- Main Content Cards -->
    <div class="space-y-8 max-w-4xl mx-auto">
      
      <!-- Card 1: Scope & Mandatory Categories -->
      <div class="neo-surface p-8 sm:p-10">
        <h2 class="text-xl font-bold text-slate-900 mb-3 flex items-center gap-2.5">
          <span class="w-8 h-8 rounded-xl bg-cyan-100 text-cyan-700 flex items-center justify-center font-bold text-sm">01</span>
          <span>Toepassingsgebied: Welke Batterijen Vereisen een Paspoort?</span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
          Volgens Artikel 77 moeten vanaf <strong>18 februari 2027</strong> alle batterijen die op de EU-markt worden gebracht beschikken over een elektronisch dossier (Batterijpaspoort) indien ze vallen onder:
        </p>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
          <li class="flex items-start gap-2">
            <span class="text-cyan-600 font-bold">•</span>
            <span><strong>Elektrische Voertuigen (EV):</strong> Tractiebatterijen voor personenauto's, bussen, vrachtwagens en bestelwagens.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-cyan-600 font-bold">•</span>
            <span><strong>Lichte Vervoermiddelen (LMT ≤25kg):</strong> Tractiebatterijen voor e-bikes, e-scooters en lichte 2/3-wielers.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-cyan-600 font-bold">•</span>
            <span><strong>Industriële & Stationaire Opslag (>2kWh):</strong> Batterij-energieopslagsystemen (BESS), back-upstroom en industriële installaties.</span>
          </li>
        </ul>
      </div>

      <!-- Card 2: 7 Mandatory Data Domains -->
      <div class="neo-surface p-8 sm:p-10">
        <h2 class="text-xl font-bold text-slate-900 mb-3 flex items-center gap-2.5">
          <span class="w-8 h-8 rounded-xl bg-green-100 text-green-700 flex items-center justify-center font-bold text-sm">02</span>
          <span>De 7 Verplichte Gegevensdomeinen (Annex XIII)</span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
          Het paspoort structureert meer dan 70 afzonderlijke datapunten over zeven wettelijke dimensies:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-700">
          <div class="p-3 rounded-xl bg-white/70 border border-slate-200">1. Algemene Batterij- & Fabrikantidentificatie</div>
          <div class="p-3 rounded-xl bg-white/70 border border-slate-200">2. Materiaalsamenstelling & Chemie</div>
          <div class="p-3 rounded-xl bg-white/70 border border-slate-200">3. Koolstofvoetafdruk (Scope 1, 2, 3 CFD)</div>
          <div class="p-3 rounded-xl bg-white/70 border border-slate-200">4. Due Diligence van de Toeleveringsketen</div>
          <div class="p-3 rounded-xl bg-white/70 border border-slate-200">5. Prestaties, Levensduur & SOH</div>
          <div class="p-3 rounded-xl bg-white/70 border border-slate-200">6. Demontage, Veiligheid & Blusinstructies</div>
          <div class="p-3 rounded-xl bg-white/70 border border-slate-200 sm:col-span-2">7. Gerecycleerd Gehalte & Einde Levensduur Doelen</div>
        </div>
      </div>

      <!-- Card 3: Next Steps & Contact -->
      <div class="neo-surface p-8 sm:p-10 bg-gradient-to-br from-[#F0F4F8] to-cyan-50/40 border border-cyan-200/80 text-center">
        <h3 class="text-lg sm:text-xl font-bold text-slate-900">Bereid uw Export voor op de Naleving van 2027</h3>
        <p class="text-xs sm:text-sm text-slate-600 mt-2 max-w-lg mx-auto">
          Neem contact op met onze nalevingsdesk voor een gratis datakloof-analyse.
        </p>
        <div class="mt-5 flex justify-center gap-4">
          <a href="mailto:info@eudppprovider.com" class="neo-btn-primary">
            Contact: info@eudppprovider.com
          </a>
        </div>
      </div>

    </div>

  </div>
</Layout>
