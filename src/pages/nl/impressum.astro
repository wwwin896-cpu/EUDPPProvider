---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Impressum (Juridische Kennisgeving) | EU DPP Provider"
  description="Wettelijke identificatie van de aanbieder conform § 5 DDG en Richtlijn 2000/31/EG voor EU DPP Provider."
>
  <div class="py-16 sm:py-24 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Wettelijke Informatie</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Impressum <br class="hidden sm:inline" />
        <span class="text-cyan-600">(Legal Notice)</span>
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Verplichte identificatie conform § 5 van de Duitse Digital Services Act (DDG) en Richtlijn 2000/31/EG.
      </p>
    </div>

    <div class="neo-surface p-8 sm:p-10 space-y-6 text-sm text-slate-700">
      <div>
        <h3 class="font-bold text-slate-900 text-base mb-1">Dienstverlener & Exploitatie</h3>
        <p class="text-slate-600">EU DPP Provider / SUZHOU GEEKTION TECHNOLOGY CO.,LTD</p>
        <p class="text-slate-500 text-xs mt-0.5">Sociaal Kredietnummer (USCI): 91320509MAEM4DKR87</p>
        <p class="text-slate-500 text-xs mt-0.5">Statutaire zetel: Suzhou, Jiangsu, China</p>
      </div>

      <div class="pt-4 border-t border-slate-200">
        <h3 class="font-bold text-slate-900 text-base mb-1">Contact & Datacenters</h3>
        <p class="text-slate-600">Officiële Bedrijfsdesk: <a href="mailto:info@eudppprovider.com" class="text-cyan-600 font-mono font-bold">info@eudppprovider.com</a></p>
        <p class="text-slate-500 text-xs mt-0.5">Telefoon (EU Desk): +49 (0) 69 9675 8827</p>
        <p class="text-slate-500 text-xs mt-0.5">Europese Datacenters: Frankfurt am Main & München (ISO/IEC 27001 gecertificeerd)</p>
      </div>
    </div>
  </div>
</Layout>
