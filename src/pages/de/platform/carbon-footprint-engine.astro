---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="CO₂-Fußabdruck (PCF) Berechnungs-Engine | EU DPP Provider"
  description="PEFCR-konforme CO₂-Fußabdruck-Berechnung für Batterien, Lieferketten-Emissionserfassung und automatisierte Deklarationen unter Verordnung (EU) 2023/1542."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">PEFCR & Scope 1-3 Emissionen</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        CO₂-Fußabdruck (PCF) Engine
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Berechnung der Treibhausgasemissionen über den gesamten Lebenszyklus und Konformität mit harmonisierten EU-Standards.
      </p>
    </div>
  </div>
</Layout>
