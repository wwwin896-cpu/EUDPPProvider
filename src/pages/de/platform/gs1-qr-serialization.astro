---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="GS1 Digital Link 2D Serialisierung & Lasergravur | EU DPP Provider"
  description="GS1 Digital Link 2D-QR-Code-Serialisierung, EN 18220:2026 Konformität und globale DNS-Auflösung für EU-Batteriepässe."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">GS1 Digital Link & 2D Barcode</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        GS1 Digital Link 2D Serialisierung
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Direkte Lasergravur auf Batteriegehäusen mit kontextabhängiger Weiterleitung für Endnutzer, Zollbehörden und Demontagebetriebe.
      </p>
    </div>
  </div>
</Layout>
