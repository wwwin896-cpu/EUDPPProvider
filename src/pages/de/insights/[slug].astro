---
import InsightsArticle from '../../../components/InsightsArticle.astro';
import { insightsLocale } from '../../../data/insights-locale';

export function getStaticPaths() {
  return insightsLocale.de.articles.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
---

<InsightsArticle locale="de" slug={slug} />
