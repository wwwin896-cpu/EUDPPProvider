---
import Layout from '../../layouts/Layout.astro';
import ComplianceCountdown from '../../components/ComplianceCountdown.astro';
---

<Layout
  title="Early Adopter Batteriepass Pilotprogramm (2026–2027) | EU DPP Provider"
  description="Strukturiertes Pilotprogramm für Batteriehersteller: 1–3 Batteriepack-Modelle, Frankfurter Datensafe-Sandbox und DG GROW Vorvalidierung."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">2026–2027 Pilotprogramm · Begrenzte Plätze</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Early Adopter <br class="hidden sm:inline" />
        <span class="text-cyan-600">Batteriepass Pilotprogramm</span>
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Erproben Sie Ihre Datenmodelle und Schnittstellen in unserer Frankfurter Sandbox vor dem Stichtag 18. Februar 2027.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a href="/de/contact/" class="neo-btn-primary">Pilotplatz anfragen →</a>
      </div>
      <div class="mt-12">
        <ComplianceCountdown />
      </div>
    </div>
  </div>
</Layout>
