---
import Layout from '../../../layouts/Layout.astro';
import BatteryPassportViewer from '../../../components/BatteryPassportViewer.astro';
---

<Layout
  title="EV-Batteriepass Lösungen | Verordnung (EU) 2023/1542 | EU DPP Provider"
  description="Digitale Produktpässe für Traktionsbatterien von Elektrofahrzeugen (EV), VIN-Kopplung, CO₂-Fußabdruck-Erklärungen und Catena-X Interoperabilität."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Elektromobilität & Automotive</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        EV-Batteriepass <br class="hidden sm:inline" />
        <span class="text-cyan-600">Enterprise-Lösungen</span>
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Erfüllen Sie die Anforderungen der Artikel 77 und 78 der EU-Batterieverordnung für Fahrzeug-Traktionsbatterien.
      </p>
    </div>

    <BatteryPassportViewer />
  </div>
</Layout>
