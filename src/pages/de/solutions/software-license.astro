---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Enterprise-DPP-Software-Suite (On-Premise) | EU DPP Provider"
  description="Private Cloud und On-Premise Softwarebereitstellung für Batteriehersteller. Volle Datensouveränität und direkte MES/ERP-Integration."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Private Cloud & On-Premise</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Enterprise DPP Software Suite
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Komplette Quellcode- und Datenkontrolle mit nativen MES-, ERP- und BMS-Konnektoren für industrielle Produktionslinien.
      </p>
    </div>
  </div>
</Layout>
