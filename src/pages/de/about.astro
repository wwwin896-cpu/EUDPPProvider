---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Über EU DPP Provider | Compliance & Datensafe"
  description="Erfahren Sie mehr über EU DPP Provider: Unsere Mission, 3-Schichten-Architektur, 10-Jahre-Datenhosting-SLA und grenzüberschreitende Batterie-Compliance-Entwicklung."
>
  <section class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="eyebrow-pill mb-6 mx-auto">
      <span class="w-2 h-2 rounded-full bg-cyan-600"></span>
      <span>Über EU DPP Provider · Unternehmensprofil</span>
    </div>

    <h1 class="text-3xl sm:text-5xl lg:text-[56px] font-extrabold tracking-tight leading-[1.12] text-slate-900 max-w-4xl mx-auto">
      Regulatorische Komplexität in <br class="hidden sm:inline" />
      <span class="text-cyan-600">prüfsichere Datenketten verwandeln</span>
    </h1>

    <p class="mt-6 text-base sm:text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
      EU DPP Provider ist ein spezialisierter Compliance-Technologieanbieter und Betreiber souveräner Datentresore. Wir verbinden globale Batteriehersteller, europäische Automobil-OEMs und EU-Marktüberwachungsbehörden über standardisierte, datenschutzwahrende digitale Produktpässe.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-4 items-center">
      <a href="mailto:info@eudppprovider.com" class="neo-btn-primary inline-flex items-center gap-2">
        <span>Business Desk: info@eudppprovider.com</span>
      </a>
      <a href="/de/contact" class="neo-pill px-6 py-3 rounded-full text-xs font-bold text-slate-800 hover:text-cyan-700">
        <span>Technisches Briefing anfragen →</span>
      </a>
    </div>
  </section>

  <section class="py-16 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="neo-surface p-8 sm:p-12 text-center bg-gradient-to-br from-[#F0F4F8] to-cyan-50/40 border border-cyan-200/60">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        Kontaktieren Sie unser Engineering-Team
      </h2>
      <p class="mt-3 text-xs sm:text-sm text-slate-600 max-w-xl mx-auto">
        Bereit, Ihre Batteriedaten-Reife zu evaluieren? Schreiben Sie direkt an unseren zentralen Business Desk.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="mailto:info@eudppprovider.com" class="neo-btn-primary">
          info@eudppprovider.com
        </a>
      </div>
    </div>
  </section>
</Layout>
