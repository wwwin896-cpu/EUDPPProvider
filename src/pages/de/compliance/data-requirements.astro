      </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="neo-well p-4 sm:p-5 rounded-2xl flex flex-wrap items-center justify-between gap-4 mb-6">
      <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
        {domains.map((dom, index) => (
          <button
            onclick={`filterDomain('${dom.id}')`}
            id={`filter-btn-${dom.id}`}
            class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all ${index === 0 ? 'bg-cyan-600 text-white shadow-sm' : 'bg-white/80 text-slate-700 border border-slate-200 hover:bg-slate-100'}`}
          >
            {dom.name}
          </button>
        ))}
      </div>

      <div class="w-full sm:w-64">
        <input
          id="table-search"
          type="text"
          placeholder="Suchen nach Attributen..."
          oninput="searchAttributes()"
          class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs bg-white focus:border-cyan-500 outline-none"
        />
      </div>
    </div>

    <!-- 71 Attributes Table -->
    <div class="neo-surface p-4 sm:p-6 rounded-3xl overflow-hidden shadow-xl border border-white/80">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-slate-900 text-white font-mono text-[11px] uppercase tracking-wider">
              <th class="p-3.5 rounded-l-xl">Nr.</th>
              <th class="p-3.5">Gesetzlicher Attributname</th>
              <th class="p-3.5">EU-Rechtsgrundlage</th>
              <th class="p-3.5">Spezifikation / Beschreibung</th>
              <th class="p-3.5">Zuständigkeit</th>
              <th class="p-3.5">Zugriffsebene</th>
              <th class="p-3.5 rounded-r-xl">Pflicht ab</th>
            </tr>
          </thead>
          <tbody id="checklist-tbody" class="divide-y divide-slate-200 text-slate-700">
            {checklistItems.map((item) => (
              <tr class="hover:bg-cyan-50/50 transition-colors row-item" data-domain={item.domain} data-text={`${item.name} ${item.legal} ${item.desc} ${item.owner}`}>
                <td class="p-3 font-mono font-bold text-slate-500">{item.no}</td>
                <td class="p-3 font-bold text-slate-900">{item.name}</td>
                <td class="p-3 font-mono text-cyan-800 text-[11px] whitespace-nowrap">{item.legal}</td>
                <td class="p-3 text-slate-600 text-[11px] max-w-xs">{item.desc}</td>
                <td class="p-3 whitespace-nowrap">
                  <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-medium text-[10px]">{item.owner}</span>
                </td>
                <td class="p-3 whitespace-nowrap">
                  <span class={`px-2 py-0.5 rounded-md font-mono text-[10px] font-bold ${item.tier.includes('Öffentlich') ? 'bg-green-100 text-green-800' : item.tier.includes('ZKP') ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800'}`}>
                    {item.tier}
                  </span>
                </td>
                <td class="p-3 font-mono text-slate-500 text-[11px] whitespace-nowrap">{item.date}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-12 text-center space-y-4">
      <p class="text-sm text-slate-600">
        Benötigen Sie Unterstützung bei der Zuordnung Ihrer MES/ERP-Datenfelder zu den 71 Attributen?
      </p>
      <a href="/de/contact/" class="neo-btn-primary inline-flex items-center gap-2">
        <span>Fachliche Beratung anfragen →</span>
      </a>
    </div>

  </div>
</Layout>

<script is:inline>
  let activeDomain = 'all';

  function filterDomain(domainId) {
    activeDomain = domainId;
    const buttons = document.querySelectorAll('[id^="filter-btn-"]');
    buttons.forEach(btn => {
      if (btn.id === `filter-btn-${domainId}`) {
        btn.className = 'px-3 py-1.5 rounded-xl text-xs font-bold transition-all bg-cyan-600 text-white shadow-sm';
      } else {
        btn.className = 'px-3 py-1.5 rounded-xl text-xs font-bold transition-all bg-white/80 text-slate-700 border border-slate-200 hover:bg-slate-100';
      }
    });
    applyFilters();
  }

  function searchAttributes() {
    applyFilters();
  }

  function applyFilters() {
    const query = document.getElementById('table-search')?.value.toLowerCase() || '';
    const rows = document.querySelectorAll('.row-item');

    rows.forEach(row => {
      const rowDomain = row.getAttribute('data-domain');
      const rowText = row.getAttribute('data-text')?.toLowerCase() || '';

      const matchDomain = (activeDomain === 'all' || rowDomain === activeDomain);
      const matchSearch = (!query || rowText.includes(query));

      if (matchDomain && matchSearch) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }
</script>
