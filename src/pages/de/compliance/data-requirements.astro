---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="90+ EU-Batteriepass Pflichtdaten Checkliste | EU DPP Provider"
  description="Technische Spezifikation der 7 Datenbereiche und 90+ Attribute gemäß Verordnung (EU) 2023/1542 Anhang XIII."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Verordnung (EU) 2023/1542 · Anhang XIII</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        90+ Pflichtdatenanforderungen für den Batteriepass
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Übersicht der 7 Compliance-Bereiche und Zugriffsebenen für Batteriehersteller.
      </p>
    </div>
  </div>
</Layout>
