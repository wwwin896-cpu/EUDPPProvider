---
import Layout from '../../../layouts/Layout.astro';
import ComplianceCountdown from '../../../components/ComplianceCountdown.astro';
---

<Layout
  title="EU-Batterieverordnung (EU 2023/1542) Leitfaden | EU DPP Provider"
  description="Vollständiger Leitfaden zur Verordnung (EU) 2023/1542, Artikel 77/78 Batteriepass-Mandat, Fristen ab 2027 und technische Checkliste."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Regulatorischer Leitfaden</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        EU-Batterieverordnung <br class="hidden sm:inline" />
        <span class="text-cyan-600">(EU 2023/1542)</span>
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Verbindliche Fristen, Anforderungen an CO₂-Bilanzen und Konformitätsstufen für internationale Batteriehersteller.
      </p>
    </div>

    <ComplianceCountdown />
  </div>
</Layout>
