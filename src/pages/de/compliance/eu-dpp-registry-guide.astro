---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="EU DPP Central Registry & eIDAS 2.0 Integrationsleitfaden | EU DPP Provider"
  description="Schritt-für-Schritt-Anleitung für Wirtschaftsakteure: DG GROW EU DPP Registry Registrierung, EU Login und eIDAS 2.0 QSeal digitale Siegel."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">DG GROW Zentrales Register</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        EU DPP Registry & <br class="hidden sm:inline" />
        <span class="text-cyan-600">eIDAS 2.0 Siegel</span>
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Direkte Anbindung an das seit dem 20. Juli 2026 betriebene EU-Zentralregister zur Hinterlegung von Unique Product Identifiers (UPI).
      </p>
    </div>
  </div>
</Layout>
