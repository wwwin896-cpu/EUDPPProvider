---
import Layout from '../../layouts/Layout.astro';
import PricingCalculator from '../../components/PricingCalculator.astro';
---

<Layout
  title="Bereitstellungsmodelle & Implementierung | EU DPP Provider"
  description="Strukturierte B2B-Geschäftsmodelle für den EU-Batteriepass: Managed Cloud Abonnement vs. On-Premise Enterprise Suite."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Kommerzielle & Technische Architektur</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Enterprise Bereitstellungsmodelle <br />
        <span class="text-cyan-600">& 4-Schritte Implementierungs-Roadmap</span>
      </h1>
      <p class="mt-6 text-base sm:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
        Wählen Sie zwischen unserem schlüsselfertigen 10-Jahre-Datensafe in Frankfurt und der vollständigen On-Premise-Softwarebereitstellung in Ihrem eigenen Rechenzentrum.
      </p>
    </div>

    <div class="max-w-5xl mx-auto">
      <PricingCalculator />
    </div>
  </div>
</Layout>
