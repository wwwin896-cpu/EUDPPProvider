---
import Layout from '../../layouts/Layout.astro';
import PricingCalculator from '../../components/PricingCalculator.astro';
---

<Layout
  title="Preise & Bereitstellungsmodelle | EU DPP Provider"
  description="Transparente Enterprise-Lizenzen und 10-Jahre-Datensafe-Hostingpreise für die EU-Batteriepass-Konformität (Verordnung EU 2023/1542)."
>
  <div class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="eyebrow mb-2">Kommerzielle Modelle</div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
          Enterprise-Lizenzen & Verwalteter Datensafe
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
          Wählen Sie zwischen vollständigem On-Premise-Softwarebesitz oder sorglosem 10-Jahre-Hosting im souveränen EU-Datensafe.
        </p>
      </div>

      <PricingCalculator />

      <div class="mt-16 text-center">
        <a href="mailto:info@eudppprovider.com" class="btn-primary">
          Individuelles Angebot anfordern: info@eudppprovider.com
        </a>
      </div>
    </div>
  </div>
</Layout>
