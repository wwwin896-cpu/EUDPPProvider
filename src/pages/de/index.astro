---
import Layout from '../../layouts/Layout.astro';
import ComplianceCountdown from '../../components/ComplianceCountdown.astro';
import LiveWorkflowVideoDemo from '../../components/LiveWorkflowVideoDemo.astro';
import BatteryPassportViewer from '../../components/BatteryPassportViewer.astro';
import CrossIndustryDPP from '../../components/CrossIndustryDPP.astro';
import PricingCalculator from '../../components/PricingCalculator.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title="EU DPP Provider | EU-Batteriepass Software & Datensafe"
  description="Prüfsichere Batteriepässe nach Verordnung (EU) 2023/1542: Enterprise-Software, 10-Jahre-Datensafe, ZKP-Formelschutz und EU-Registerunterstützung."
>

  <!-- ==================== HERO SECTION ==================== -->
  <section class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Top Pill Badge -->
    <div class="eyebrow-pill mb-6 mx-auto">
      <span class="w-2 h-2 rounded-full bg-cyan-600 animate-pulse"></span>
      <span>EU-Verordnung 2023/1542 · Batteriepass bereit</span>
    </div>

    <!-- Punchy Marketing Headline -->
    <h1 class="text-4xl sm:text-5xl lg:text-[58px] font-extrabold tracking-tight leading-[1.12] text-slate-900 max-w-4xl mx-auto">
      Enterprise EU-Batteriepass Plattform <br class="hidden sm:inline" />
      <span class="text-cyan-600">& Souveräner Datensafe</span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
      Der QR-Code ist nur der Einstiegspunkt — entscheidend für die Zollabfertigung ist die prüfsichere Datenkette dahinter. Wir integrieren MES- und BMS-Daten in einen konformen digitalen Produktpass.
    </p>

    <!-- Tactile CTA Row -->
    <div class="mt-8 flex flex-wrap justify-center gap-4 items-center">
      <a
        href="/de/contact/"
        class="neo-btn-primary inline-flex items-center gap-2"
      >
        <span>Technische Beratung anfragen →</span>
      </a>

      <a
        href="mailto:info@eudppprovider.com"
        class="neo-pill px-6 py-3 rounded-full text-xs sm:text-sm font-bold text-slate-800 hover:text-cyan-700 flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>info@eudppprovider.com</span>
      </a>
    </div>

    <!-- Soft UI Countdown Capsule -->
    <div class="mt-14">
      <ComplianceCountdown />
    </div>

  </section>

  <!-- ==================== LIVE WORKFLOW DEMONSTRATION ==================== -->
  <LiveWorkflowVideoDemo />

  <!-- ==================== BANNER SECTION 1: INDUSTRIAL FACTORY VERIFICATION ==================== -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/60 min-h-[460px] flex items-center">
      
      <!-- Background Image -->
      <img 
        src="/images/banner_factory_scan.webp" 
        alt="Industrielle Batteriepack-Lasermarkierung und Scan-Verifizierung" 
        class="absolute inset-0 w-full h-full object-cover object-center"
        loading="lazy"
        decoding="async"
        srcset="/images/banner_factory_scan-768.webp 768w, /images/banner_factory_scan-1280.webp 1280w, /images/banner_factory_scan.webp 1792w"
        sizes="100vw"
        width="1792"
        height="1024"
        fetchpriority="high"
        decoding="async"
      />

      <!-- High-End Dark Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-navy-900/95 via-navy-900/80 to-navy-900/30 backdrop-blur-[2px]"></div>

      <!-- Foreground Text & Badge Content -->
      <div class="relative z-10 p-8 sm:p-12 lg:p-16 max-w-2xl text-white">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 mb-5">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span>Industrielle Rückverfolgbarkeit in der Praxis</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-[1.15] text-white">
          Von der Fabriklasergravur zur <br />
          <span class="text-cyan-400">EU-Zollabfertigung</span>
        </h2>

        <p class="mt-4 text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
          Dauerhafte GS1 Digital Link 2D-Barcodes direkt auf Batteriegehäusen eingraviert. Weltweit sekundenschnell auflösbar für Zollbehörden, Prüflabore und zertifizierte Recycler.
        </p>

        <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 border-t border-white/15 text-xs">
          <div>
            <div class="font-mono text-cyan-400 font-bold text-base sm:text-lg">&lt;50ms</div>
            <div class="text-slate-400 mt-0.5">Globale DNS-Auflösung</div>
          </div>
          <div>
            <div class="font-mono text-green-400 font-bold text-base sm:text-lg">eIDAS 2.0</div>
            <div class="text-slate-400 mt-0.5">PAdES Baseline Siegel</div>
          </div>
          <div class="hidden sm:block">
            <div class="font-mono text-cyan-400 font-bold text-base sm:text-lg">EN 18220</div>
            <div class="text-slate-400 mt-0.5">Harmonisierte Norm 2026</div>
          </div>
        </div>

        <div class="mt-8">
          <a href="/de/platform/gs1-qr-serialization/" class="btn-primary-cyan inline-flex items-center gap-2 text-xs sm:text-sm font-bold">
            <span>Fabrikserialisierung entdecken →</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== 3 CORE PILLARS ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="eyebrow-pill mb-2">3-Schichten-Architektur</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        Lösung für drei Kernherausforderungen
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      
      <!-- Pillar 1 -->
      <div class="neo-surface p-8 flex flex-col justify-between group hover:scale-[1.01] transition-transform">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-cyan-100 text-cyan-700 flex items-center justify-center font-mono font-bold text-lg mb-6">
            01
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight mb-3">
            Schutz von Geschäftsgeheimnissen (ZKP)
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Verhindern Sie die Offenlegung vertraulicher chemischer Rezepturen und Einkaufspreise. Zero-Knowledge-Proofs (ZKP) ermöglichen Konformitätsprüfungen ohne Rohdatenabfluss.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/de/about/" class="text-xs font-bold text-cyan-700 hover:text-cyan-800 flex items-center gap-1">
            <span>Architektur ansehen</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Pillar 2 -->
      <div class="neo-surface p-8 flex flex-col justify-between group hover:scale-[1.01] transition-transform">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-green-100 text-green-700 flex items-center justify-center font-mono font-bold text-lg mb-6">
            02
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight mb-3">
            Souveränes 10-Jahre-Datenhosting
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Erfüllen Sie die 10-jährige Speichervorschrift nach ESPR Art. 11. Unser ISO 27001 zertifizierter Datensafe in Frankfurt am Main vertraglich zugesicherte 99,9% Verfügbarkeit.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/de/solutions/managed-data-hosting/" class="text-xs font-bold text-green-700 hover:text-green-800 flex items-center gap-1">
            <span>Datensafe erkunden</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Pillar 3 -->
      <div class="neo-surface p-8 flex flex-col justify-between group hover:scale-[1.01] transition-transform">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-navy-100 text-navy-800 flex items-center justify-center font-mono font-bold text-lg mb-6">
            03
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight mb-3">
            DG GROW Zentralregister-Anbindung
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Automatisierte Übermittlung von Unique Product Identifiers (UPI) an das EU-Zentralregister inklusive eIDAS 2.0 digitaler Siegel.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/de/compliance/eu-dpp-registry-guide/" class="text-xs font-bold text-slate-800 hover:text-cyan-700 flex items-center gap-1">
            <span>Registerleitfaden lesen</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== BANNER SECTION 2: SOVEREIGN CLOUD CONTROL ==================== -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/60 min-h-[460px] flex items-center">
      
      <!-- Background Image -->
      <img 
        src="/images/banner_sovereign_vault.webp" 
        alt="Europäisches Datenzentrum und DPP Compliance Kontrollraum in Frankfurt" 
        class="absolute inset-0 w-full h-full object-cover object-center"
        loading="lazy"
        decoding="async"
        srcset="/images/banner_sovereign_vault-768.webp 768w, /images/banner_sovereign_vault-1280.webp 1280w, /images/banner_sovereign_vault.webp 1792w"
        sizes="100vw"
        width="1792"
        height="1024"
        loading="lazy"
        decoding="async"
      />

      <!-- Dark Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-navy-950/95 via-navy-950/80 to-navy-900/35 backdrop-blur-[2px]"></div>

      <!-- Foreground Content -->
      <div class="relative z-10 p-8 sm:p-12 lg:p-16 max-w-2xl text-white">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-green-500/20 text-green-300 border border-green-400/30 mb-5">
          <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
          <span>Souveränes Rechenzentrum Frankfurt</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-[1.15] text-white">
          Souveräner Datensafe & <br />
          <span class="text-green-400">Regulatorisches Operationszentrum</span>
        </h2>

        <p class="mt-4 text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
          Tier-IV Hochsicherheitsrechenzentren in Frankfurt am Main und München. Garantierte 99,9% SLA-Verfügbarkeit, automatische Schema-Updates und strikte DSGVO-Datenhoheit.
        </p>

        <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 border-t border-white/15 text-xs">
          <div>
            <div class="font-mono text-green-400 font-bold text-base sm:text-lg">ISO 27001</div>
            <div class="text-slate-400 mt-0.5">Zertifizierte Rechenzentren</div>
          </div>
          <div>
            <div class="font-mono text-cyan-400 font-bold text-base sm:text-lg">99,9% SLA</div>
            <div class="text-slate-400 mt-0.5">Verfügbarkeitsgarantie</div>
          </div>
          <div class="hidden sm:block">
            <div class="font-mono text-green-400 font-bold text-base sm:text-lg">10 Jahre</div>
            <div class="text-slate-400 mt-0.5">ESPR Art. 11 Datenspeicherung</div>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-4 items-center">
          <a href="/de/solutions/managed-data-hosting/" class="btn-primary-cyan inline-flex items-center gap-2 text-xs sm:text-sm font-bold">
            <span>Datensafe-Details ansehen →</span>
          </a>
          <a href="mailto:info@eudppprovider.com" class="px-5 py-3 rounded-full text-xs font-bold text-white/90 hover:text-white bg-white/10 hover:bg-white/20 border border-white/20 transition-all">
            Kontakt: info@eudppprovider.com
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== INTERACTIVE PASSPORT VIEWER ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="eyebrow-pill mb-2">Interaktive Simulation</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        4-Rollen Batteriepass-Viewer
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-2">
        Testen Sie, wie Endkunden, Zollbehörden, Recycler und OEMs unterschiedliche Datenbereiche einsehen.
      </p>
    </div>

    <BatteryPassportViewer />
  </section>

  <!-- ==================== ESPR MULTI-KATEGORIE ARCHITEKTUR ==================== -->
  <CrossIndustryDPP />

  <!-- ==================== PRICING CALCULATOR SECTION ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="eyebrow-pill mb-2">Transparente Preismodelle</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        Bereitstellungsmodelle & Kostenkalkulator
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-2">
        Wählen Sie zwischen Private-Cloud-Softwarelizenzierung oder schlüsselfertigem 10-Jahre-Datensafe-Hosting.
      </p>
    </div>

    <PricingCalculator />
  </section>

</Layout>
