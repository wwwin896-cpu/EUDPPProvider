---
import Layout from '../layouts/Layout.astro';
import BatteryPassportViewer from '../components/BatteryPassportViewer.astro';
import ComplianceCountdown from '../components/ComplianceCountdown.astro';

const faqs = [
  {
    question: "What is an EU Battery Passport under Regulation (EU) 2023/1542?",
    answer: "An EU Battery Passport is a mandatory digital compliance record accessible via a GS1 Digital Link 2D barcode for all EV batteries, LMT batteries (≤25kg), and industrial batteries (>2kWh) placed on the EU market, effective February 18, 2027. It contains over 70 data points across 7 domains including carbon footprint declarations, recycled content, and supply chain due diligence."
  },
  {
    question: "Who is required to provide a Battery Passport?",
    answer: "Economic operators who place batteries or vehicles/products containing batteries on the European Union market, including domestic EU manufacturers, international battery cell/pack exporters, and vehicle OEMs."
  },
  {
    question: "How does EU DPP Provider protect proprietary chemical formulas and BOM costs?",
    answer: "Our architecture utilizes domestic cleanroom computation and Zero-Knowledge Proof (ZKP) cryptographic shields. Raw chemical ratios and purchasing costs are calculated locally, and only required statutory compliance assertions and whitelist attributes are transmitted across borders."
  },
  {
    question: "What is the difference between Enterprise Software and Managed Data Vault Hosting?",
    answer: "The Enterprise Software Suite is deployed on your own private cloud or on-premise infrastructure for complete code sovereignty and zero per-scan fees. The 10-Year Managed Data Vault delegates hosting to our ISO 27001 certified Frankfurt data center with a guaranteed 99.9% uptime SLA and automated 30-day regulatory updates."
  }
];
---

<Layout
  title="EU Battery Passport Platform & Software Solutions"
  description="Enterprise EU Battery Passport software, carbon footprint engine, GS1 QR serialization and 10-year sovereign vault for EV, LMT and industrial batteries."
  faqs={faqs}
>
  <!-- ==================== HERO SECTION ==================== -->
  <section class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="eyebrow-pill mb-6 mx-auto">
      <span class="w-2 h-2 rounded-full bg-cyan-600 animate-pulse"></span>
      <span>Regulation (EU) 2023/1542 · Definitive Battery Passport Platform</span>
    </div>

    <h1 class="text-4xl sm:text-5xl lg:text-[58px] font-extrabold tracking-tight leading-[1.12] text-slate-900 max-w-4xl mx-auto">
      The Enterprise Software & <br class="hidden sm:inline" />
      <span class="text-cyan-600">Sovereign Vault for EU Battery Passports</span>
    </h1>

    <p class="mt-6 text-base sm:text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
      A complete, audit-ready compliance infrastructure bridging factory MES and BMS systems into verifiable Digital Product Passports. Compliant with Articles 77 and 78 of Regulation (EU) 2023/1542 and the European Commission's DG GROW Central Registry.
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-4 items-center">
      <a href="mailto:info@eudppprovider.com" class="neo-btn-primary inline-flex items-center gap-2">
        <span>Request Technical Scoping →</span>
      </a>
      <a href="/pricing" class="neo-pill px-6 py-3 rounded-full text-xs sm:text-sm font-bold text-slate-800 hover:text-cyan-700">
        <span>View Deployment Pricing</span>
      </a>
    </div>

    <div class="mt-14">
      <ComplianceCountdown />
    </div>

  </section>

  <!-- ==================== BATTERY CATEGORIES GRID ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="eyebrow-pill mb-2">Mandatory Battery Categories</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        Tailored Solutions for Every Battery Class
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-2">
        Mandatory compliance across all battery form factors by February 18, 2027.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-cyan-100 text-cyan-700 flex items-center justify-center font-bold text-xl mb-4">
            🚗
          </div>
          <h3 class="text-lg lg:text-xl font-bold text-slate-900 mb-2">Electric Vehicle (EV) Passports</h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            Automotive traction battery compliance, vehicle VIN pairing, Scope 1-3 PEFCR carbon declarations, and Catena-X data space interoperability.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/solutions/ev-battery-passport" class="text-xs sm:text-sm font-bold text-cyan-600 hover:text-cyan-700">EV Solutions →</a>
        </div>
      </div>

      <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-green-100 text-green-700 flex items-center justify-center font-bold text-xl mb-4">
            🚲
          </div>
          <h3 class="text-lg lg:text-xl font-bold text-slate-900 mb-2">LMT & E-Bike Batteries (≤25kg)</h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            High-density laser QR serialization for compact light mobility packs, e-bikes, and e-scooters with automated recycled content logging.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/solutions/lmt-battery-passport" class="text-xs sm:text-sm font-bold text-green-700 hover:text-green-800">LMT Solutions →</a>
        </div>
      </div>

      <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-xl mb-4">
            🏭
          </div>
          <h3 class="text-lg lg:text-xl font-bold text-slate-900 mb-2">Stationary Storage & BESS (>2kWh)</h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            Modular cell-to-container hierarchy, State of Health (SOH) telemetry aggregation, and second-life repurposing audit trails.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/solutions/storage-battery-passport" class="text-xs sm:text-sm font-bold text-amber-700 hover:text-amber-800">BESS Solutions →</a>
        </div>
      </div>

    </div>

  </section>

  <!-- ==================== INTERACTIVE PASSPORT SIMULATOR ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="eyebrow-pill mb-2">Interactive Demonstration</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        4-Tier Role-Based Passport Simulation
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-2">
        Test how consumers, customs officers, certified recyclers, and OEM engineers access differentiated disclosure tiers.
      </p>
    </div>

    <BatteryPassportViewer />
  </section>

  <!-- ==================== FAQ SECTION ==================== -->
  <section class="py-16 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="eyebrow-pill mb-2">Frequently Asked Questions</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        EU Battery Passport Essentials
      </h2>
    </div>

    <div class="space-y-4">
      {faqs.map(faq => (
        <div class="neo-surface p-6 sm:p-7">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 mb-2">{faq.question}</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ==================== FINAL CTA ==================== -->
  <section class="py-16 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="neo-surface p-8 sm:p-12 text-center bg-gradient-to-br from-[#F0F4F8] to-cyan-50/40 border border-cyan-200/60">
      <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Ready to Launch Your Battery Passport Implementation?
      </h2>
      <p class="mt-3 text-xs sm:text-sm text-slate-600 max-w-xl mx-auto">
        Speak directly with our battery compliance engineering team to scope your data model and ensure full compliance before the 2027 deadline.
      </p>

      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="mailto:info@eudppprovider.com" class="neo-btn-primary">
          Contact: info@eudppprovider.com
        </a>
        <a href="/about" class="neo-pill px-6 py-3 rounded-full text-xs sm:text-sm font-bold text-slate-800 hover:text-cyan-700">
          About Our Architecture →
        </a>
      </div>
    </div>
  </section>

</Layout>
