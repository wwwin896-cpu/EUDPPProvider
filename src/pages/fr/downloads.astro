---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title="Centre de Téléchargement & Modèles de Conformité | EU DPP Provider"
  description="Téléchargez gratuitement les modèles de passeport batterie de l'UE : matrice des 71 attributs Annexe XIII (Excel/CSV), formulaires d'audit et guides officiels."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-4xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">
        <span class="w-2 h-2 rounded-full bg-cyan-600 animate-pulse"></span>
        <span>Ressources & Centre de Téléchargement</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Modèles de Conformité & <br class="hidden sm:inline" />
        <span class="text-cyan-600">Téléchargements Officiels EU DPP</span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
        Matrices Excel/CSV gratuites, questionnaires d'auto-évaluation, guides des normes harmonisées de l'UE et livres blancs d'architecture technique.
      </p>
    </div>

    <div class="space-y-12">
      
      <!-- 01: Modèles -->
      <div class="space-y-6">
        <div class="flex items-center gap-3 pb-3 border-b border-slate-200">
          <span class="w-8 h-8 rounded-xl bg-cyan-100 text-cyan-800 flex items-center justify-center font-bold text-sm">01</span>
          <div>
            <h2 class="text-xl font-bold text-slate-900">Modèles d'Auto-Évaluation et Déclaration de Données</h2>
            <p class="text-xs text-slate-500">Tableaux Excel et CSV prêts à l'emploi pour votre analyse d'écart interne.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="neo-surface p-6 flex flex-col justify-between space-y-4 rounded-3xl border border-white/80 shadow-md">
            <div class="space-y-2">
              <span class="px-2.5 py-0.5 rounded-full bg-cyan-100 text-cyan-800 font-mono text-[10px] font-bold">XLSX · 15 KB</span>
              <h3 class="font-bold text-slate-900 text-base">Matrice des 71 Attributs Obligatoires Annexe XIII</h3>
              <p class="text-xs text-slate-600 leading-relaxed">Spécification complète avec articles juridiques UE, responsabilités et calendrier 2026–2031.</p>
            </div>
            <a href="/downloads/EU_Battery_Passport_71_Data_Requirements_Checklist.xlsx" download="EU_Battery_Passport_71_Data_Requirements_Checklist.xlsx" class="neo-btn-primary w-full py-2.5 text-xs font-bold text-center block">
              📥 Télécharger Excel (.xlsx)
            </a>
          </div>

          <div class="neo-surface p-6 flex flex-col justify-between space-y-4 rounded-3xl border border-white/80 shadow-md">
            <div class="space-y-2">
              <span class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 font-mono text-[10px] font-bold">CSV · 16 KB</span>
              <h3 class="font-bold text-slate-900 text-base">Matrice des 71 Attributs (Format Échange CSV)</h3>
              <p class="text-xs text-slate-600 leading-relaxed">Format universel pour l'intégration automatique dans vos systèmes ERP/MES.</p>
            </div>
            <a href="/downloads/EU_Battery_Passport_71_Data_Requirements_Checklist.csv" download="EU_Battery_Passport_71_Data_Requirements_Checklist.csv" class="w-full py-2.5 px-4 rounded-full bg-white border border-slate-300 hover:border-cyan-500 font-bold text-xs text-slate-800 text-center block">
              📄 Télécharger CSV
            </a>
          </div>

          <div class="neo-surface p-6 flex flex-col justify-between space-y-4 rounded-3xl border border-white/80 shadow-md">
            <div class="space-y-2">
              <span class="px-2.5 py-0.5 rounded-full bg-green-100 text-green-800 font-mono text-[10px] font-bold">Questionnaire XLSX</span>
              <h3 class="font-bold text-slate-900 text-base">Questionnaire d'Audit d'Écart de Conformité</h3>
              <p class="text-xs text-slate-600 leading-relaxed">Évaluation pour sérialisation SGTIN, modèles ACV, recyclé et télémétrie BMS.</p>
            </div>
            <a href="/downloads/EU_Battery_Passport_Gap_Assessment_Form.xlsx" download="EU_Battery_Passport_Gap_Assessment_Form.xlsx" class="w-full py-2.5 px-4 rounded-full bg-white border border-slate-300 hover:border-cyan-500 font-bold text-xs text-slate-800 text-center block">
              📥 Télécharger Questionnaire
            </a>
          </div>
        </div>
      </div>

      <!-- 02: Guides -->
      <div class="space-y-6">
        <div class="flex items-center gap-3 pb-3 border-b border-slate-200">
          <span class="w-8 h-8 rounded-xl bg-blue-100 text-blue-800 flex items-center justify-center font-bold text-sm">02</span>
          <div>
            <h2 class="text-xl font-bold text-slate-900">Guides Officiels des Normes et Réglementations UE</h2>
            <p class="text-xs text-slate-500">Textes réglementaires et spécifications CEN/CENELEC.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="neo-surface p-6 flex flex-col justify-between space-y-4 rounded-3xl border border-white/80 shadow-md">
            <div class="space-y-2">
              <span class="text-[10px] font-mono font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded">Règlement (UE) 2023/1542</span>
              <h3 class="font-bold text-slate-900 text-sm">Feuille de Route Règlement Batterie UE</h3>
              <p class="text-xs text-slate-600">Obligations des articles 77/78 et calendrier 2026–2031.</p>
            </div>
            <a href="/fr/compliance/eu-battery-regulation-2023-1542/" class="text-xs font-bold text-cyan-700 hover:underline">Lire le guide →</a>
          </div>

          <div class="neo-surface p-6 flex flex-col justify-between space-y-4 rounded-3xl border border-white/80 shadow-md">
            <div class="space-y-2">
              <span class="text-[10px] font-mono font-bold text-purple-700 bg-purple-50 px-2 py-0.5 rounded">EN 18220 / EN 18219</span>
              <h3 class="font-bold text-slate-900 text-sm">Guide des Normes Harmonisées</h3>
              <p class="text-xs text-slate-600">Syntaxe GS1 Digital Link et enregistrement de l'identifiant UPI.</p>
            </div>
            <a href="/fr/compliance/en-standards-guide/" class="text-xs font-bold text-cyan-700 hover:underline">Lire le guide normes →</a>
          </div>

          <div class="neo-surface p-6 flex flex-col justify-between space-y-4 rounded-3xl border border-white/80 shadow-md">
            <div class="space-y-2">
              <span class="text-[10px] font-mono font-bold text-green-700 bg-green-50 px-2 py-0.5 rounded">Registre DG GROW</span>
              <h3 class="font-bold text-slate-900 text-sm">Registre Central UE & eIDAS 2.0</h3>
              <p class="text-xs text-slate-600">Spécification d'interface et signature électronique qualifiée.</p>
            </div>
            <a href="/fr/compliance/eu-dpp-registry-guide/" class="text-xs font-bold text-cyan-700 hover:underline">Lire le guide registre →</a>
          </div>
        </div>
      </div>

      <!-- 03: Simulateur -->
      <div class="space-y-6">
        <div class="flex items-center gap-3 pb-3 border-b border-slate-200">
          <span class="w-8 h-8 rounded-xl bg-green-100 text-green-800 flex items-center justify-center font-bold text-sm">03</span>
          <div>
            <h2 class="text-xl font-bold text-slate-900">Simulateurs et Outils d'Architecture</h2>
            <p class="text-xs text-slate-500">Expérience sandbox et configurateurs de déploiement.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="neo-surface p-6 sm:p-8 flex flex-col justify-between space-y-4 rounded-3xl border border-white/80 shadow-md">
            <div class="space-y-2">
              <span class="text-[10px] font-mono font-bold text-purple-700 uppercase">Bac à Sable en Direct</span>
              <h3 class="font-bold text-slate-900 text-base">Simulateur de Portail et Passeport Batterie</h3>
              <p class="text-xs text-slate-600">Testez la saisie des données et visualisez le passeport généré en direct.</p>
            </div>
            <a href="/fr/portal-simulator/" class="neo-btn-primary inline-flex items-center justify-center text-xs py-2.5">
              <span>Lancer le simulateur →</span>
            </a>
          </div>

          <div class="neo-surface p-6 sm:p-8 flex flex-col justify-between space-y-4 rounded-3xl border border-white/80 shadow-md">
            <div class="space-y-2">
              <span class="text-[10px] font-mono font-bold text-cyan-700 uppercase">Configurateur</span>
              <h3 class="font-bold text-slate-900 text-base">Configurateur d'Architecture et Portée</h3>
              <p class="text-xs text-slate-600">Configurez votre volume de production et modèle de déploiement.</p>
            </div>
            <a href="/fr/pricing/" class="w-full py-2.5 px-4 rounded-full bg-white border border-slate-300 hover:border-cyan-500 font-bold text-xs text-slate-800 text-center block">
              <span>Ouvrir le configurateur →</span>
            </a>
          </div>
        </div>
      </div>

    </div>

  </div>
</Layout>
