---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Moteur d'Empreinte Carbone (PCF) | EU DPP Provider"
  description="Calcul d'empreinte carbone conforme PEFCR et déclarations d'émissions de batteries sous le règlement (UE) 2023/1542."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">PEFCR & Émissions Scope 1-3</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Moteur d'Empreinte Carbone (PCF)
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Calculs automatisés des émissions sur l'ensemble du cycle de vie et conformité aux standards européens.
      </p>
    </div>
  </div>
</Layout>
