---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Sérialisation GS1 Digital Link 2D & Gravure Laser | EU DPP Provider"
  description="Sérialisation par code QR GS1 Digital Link 2D et résolution DNS mondiale pour passeports batterie de l'UE."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">GS1 Digital Link & Barcodes 2D</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Sérialisation GS1 Digital Link 2D
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Spécifications de gravure laser et redirection dynamique pour douanes et recycleurs.
      </p>
    </div>
  </div>
</Layout>
