---
import Layout from '../../layouts/Layout.astro';
import PricingCalculator from '../../components/PricingCalculator.astro';
---

<Layout
  title="Tarifs & Modèles de Déploiement | EU DPP Provider"
  description="Tarification transparente des licences d'entreprise et de l'hébergement sécurisé de coffre-fort de données pour la conformité au passeport batterie de l'UE."
>
  <div class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="eyebrow mb-2">Modèles Commerciaux</div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
          Licences d'Entreprise & Coffre-fort de Données
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
          Choisissez entre la propriété totale du logiciel sur site ou l'hébergement sécurisé de données sur 10 ans dans un coffre-fort souverain de l'UE.
        </p>
      </div>

      <PricingCalculator />

      <div class="mt-16 text-center">
        <a href="mailto:info@eudppprovider.com" class="btn-primary">
          Demander un devis sur mesure : info@eudppprovider.com
        </a>
      </div>
    </div>
  </div>
</Layout>
