---
import Layout from '../../layouts/Layout.astro';
import PricingCalculator from '../../components/PricingCalculator.astro';
---

<Layout
  title="Modèles de Déploiement & Intégration | EU DPP Provider"
  description="Modèles d'engagement B2B structurés pour le passeport batterie UE : abonnement cloud souverain géré vs suite d'entreprise sur site."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Architecture Commerciale & Technique</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Modèles de Déploiement Entreprise <br />
        <span class="text-cyan-600">& Feuille de Route en 4 Étapes</span>
      </h1>
      <p class="mt-6 text-base sm:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
        Choisissez entre notre hébergement souverain de 10 ans à Francfort et le déploiement sur site dans votre propre centre de données.
      </p>
    </div>

    <div class="max-w-5xl mx-auto">
      <PricingCalculator />
    </div>
  </div>
</Layout>
