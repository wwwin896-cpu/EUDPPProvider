---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Guide Registre Central EU DPP & Sceaux eIDAS 2.0 | EU DPP Provider"
  description="Guide d'intégration opérationnelle : enregistrement DG GROW EU DPP Registry et cachets électroniques eIDAS 2.0 QSeal."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Registre Central DG GROW</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Registre Central EU DPP & <br class="hidden sm:inline" />
        <span class="text-cyan-600">Cachets eIDAS 2.0</span>
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Connexion au registre central de la Commission européenne opérationnel depuis le 20 juillet 2026.
      </p>
    </div>
  </div>
</Layout>
