---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="90+ Données Obligatoires Passeport Batterie UE | EU DPP Provider"
  description="Spécification des 7 domaines et 90+ attributs obligatoires sous le règlement (UE) 2023/1542 Annexe XIII."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Règlement (UE) 2023/1542 · Annexe XIII</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        90+ Attributs Obligatoires du Passeport Batterie
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Gouvernance des 7 domaines de conformité et des niveaux d'accès pour les fabricants.
      </p>
    </div>
  </div>
</Layout>
