---
import Layout from '../../../layouts/Layout.astro';
import ComplianceCountdown from '../../../components/ComplianceCountdown.astro';
---

<Layout
  title="Guide Règlement Batterie de l'UE (UE 2023/1542) | EU DPP Provider"
  description="Analyse du règlement (UE) 2023/1542 : exigences du passeport batterie (art. 77-78), champs de l'annexe XIII et application au 18 février 2027."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Guide Réglementaire</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Règlement Batterie de l'UE <br class="hidden sm:inline" />
        <span class="text-cyan-600">(UE 2023/1542)</span>
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Échéances obligatoires et déclarations d'empreinte carbone pour fabricants de batteries.
      </p>
    </div>
    <ComplianceCountdown />
  </div>
</Layout>
