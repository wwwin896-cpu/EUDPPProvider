---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Guide Normes EN 18220:2026 & EN 18219:2026 | EU DPP Provider"
  description="Normes harmonisées européennes sous la décision (UE) 2026/1736 : EN 18220 (Codes 2D) et EN 18219 (Identifiants UPI)."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Décision (UE) 2026/1736 · CEN/CENELEC</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Normes Harmonisées : <br class="hidden sm:inline" />
        <span class="text-cyan-600">EN 18220 & EN 18219</span>
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Spécifications de gravure laser industrielle et syntaxe des identifiants uniques de produits.
      </p>
    </div>
  </div>
</Layout>
