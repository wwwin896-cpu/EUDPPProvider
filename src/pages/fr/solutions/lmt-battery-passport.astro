---
import Layout from '../../../layouts/Layout.astro';
import BatteryPassportViewer from '../../../components/BatteryPassportViewer.astro';
---

<Layout
  title="Passeport Batterie LMT & Vélos Électriques (≤25kg) | EU DPP Provider"
  description="Conformité pour moyens de transport légers (LMT ≤25kg) et deux-roues électriques."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Transport Léger LMT</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Passeport Batterie LMT (≤25 kg)
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Sérialisation QR laser haute densité pour blocs batteries de micromobilité et vélos électriques.
      </p>
    </div>
    <BatteryPassportViewer />
  </div>
</Layout>
