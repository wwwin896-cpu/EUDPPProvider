---
import Layout from '../../../layouts/Layout.astro';
---

<Layout
  title="Suite Logicielle DPP Entreprise (On-Premise) | EU DPP Provider"
  description="Déploiement privé du logiciel de passeport batterie UE : code et données maîtrisés, connecteurs MES, ERP, PLM et BMS, sans facturation au scan."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Cloud Privé & Sur Site</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Suite Logicielle DPP Entreprise
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Souveraineté totale sur le code et les données avec connecteurs MES/ERP natifs.
      </p>
    </div>
  </div>
</Layout>
