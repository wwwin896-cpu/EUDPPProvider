---
import Layout from '../../../layouts/Layout.astro';
import BatteryPassportViewer from '../../../components/BatteryPassportViewer.astro';
---

<Layout
  title="Passeport Batteries Industrielles & Stockage (>2kWh) | EU DPP Provider"
  description="Passeport numérique pour batteries stationnaires (BESS >2 kWh) et batteries industrielles : conformité (UE) 2023/1542 et données de durée de vie."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Stockage Stationnaire BESS</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Passeport Batterie Industrielle (&gt;2 kWh)
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Hiérarchie modulaire cellule-rack-conteneur et suivi télémétrique SOH pour stockage stationnaire.
      </p>
    </div>
    <BatteryPassportViewer />
  </div>
</Layout>
