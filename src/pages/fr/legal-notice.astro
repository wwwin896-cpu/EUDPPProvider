---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Mentions Légales (Impressum) | EU DPP Provider"
  description="Mentions légales obligatoires conformément à l'article 5 de la directive 2000/31/CE et au droit européen pour EU DPP Provider."
>
  <div class="py-16 sm:py-24 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="eyebrow-pill mb-3 mx-auto">Mentions Obligatoires</div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Mentions Légales <br class="hidden sm:inline" />
        <span class="text-cyan-600">(Impressum)</span>
      </h1>
      <p class="mt-4 text-base text-slate-600 leading-relaxed">
        Identification de l'éditeur et de l'hébergeur conformément à la directive 2000/31/CE.
      </p>
    </div>

    <div class="neo-surface p-8 sm:p-10 space-y-6 text-sm text-slate-700">
      <div>
        <h3 class="font-bold text-slate-900 text-base mb-1">Éditeur du Service</h3>
        <p class="text-slate-600">EU DPP Provider / Nanjing Ningyi Cultural Media Co., Ltd.</p>
        <p class="text-slate-500 text-xs mt-0.5">Identifiant d'enregistrement (USCI) : 913201025685882797</p>
        <p class="text-slate-500 text-xs">Représentant légal : Zhu Min</p>
      </div>

      <div class="pt-4 border-t border-slate-200">
        <h3 class="font-bold text-slate-900 text-base mb-1">Contact & Hébergement</h3>
        <p class="text-slate-600">Desk Commercial & Conformité : <a href="mailto:info@eudppprovider.com" class="text-cyan-600 font-mono font-bold">info@eudppprovider.com</a></p>
        <p class="text-slate-500 text-xs mt-0.5">Centres de données souverains : Francfort-sur-le-Main & Munich (Allemagne)</p>
      </div>
    </div>
  </div>
</Layout>
