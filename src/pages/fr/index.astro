---
import Layout from '../../layouts/Layout.astro';
import ComplianceCountdown from '../../components/ComplianceCountdown.astro';
import LiveWorkflowVideoDemo from '../../components/LiveWorkflowVideoDemo.astro';
import BatteryPassportViewer from '../../components/BatteryPassportViewer.astro';
import CrossIndustryDPP from '../../components/CrossIndustryDPP.astro';
import PricingCalculator from '../../components/PricingCalculator.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title="EU DPP Provider | Passeport Batterie UE & Coffre-fort"
  description="Transformez vos données de chaîne d'approvisionnement en chaîne de conformité auditable sous le règlement (UE) 2023/1542. Logiciel d'entreprise, coffre-fort souverain de 10 ans et support d'enregistrement."
>

  <!-- ==================== HERO SECTION ==================== -->
  <section class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Top Pill Badge -->
    <div class="eyebrow-pill mb-6 mx-auto">
      <span class="w-2 h-2 rounded-full bg-cyan-600 animate-pulse"></span>
      <span>Règlement (UE) 2023/1542 · Prêt pour le Passeport Batterie</span>
    </div>

    <!-- Punchy Marketing Headline -->
    <h1 class="text-4xl sm:text-5xl lg:text-[58px] font-extrabold tracking-tight leading-[1.12] text-slate-900 max-w-4xl mx-auto">
      Plateforme Passeport Batterie UE <br class="hidden sm:inline" />
      <span class="text-cyan-600">& Coffre-Fort de Données Souverain</span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
      Les codes QR ne sont que le point d'accès — ce qui passe les douanes, c'est la chaîne de données vérifiable. Nous intégrons les données MES et BMS dans un dossier numérique infalsifiable.
    </p>

    <!-- Tactile CTA Row -->
    <div class="mt-8 flex flex-wrap justify-center gap-4 items-center">
      <a
        href="/fr/contact/"
        class="neo-btn-primary inline-flex items-center gap-2"
      >
        <span>Demander une consultation technique →</span>
      </a>

      <a
        href="mailto:info@eudppprovider.com"
        class="neo-pill px-6 py-3 rounded-full text-xs sm:text-sm font-bold text-slate-800 hover:text-cyan-700 flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>info@eudppprovider.com</span>
      </a>
    </div>

    <!-- Soft UI Countdown Capsule -->
    <div class="mt-14">
      <ComplianceCountdown />
    </div>

  </section>

  <!-- ==================== DÉMONSTRATION EN DIRECT DU WORKFLOW ==================== -->
  <LiveWorkflowVideoDemo />

  <!-- ==================== BANNER SECTION 1: INDUSTRIAL FACTORY VERIFICATION ==================== -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/60 min-h-[460px] flex items-center">
      
      <!-- Background Image -->
      <img 
        src="/images/banner_factory_scan.webp" 
        alt="Marquage laser et vérification par scan de bloc batterie industriel" 
        class="absolute inset-0 w-full h-full object-cover object-center"
        loading="lazy"
        decoding="async"
      />

      <!-- Dark Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-navy-900/95 via-navy-900/80 to-navy-900/30 backdrop-blur-[2px]"></div>

      <!-- Foreground Text -->
      <div class="relative z-10 p-8 sm:p-12 lg:p-16 max-w-2xl text-white">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 mb-5">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span>Traçabilité industrielle en action</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-[1.15] text-white">
          De la gravure laser en usine au <br />
          <span class="text-cyan-400">dédouanement européen</span>
        </h2>

        <p class="mt-4 text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
          Codes 2D GS1 Digital Link permanents gravés au laser directement sur les boîtiers de batterie. Résolution instantanée par les douanes, laboratoires et recycleurs certifiés dans le monde entier.
        </p>

        <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 border-t border-white/15 text-xs">
          <div>
            <div class="font-mono text-cyan-400 font-bold text-base sm:text-lg">&lt;50ms</div>
            <div class="text-slate-400 mt-0.5">Résolution DNS mondiale</div>
          </div>
          <div>
            <div class="font-mono text-green-400 font-bold text-base sm:text-lg">eIDAS 2.0</div>
            <div class="text-slate-400 mt-0.5">Cachet PAdES Baseline</div>
          </div>
          <div class="hidden sm:block">
            <div class="font-mono text-cyan-400 font-bold text-base sm:text-lg">EN 18220</div>
            <div class="text-slate-400 mt-0.5">Norme harmonisée 2026</div>
          </div>
        </div>

        <div class="mt-8">
          <a href="/fr/platform/gs1-qr-serialization/" class="btn-primary-cyan inline-flex items-center gap-2 text-xs sm:text-sm font-bold">
            <span>Découvrir la sérialisation en usine →</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== 3 CORE PILLARS ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="eyebrow-pill mb-2">Architecture à 3 Couches</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        Résolution des 3 Défis Majeurs
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      
      <!-- Pillar 1 -->
      <div class="neo-surface p-8 flex flex-col justify-between group hover:scale-[1.01] transition-transform">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-cyan-100 text-cyan-700 flex items-center justify-center font-mono font-bold text-lg mb-6">
            01
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight mb-3">
            Protection des Secrets Industriels (ZKP)
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Empêchez la divulgation des formulations chimiques et des prix d'achat. Les Zero-Knowledge Proofs (ZKP) permettent de valider la conformité sans transférer de données brutes.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/fr/about/" class="text-xs font-bold text-cyan-700 hover:text-cyan-800 flex items-center gap-1">
            <span>Voir l'architecture</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Pillar 2 -->
      <div class="neo-surface p-8 flex flex-col justify-between group hover:scale-[1.01] transition-transform">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-green-100 text-green-700 flex items-center justify-center font-mono font-bold text-lg mb-6">
            02
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight mb-3">
            Hébergement Souverain 10 Ans
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Respectez l'obligation de conservation de 10 ans de l'article 11 de l'ESPR. Notre coffre-fort certifié ISO 27001 à Francfort garantit 99,9% de disponibilité SLA.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/fr/solutions/managed-data-hosting/" class="text-xs font-bold text-green-700 hover:text-green-800 flex items-center gap-1">
            <span>Explorer le coffre-fort</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Pillar 3 -->
      <div class="neo-surface p-8 flex flex-col justify-between group hover:scale-[1.01] transition-transform">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-navy-100 text-navy-800 flex items-center justify-center font-mono font-bold text-lg mb-6">
            03
          </div>
          <h3 class="text-xl font-bold text-slate-900 tracking-tight mb-3">
            Connexion au Registre DG GROW
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
            Transmission automatisée des identifiants uniques (UPI) au registre central de l'UE avec sceaux électroniques eIDAS 2.0.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/fr/compliance/eu-dpp-registry-guide/" class="text-xs font-bold text-slate-800 hover:text-cyan-700 flex items-center gap-1">
            <span>Consulter le guide</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== BANNER SECTION 2: SOVEREIGN CLOUD CONTROL ==================== -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/60 min-h-[460px] flex items-center">
      
      <!-- Background Image -->
      <img 
        src="/images/banner_sovereign_vault.webp" 
        alt="Centre de données européen et salle de contrôle de conformité DPP à Francfort" 
        class="absolute inset-0 w-full h-full object-cover object-center"
        loading="lazy"
        decoding="async"
      />

      <!-- Dark Gradient Overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-navy-950/95 via-navy-950/80 to-navy-900/35 backdrop-blur-[2px]"></div>

      <!-- Foreground Content -->
      <div class="relative z-10 p-8 sm:p-12 lg:p-16 max-w-2xl text-white">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-green-500/20 text-green-300 border border-green-400/30 mb-5">
          <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
          <span>Centre de Données Souverain Francfort</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-[1.15] text-white">
          Coffre-Fort Souverain & <br />
          <span class="text-green-400">Centre d'Opérations Réglementaires</span>
        </h2>

        <p class="mt-4 text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
          Infrastructures Tier-IV à Francfort-sur-le-Main et Munich. Disponibilité SLA garantie à 99,9%, mises à jour automatiques des schémas et souveraineté stricte sous le RGPD.
        </p>

        <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 border-t border-white/15 text-xs">
          <div>
            <div class="font-mono text-green-400 font-bold text-base sm:text-lg">ISO 27001</div>
            <div class="text-slate-400 mt-0.5">Centres certifiés</div>
          </div>
          <div>
            <div class="font-mono text-cyan-400 font-bold text-base sm:text-lg">99,9% SLA</div>
            <div class="text-slate-400 mt-0.5">Disponibilité garantie</div>
          </div>
          <div class="hidden sm:block">
            <div class="font-mono text-green-400 font-bold text-base sm:text-lg">10 Ans</div>
            <div class="text-slate-400 mt-0.5">Archivage ESPR Art. 11</div>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-4 items-center">
          <a href="/fr/solutions/managed-data-hosting/" class="btn-primary-cyan inline-flex items-center gap-2 text-xs sm:text-sm font-bold">
            <span>Détails du coffre-fort →</span>
          </a>
          <a href="mailto:info@eudppprovider.com" class="px-5 py-3 rounded-full text-xs font-bold text-white/90 hover:text-white bg-white/10 hover:bg-white/20 border border-white/20 transition-all">
            Contact : info@eudppprovider.com
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== INTERACTIVE PASSPORT VIEWER ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="eyebrow-pill mb-2">Démonstration Interactive</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        Visualiseur de Passeport 4 Rôles
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-2">
        Testez comment les consommateurs, douanes, recycleurs et OEM accèdent à des niveaux de données différenciés.
      </p>
    </div>

    <BatteryPassportViewer />
  </section>

  <!-- ==================== ARCHITECTURE MULTI-CATÉGORIES ESPR ==================== -->
  <CrossIndustryDPP />

  <!-- ==================== PRICING CALCULATOR SECTION ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="eyebrow-pill mb-2">Modèles Tarifaires Transparents</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        Modèles de Déploiement & Simulateur de Coûts
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-2">
        Choisissez entre licence logicielle sur cloud privé et hébergement souverain clé en main.
      </p>
    </div>

    <PricingCalculator />
  </section>

</Layout>
