---
import Layout from '../../layouts/Layout.astro';
import ComplianceCountdown from '../../components/ComplianceCountdown.astro';
import BatteryPassportViewer from '../../components/BatteryPassportViewer.astro';
import PricingCalculator from '../../components/PricingCalculator.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title="EU DPP Provider | Logiciel Passeport Batterie UE & Hébergement Sécurisé"
  description="Plateforme de conformité clé en main pour le passeport batterie UE (Règlement UE 2023/1542). Logiciel d'entreprise ou hébergement sécurisé avec protection Zero-Knowledge."
>
  <section class="relative pt-16 pb-20 overflow-hidden bg-radial-gradient">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <div class="text-center max-w-4xl mx-auto space-y-6">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-300 border border-brand-500/20 shadow-inner">
          <span class="w-2 h-2 rounded-full bg-accent-emerald animate-pulse"></span>
          <span>{t('hero.badge')}</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-[1.15]">
          {t('hero.title.prefix')} <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 via-accent-cyan to-accent-emerald text-glow">
            {t('hero.title.highlight')}
          </span> <br />
          {t('hero.title.suffix')}
        </h1>

        <p class="text-lg sm:text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed">
          {t('hero.subtitle')}
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
          <a
            href="/fr/contact"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-brand-500 via-accent-teal to-accent-emerald text-white font-bold text-base shadow-xl shadow-brand-500/25 hover:opacity-95 hover:scale-[1.02] transition-all"
          >
            {t('hero.cta.primary')} &rarr;
          </a>
          <a
            href="/fr/pricing"
            class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-900/90 border border-slate-700/80 hover:bg-slate-800 text-slate-200 font-semibold text-base transition-colors"
          >
            {t('hero.cta.secondary')}
          </a>
        </div>

      </div>

    </div>
  </section>

  <section class="py-12 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ComplianceCountdown />
    </div>
  </section>

  <section class="py-20 bg-slate-900/40 border-y border-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          {t('viewer.title')}
        </h2>
        <p class="text-base text-slate-400 mt-3">
          {t('viewer.subtitle')}
        </p>
      </div>
      <BatteryPassportViewer />
    </div>
  </section>

  <section class="py-20 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PricingCalculator />
    </div>
  </section>
</Layout>
