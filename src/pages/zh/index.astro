---
import Layout from '../../layouts/Layout.astro';
import ComplianceCountdown from '../../components/ComplianceCountdown.astro';
import BatteryPassportViewer from '../../components/BatteryPassportViewer.astro';
import PricingCalculator from '../../components/PricingCalculator.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title="EU DPP Provider | 欧盟电池护照 (EU Battery Passport) 企业合规与数据托管服务商"
  description="面向中国出海动力电池、储能系统及上游材料企业的欧盟电池护照（EU 2023/1542法规）一站式数字化合规系统。支持企业软件采购部署与数据安全托管。"
>

  <!-- ==================== HERO SECTION (Sovereign Navy 渐变) ==================== -->
  <section class="hero-gradient text-white pt-24 pb-20 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-4xl">
        <!-- Top Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase text-cyan-200 bg-white/[0.06] border border-white/[0.14] mb-6">
          <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
          <span>欧盟新电池法 EU 2023/1542 · 电池护照权威合规平台</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-6xl lg:text-[58px] font-extrabold tracking-tight leading-[1.12] text-white">
          面向全球供应链的 <br class="hidden sm:inline" />
          <em class="not-italic text-cyan-500">欧盟电池护照</em> 数字化合规系统
        </h1>

        <!-- Lead -->
        <p class="mt-6 text-lg sm:text-[19px] leading-relaxed text-white/75 max-w-2xl font-normal">
          专为出海欧洲的动力电池、储能系统（>2kWh）及上游核心材料供应商打造。提供「企业独立软件采购」与「欧盟主权数据托管代维」双轨服务，依托零知识证明（ZKP）保护核心配方商业机密。
        </p>

        <!-- CTA Row -->
        <div class="mt-8 flex flex-wrap gap-4 items-center">
          <a
            href={`/${lang === 'en' ? '' : lang + '/'}contact`}
            class="btn-primary-cyan inline-flex items-center gap-2 shadow-lg"
          >
            <span>预约专家技术演示</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          
          <a
            href={`/${lang === 'en' ? '' : lang + '/'}pricing`}
            class="btn-ghost-hero inline-flex items-center gap-2"
          >
            <span>对比软件采购 vs 数据托管</span>
          </a>
        </div>
      </div>

      <!-- 4-Column Metrics Bar -->
      <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-0 border border-white/[0.12] rounded-2xl overflow-hidden bg-white/[0.03] backdrop-blur-sm">
        <div class="p-5 sm:p-6 border-b sm:border-b-0 border-r border-white/[0.1]">
          <div class="font-mono text-xs uppercase tracking-wider text-cyan-500 font-semibold">法规合规标准</div>
          <div class="text-base sm:text-lg font-semibold text-white mt-1.5">EU 2023/1542 · 第77条</div>
        </div>
        <div class="p-5 sm:p-6 border-b sm:border-b-0 md:border-r border-white/[0.1]">
          <div class="font-mono text-xs uppercase tracking-wider text-cyan-500 font-semibold">产线赋码规范</div>
          <div class="text-base sm:text-lg font-semibold text-white mt-1.5">GS1 Digital Link 2D</div>
        </div>
        <div class="p-5 sm:p-6 border-r border-white/[0.1]">
          <div class="font-mono text-xs uppercase tracking-wider text-cyan-500 font-semibold">配方商业保密</div>
          <div class="text-base sm:text-lg font-semibold text-white mt-1.5">零知识证明 (ZKP)</div>
        </div>
        <div class="p-5 sm:p-6">
          <div class="font-mono text-xs uppercase tracking-wider text-cyan-500 font-semibold">欧洲数据主权</div>
          <div class="text-base sm:text-lg font-semibold text-white mt-1.5">Catena-X 协议互通</div>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== 交互式护照预览 ==================== -->
  <section class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <div class="eyebrow mb-2">01 · 真实交互体验</div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900">
          体验四级角色分权电池护照系统
        </h2>
        <p class="mt-4 text-base text-slate-500 leading-relaxed">
          欧盟新电池法强制要求对公众、海关监管、拆解回收商及主机厂实行差异化数据授权。点击下方切换按钮体验权限隔离解析。
        </p>
      </div>

      <div class="max-w-5xl mx-auto">
        <BatteryPassportViewer />
      </div>

    </div>
  </section>

  <!-- ==================== 法规倒计时 ==================== -->
  <section class="py-20 bg-navy-900 border-b border-navy-800 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ComplianceCountdown />
    </div>
  </section>

  <!-- ==================== 双轨交付模式 ==================== -->
  <section class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <div class="eyebrow mb-2">02 · 商业合作模式</div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900">
          两种交付方案：软件采购 或 数据安全托管
        </h2>
        <p class="mt-4 text-base text-slate-500 leading-relaxed">
          无论您需要企业私有化部署完全掌控代码，还是需要由我们托管代维欧洲合规节点，均可无缝适配。
        </p>
      </div>

      <PricingCalculator />

    </div>
  </section>

  <!-- ==================== 核心能力 ==================== -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="eyebrow mb-2">03 · 核心技术引擎</div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900">
          为工业级大批量合规而生的技术底座
        </h2>
        <p class="mt-4 text-base text-slate-500 leading-relaxed">
          从摇篮到大门的碳足迹模型、上游供应链隐私加密协同，到产线毫秒级激光二维码赋码。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <div class="feature-card p-6">
          <div class="w-10 h-10 rounded-xl bg-navy-800 text-cyan-500 flex items-center justify-center font-bold text-lg mb-5">
            ⚡
          </div>
          <h4 class="text-lg font-semibold text-slate-900 mb-2">PCF 电池碳足迹引擎</h4>
          <p class="text-sm text-slate-500 leading-relaxed">
            严格按照欧盟 PEFCR 方法学与 ISO 14040/44 标准，自动化建立电芯与电池包 LCA 碳足迹模型。
          </p>
        </div>

        <div class="feature-card p-6">
          <div class="w-10 h-10 rounded-xl bg-navy-800 text-green-500 flex items-center justify-center font-bold text-lg mb-5">
            🔒
          </div>
          <h4 class="text-lg font-semibold text-slate-900 mb-2">零知识证明隐私保护</h4>
          <p class="text-sm text-slate-500 leading-relaxed">
            上游材料厂商可在不向车企暴露专有化学配方与采购成本的前提下，向欧盟监管机构完成数据证明。
          </p>
        </div>

        <div class="feature-card p-6">
          <div class="w-10 h-10 rounded-xl bg-navy-800 text-cyan-500 flex items-center justify-center font-bold text-lg mb-5">
            🏷️
          </div>
          <h4 class="text-lg font-semibold text-slate-900 mb-2">GS1 Digital Link 赋码</h4>
          <p class="text-sm text-slate-500 leading-relaxed">
            支持与产线 MES/激光打码机无缝对接，生成唯一 GS1 二维码，毫秒级全球分布式解析。
          </p>
        </div>

        <div class="feature-card p-6">
          <div class="w-10 h-10 rounded-xl bg-navy-800 text-amber-500 flex items-center justify-center font-bold text-lg mb-5">
            🌐
          </div>
          <h4 class="text-lg font-semibold text-slate-900 mb-2">Catena-X 协议互通</h4>
          <p class="text-sm text-slate-500 leading-relaxed">
            原生兼容欧洲汽车数据空间、Battery Pass Consortium 行业标准及 Cirpass 数字护照节点。
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ==================== 底部 CTA ==================== -->
  <section class="py-20 hero-gradient text-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-white/10 text-cyan-300 border border-white/20 mb-6">
        2027 年强制合规倒计时中
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
        在数周内完成您的欧盟电池护照部署
      </h2>
      <p class="mt-5 text-lg text-white/75 max-w-2xl mx-auto">
        联系我们的资深合规工程师，评估企业电池数据就绪度，获取定制化系统演示或数据托管方案。
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={`/${lang === 'en' ? '' : lang + '/'}contact`} class="btn-primary-cyan">
          立即预约技术咨询 →
        </a>
        <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-battery-regulation-2023-1542`} class="btn-ghost-hero">
          查看 EU 2023/1542 合规指南
        </a>
      </div>
    </div>
  </section>

</Layout>
