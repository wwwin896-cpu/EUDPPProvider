---
import Layout from '../../layouts/Layout.astro';
import ComplianceCountdown from '../../components/ComplianceCountdown.astro';
import LiveWorkflowVideoDemo from '../../components/LiveWorkflowVideoDemo.astro';
import BatteryPassportViewer from '../../components/BatteryPassportViewer.astro';
import CrossIndustryDPP from '../../components/CrossIndustryDPP.astro';
import PricingCalculator from '../../components/PricingCalculator.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title="EU DPP Provider | 欧盟新电池法数字产品护照 (DPP) 企业合规与数据主权托管平台"
  description="把电池护照做成一条能过审的数据链。企业软件私有化部署与十年代维主权数据托管，支持欧盟70+与国内96项双重合规，原始数据不出境，零知识证明保护配方机密。"
>

  <!-- ==================== HERO SECTION (新拟物主义营销主视觉) ==================== -->
  <section class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="eyebrow-pill mb-6 mx-auto">
      <span class="w-2 h-2 rounded-full bg-cyan-600 animate-pulse"></span>
      <span>欧盟新电池法 EU 2023/1542 · 电池护照权威合规平台</span>
    </div>

    <h1 class="text-3xl sm:text-5xl lg:text-[58px] font-extrabold tracking-tight leading-[1.14] text-slate-900 max-w-4xl mx-auto">
      欧盟新电池法数字产品护照 <br class="hidden sm:inline" />
      <span class="text-cyan-600">企业合规与主权数据托管平台</span>
    </h1>

    <p class="mt-6 text-base sm:text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
      二维码只是入口，能过审的，是它背后那条链。提供企业独立软件私有化部署与十年代维主权数据托管，同时支持欧盟 70+ 项与国内 96 项对齐，原始数据不出境，零知识证明保护核心配方机密。
    </p>

    <!-- 触感操作按钮 -->
    <div class="mt-8 flex flex-wrap justify-center gap-4 items-center">
      <a
        href={`/${lang === 'en' ? '' : lang + '/'}contact`}
        class="neo-btn-primary inline-flex items-center gap-2"
      >
        <span>申请合规方案评估 →</span>
      </a>

      <a
        href="mailto:info@eudppprovider.com"
        class="neo-pill px-6 py-3 rounded-full text-xs sm:text-sm font-bold text-slate-800 hover:text-cyan-700 flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>官方邮箱：info@eudppprovider.com</span>
      </a>
    </div>

    <!-- 倒计时胶囊 -->
    <div class="mt-14">
      <ComplianceCountdown />
    </div>

  </section>

  <!-- ==================== 解决方案实时动态演示 ==================== -->
  <LiveWorkflowVideoDemo />

  <!-- ==================== BANNER SECTION 1: 制造产线与海关查验实景 ==================== -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/60 min-h-[460px] flex items-center">
      
      <!-- 背景大图 -->
      <img 
        src="/images/banner_factory_scan.webp" 
        alt="工业电池包激光打码与现场扫码核验" 
        class="absolute inset-0 w-full h-full object-cover object-center"
      />

      <!-- 渐变遮罩保护文字对比度 -->
      <div class="absolute inset-0 bg-gradient-to-r from-navy-900/95 via-navy-900/80 to-navy-900/30 backdrop-blur-[2px]"></div>

      <!-- 前景文字 -->
      <div class="relative z-10 p-8 sm:p-12 lg:p-16 max-w-2xl text-white">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-cyan-500/20 text-cyan-300 border border-cyan-400/30 mb-5">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span>工业级全流程数字化溯源</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-[1.18] text-white">
          从制造基地激光打码到 <br />
          <span class="text-cyan-400">欧洲海关单一窗口秒级放行</span>
        </h2>

        <p class="mt-4 text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
          在电池外壳激光蚀刻永久性 GS1 Digital Link 二维码。欧洲海关、公告检测机构与持牌拆解回收商全球即时扫码核验，不可篡改。
        </p>

        <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 border-t border-white/15 text-xs">
          <div>
            <div class="font-mono text-cyan-400 font-bold text-base sm:text-lg">&lt; 50ms</div>
            <div class="text-slate-400 mt-0.5">全球分布式解析时延</div>
          </div>
          <div>
            <div class="font-mono text-green-400 font-bold text-base sm:text-lg">eIDAS 2.0</div>
            <div class="text-slate-400 mt-0.5">PAdES 合规电子印章</div>
          </div>
          <div class="hidden sm:block">
            <div class="font-mono text-cyan-400 font-bold text-base sm:text-lg">ISO/IEC 15459</div>
            <div class="text-slate-400 mt-0.5">全球唯一身份条码标准</div>
          </div>
        </div>

        <div class="mt-8">
          <a href="/zh/platform/gs1-qr-serialization" class="btn-primary-cyan inline-flex items-center gap-2 text-xs sm:text-sm font-bold">
            <span>了解产线赋码解析方案 →</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== 三大业务能力 ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="eyebrow-pill mb-2">三大业务板块</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        覆盖从数据归集到 <span class="inline-block">海关放行的全链路</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-cyan-100 text-cyan-700 flex items-center justify-center font-bold text-xl mb-4">
            💻
          </div>
          <h3 class="text-lg lg:text-xl font-bold text-slate-900 mb-2">企业私有化软件系统</h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            私有化部署完全掌控代码与数据主权。零单包扫码计费惩罚，预置 MES、ERP、PLM、BMS 只读连接器。
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/zh/solutions/software-license" class="text-xs sm:text-sm font-bold text-cyan-600 hover:text-cyan-700">了解软件采购 →</a>
        </div>
      </div>

      <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between border-green-500/20">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-green-100 text-green-700 flex items-center justify-center font-bold text-xl mb-4">
            🛡️
          </div>
          <h3 class="text-lg lg:text-xl font-bold text-slate-900 mb-2">十年代维数据主权托管</h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            委托托管至欧洲最高等级 ISO 27001 数据中心。承诺 99.9% 平台可用性，法规变更 30 天内自动适配，ZKP 零泄露。
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/zh/solutions/managed-data-hosting" class="text-xs sm:text-sm font-bold text-green-700 hover:text-green-800">了解托管方案 →</a>
        </div>
      </div>

      <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-xl mb-4">
            🏛️
          </div>
          <h3 class="text-lg lg:text-xl font-bold text-slate-900 mb-2">eIDAS 电子印章与注册代办</h3>
          <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
            全套代办 EU Login、QSeal/QES 合规电子印章、DigiCert QTSP 机构认证与欧盟委员会 DPP 注册簿官方登记回执。
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-slate-200/80">
          <a href="/zh/compliance/eu-dpp-registry-guide" class="text-xs sm:text-sm font-bold text-amber-700 hover:text-amber-800">查看注册指南 →</a>
        </div>
      </div>

    </div>

  </section>

  <!-- ==================== 交互式护照 ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="eyebrow-pill mb-2">真实交互体验</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        四级角色分权电池护照仿真
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-2">
        欧盟法规强制要求公众、海关、拆解回收商与车企看到差异化授权数据。点击下方按钮体验权限切换。
      </p>
    </div>

    <BatteryPassportViewer />
  </section>

  <!-- ==================== ESPR 多品类护照扩展架构 ==================== -->
  <CrossIndustryDPP />

  <!-- ==================== BANNER SECTION 2: 欧洲主权云机房运维中心 ==================== -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-white/60 min-h-[460px] flex items-center">
      
      <!-- 背景大图 -->
      <img 
        src="/images/banner_sovereign_vault.webp" 
        alt="欧洲主权云法兰克福数据中心与合规控制中心" 
        class="absolute inset-0 w-full h-full object-cover object-center"
      />

      <!-- 渐变遮罩 -->
      <div class="absolute inset-0 bg-gradient-to-r from-navy-950/95 via-navy-900/80 to-navy-900/40 backdrop-blur-[2px]"></div>

      <!-- 前景文字 -->
      <div class="relative z-10 p-8 sm:p-12 lg:p-16 max-w-2xl text-white">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono font-semibold uppercase tracking-wider bg-green-500/20 text-green-300 border border-green-400/30 mb-5">
          <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
          <span>德国法兰克福 & 慕尼黑节点 · ISO 27001</span>
        </div>

        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight leading-[1.18] text-white">
          欧洲主权数据托管中心 & <br />
          <span class="text-green-400">7x24 全球合规运维保障</span>
        </h2>

        <p class="mt-4 text-sm sm:text-base text-slate-300 leading-relaxed font-normal">
          将您的电池护照托管于欧洲最高安全等级的 ISO 27001 认证机房。严格符合 GDPR 与欧盟数据法案，零知识证明 (ZKP) 严守配方机密，写入 10 年长期存续 SLA。
        </p>

        <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-4 pt-4 border-t border-white/15 text-xs">
          <div>
            <div class="font-mono text-green-400 font-bold text-base sm:text-lg">99.9%</div>
            <div class="text-slate-400 mt-0.5">平台高可用 SLA 保障</div>
          </div>
          <div>
            <div class="font-mono text-cyan-400 font-bold text-base sm:text-lg">30 个工作日</div>
            <div class="text-slate-400 mt-0.5">欧盟新法免费模型补丁</div>
          </div>
          <div class="hidden sm:block">
            <div class="font-mono text-green-400 font-bold text-base sm:text-lg">10 年周期</div>
            <div class="text-slate-400 mt-0.5">电池全生命周期代维</div>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-4 items-center">
          <a href="/zh/solutions/managed-data-hosting" class="btn-primary-cyan inline-flex items-center gap-2 text-xs sm:text-sm font-bold">
            <span>了解主权数据托管方案 →</span>
          </a>
          <a href="mailto:info@eudppprovider.com" class="btn-ghost-hero inline-flex items-center gap-2 text-xs sm:text-sm">
            <span>info@eudppprovider.com</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== 分阶段交付体系 ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="eyebrow-pill mb-2">标准实施体系</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        分阶段合规交付路径
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-2">
        从现场数据差距盘点到拿到欧盟中央注册簿回执，阶段成果逐项验收，把合规确定性握在手里。
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-5 gap-3.5">
      <div class="neo-surface p-4 text-center">
        <div class="text-[11px] font-mono font-bold text-cyan-600">阶段一</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900 mt-1">字段盘点</div>
        <div class="text-[10px] sm:text-xs text-slate-500 mt-0.5">确定字段责任人</div>
      </div>
      <div class="neo-surface p-4 text-center">
        <div class="text-[11px] font-mono font-bold text-cyan-600">阶段二</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900 mt-1">数据建模</div>
        <div class="text-[10px] sm:text-xs text-slate-500 mt-0.5">七大数据域映射</div>
      </div>
      <div class="neo-surface p-4 text-center">
        <div class="text-[11px] font-mono font-bold text-cyan-600">阶段三</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900 mt-1">系统接入</div>
        <div class="text-[10px] sm:text-xs text-slate-500 mt-0.5">只读同步与告警</div>
      </div>
      <div class="neo-surface p-4 text-center">
        <div class="text-[11px] font-mono font-bold text-amber-600">阶段四</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900 mt-1">对账核验</div>
        <div class="text-[10px] sm:text-xs text-slate-500 mt-0.5">完整度 ≥95% 达标</div>
      </div>
      <div class="neo-surface p-4 text-center border-green-500/30">
        <div class="text-[11px] font-mono font-bold text-green-700">阶段五</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900 mt-1">发布与登记</div>
        <div class="text-[10px] sm:text-xs text-green-800 font-bold mt-0.5">交付官方回执</div>
      </div>
    </div>
  </section>

  <!-- ==================== 商业方案对比 ==================== -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="eyebrow-pill mb-2">合作交付模式</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        软件采购 或 数据安全托管
      </h2>
    </div>

    <PricingCalculator />
  </section>

  <!-- ==================== 底部 CTA ==================== -->
  <section class="py-16 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="neo-surface p-8 sm:p-12 text-center bg-gradient-to-br from-[#F0F4F8] to-cyan-50/40 border border-cyan-200/60">
      <div class="eyebrow-pill mb-3 mx-auto">立即开启技术对接</div>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        准备好启动您的电池护照合规评估了吗？
      </h2>
      <p class="mt-3 text-xs sm:text-sm text-slate-600 max-w-xl mx-auto">
        联系我们的电池合规工程师，评估企业数据就绪度并获取技术方案。
      </p>

      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="mailto:info@eudppprovider.com" class="neo-btn-primary">
          官方业务邮箱：info@eudppprovider.com
        </a>
        <a href="/zh/about" class="neo-pill px-6 py-3 rounded-full text-xs sm:text-sm font-bold text-slate-800 hover:text-cyan-700">
          了解我们的工程团队与背景 →
        </a>
      </div>
    </div>
  </section>

</Layout>
