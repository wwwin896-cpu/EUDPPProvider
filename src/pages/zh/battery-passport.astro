---
import Layout from '../../layouts/Layout.astro';
import BatteryPassportViewer from '../../components/BatteryPassportViewer.astro';
import ComplianceCountdown from '../../components/ComplianceCountdown.astro';

const faqs = [
  {
    question: "什么是欧盟新电池法 (EU 2023/1542) 规定的电池护照？",
    answer: "欧盟电池护照是针对所有进入欧盟市场的动力电池 (EV)、轻型交通电池 (LMT ≤25kg) 及 2kWh 以上工业储能电池的强制性电子合规档案，通过外壳永久激光蚀刻的 GS1 Digital Link 二维码进行全球解析，自 2027 年 2 月 18 日起强制生效。"
  },
  {
    question: "谁必须提供电池数字产品护照？",
    answer: "将电池或含电池的产品/车辆投放欧盟市场的经济运营商，包括欧盟本土制造商、国际电池电芯/电池包出口企业以及整车厂 (OEM)。"
  },
  {
    question: "平台如何保护企业的核心化学配方机密与供应链采购成本？",
    answer: "采用境内清洁区计算与零知识证明 (ZKP) 密码学防护。原始化学比例与采购成本在境内节点完成脱敏与计算，出境传输时仅发送法定的白名单合规断言指标。"
  },
  {
    question: "企业私有化软件与十年代维数据托管有什么区别？",
    answer: "企业私有化软件部署于企业自身的私有云或数据中心，享有代码主权与零单包扫码费；十年代维数据托管则托管至我们位于德国法兰克福的 ISO 27001 认证机房，享有 99.9% 平台高可用 SLA 与 30 天内法规自动升级补丁。"
  }
];
---

<Layout
  title="欧盟电池护照 (Battery Passport) 软件系统与主权托管平台 | EU DPP Provider"
  description="欧盟新电池法 EU 2023/1542 权威电池护照软件、PCF 碳足迹核算、GS1 二维码赋码与十年代维欧洲主权数据托管服务。"
  faqs={faqs}
>
  <section class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="eyebrow-pill mb-6 mx-auto">
      <span class="w-2 h-2 rounded-full bg-cyan-600 animate-pulse"></span>
      <span>欧盟新电池法 EU 2023/1542 · 电池护照权威企业服务平台</span>
    </div>

    <h1 class="text-3xl sm:text-5xl lg:text-[58px] font-extrabold tracking-tight leading-[1.14] text-slate-900 max-w-4xl mx-auto">
      欧盟新电池法数字产品护照 <br class="hidden sm:inline" />
      <span class="text-cyan-600">企业软件系统与主权托管平台</span>
    </h1>

    <p class="mt-6 text-base sm:text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
      打通工厂 MES 与 BMS 系统，将电池生产全流程数据转化为可被欧洲海关、检测机构与回收商即时验证的数字化合规链条。
    </p>

    <div class="mt-8 flex flex-wrap justify-center gap-4 items-center">
      <a href="mailto:info@eudppprovider.com" class="neo-btn-primary inline-flex items-center gap-2">
        <span>申请合规方案评估 →</span>
      </a>
      <a href="/zh/pricing" class="neo-pill px-6 py-3 rounded-full text-xs sm:text-sm font-bold text-slate-800 hover:text-cyan-700">
        <span>查看产品定价与方案</span>
      </a>
    </div>

    <div class="mt-14">
      <ComplianceCountdown />
    </div>
  </section>

  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="eyebrow-pill mb-2">真实交互体验</div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
        四级角色分权电池护照仿真
      </h2>
    </div>
    <BatteryPassportViewer />
  </section>

  <section class="py-16 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <div class="eyebrow-pill mb-2">常见问题解答</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
        欧盟电池护照核心疑问解答
      </h2>
    </div>

    <div class="space-y-4">
      {faqs.map(faq => (
        <div class="neo-surface p-6 sm:p-7">
          <h3 class="text-base sm:text-lg font-bold text-slate-900 mb-2">{faq.question}</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
