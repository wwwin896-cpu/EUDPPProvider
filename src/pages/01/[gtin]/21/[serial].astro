---
import Layout from '../../../../layouts/Layout.astro';

export function getStaticPaths() {
  return [
    { params: { gtin: '04012345999991', serial: 'BP-2027-EU-88902' } },
    { params: { gtin: '06978453010012', serial: 'EV-BAT-800V-95KWH' } },
    { params: { gtin: '06978453010029', serial: 'LMT-48V-750WH-001' } },
    { params: { gtin: '06978453010036', serial: 'BESS-1500V-372KWH' } },
  ];
}

const { gtin, serial } = Astro.params;
---

<Layout
  title={`Digital Product Passport | ${serial} (GTIN: ${gtin})`}
  description={`Official GS1 Digital Link EU Battery Passport resolution for serial ${serial}. Conforming to Regulation (EU) 2023/1542, Articles 77-78.`}
>
  <div class="py-12 sm:py-20 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Verification Badge Banner -->
    <div class="neo-surface p-6 sm:p-8 mb-8 border-l-4 border-green-500">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-green-500 animate-pulse"></span>
            <span class="text-xs font-mono font-bold uppercase text-green-700 tracking-wider">
              GS1 Digital Link · Verified Active Record
            </span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1 font-mono">
            {serial}
          </h1>
          <p class="text-xs text-slate-500 mt-0.5 font-mono">
            GTIN: {gtin} · Regulation (EU) 2023/1542 Compliant
          </p>
        </div>

        <div class="text-right">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-green-100 text-green-800 text-xs font-mono font-bold">
            <span>🛡️ eIDAS 2.0 QSeal Verified</span>
          </div>
          <div class="text-[11px] text-slate-500 mt-1 font-mono">
            DG GROW UPI: UPI-EU-2026-88902-BAT
          </div>
        </div>
      </div>
    </div>

    <!-- 4-Tier Passport Data Sections -->
    <div class="space-y-6">
      
      <!-- General & Manufacturer Identity -->
      <div class="neo-surface p-6 sm:p-8">
        <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
          <span class="w-6 h-6 rounded-lg bg-cyan-100 text-cyan-700 flex items-center justify-center text-xs font-bold">1</span>
          <span>Battery Identity & Manufacturer Information</span>
        </h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs sm:text-sm">
          <div class="p-3.5 bg-white/70 rounded-xl border border-slate-200">
            <div class="text-slate-400 font-mono text-xs">Battery Category</div>
            <div class="font-bold text-slate-900 mt-0.5">EV Traction Battery (Automotive)</div>
          </div>
          <div class="p-3.5 bg-white/70 rounded-xl border border-slate-200">
            <div class="text-slate-400 font-mono text-xs">Rated Capacity</div>
            <div class="font-bold text-slate-900 mt-0.5">94.8 kWh (800V Architecture)</div>
          </div>
          <div class="p-3.5 bg-white/70 rounded-xl border border-slate-200">
            <div class="text-slate-400 font-mono text-xs">Chemistry / Formulation</div>
            <div class="font-bold text-slate-900 mt-0.5">NMC 811 High-Nickel Ternary</div>
          </div>
          <div class="p-3.5 bg-white/70 rounded-xl border border-slate-200">
            <div class="text-slate-400 font-mono text-xs">Manufacturing Location</div>
            <div class="font-bold text-slate-900 mt-0.5">Clean Factory Node #02 (Jiangsu)</div>
          </div>
          <div class="p-3.5 bg-white/70 rounded-xl border border-slate-200">
            <div class="text-slate-400 font-mono text-xs">Production Date</div>
            <div class="font-bold text-slate-900 mt-0.5">15 October 2026</div>
          </div>
          <div class="p-3.5 bg-white/70 rounded-xl border border-slate-200">
            <div class="text-slate-400 font-mono text-xs">Warranty Period</div>
            <div class="font-bold text-slate-900 mt-0.5">8 Years / 160,000 km (SOH &gt; 75%)</div>
          </div>
        </div>
      </div>

      <!-- Carbon Footprint & Recycled Content -->
      <div class="neo-surface p-6 sm:p-8">
        <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
          <span class="w-6 h-6 rounded-lg bg-green-100 text-green-700 flex items-center justify-center text-xs font-bold">2</span>
          <span>Carbon Footprint (PCF) & Circularity Content</span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-4 rounded-xl bg-gradient-to-br from-white to-green-50/50 border border-green-200">
            <div class="text-xs text-slate-500 font-mono uppercase">Total Carbon Intensity</div>
            <div class="text-3xl font-extrabold text-green-800 mt-1 font-mono">51.2</div>
            <div class="text-xs text-green-700 mt-1">kg CO₂e / kWh (PEFCR Scope 1-3)</div>
            <div class="mt-2 inline-block px-2 py-0.5 rounded bg-green-200/80 text-green-900 text-[10px] font-bold">Class A Performance</div>
          </div>

          <div class="p-4 rounded-xl bg-gradient-to-br from-white to-cyan-50/50 border border-cyan-200">
            <div class="text-xs text-slate-500 font-mono uppercase">Recycled Cobalt Content</div>
            <div class="text-3xl font-extrabold text-cyan-800 mt-1 font-mono">18.4%</div>
            <div class="text-xs text-slate-600 mt-1">Mandatory threshold (2031): 16%</div>
            <div class="mt-2 inline-block px-2 py-0.5 rounded bg-cyan-200/80 text-cyan-900 text-[10px] font-bold">Compliant</div>
          </div>

          <div class="p-4 rounded-xl bg-gradient-to-br from-white to-blue-50/50 border border-blue-200">
            <div class="text-xs text-slate-500 font-mono uppercase">Recycled Lithium Content</div>
            <div class="text-3xl font-extrabold text-blue-800 mt-1 font-mono">8.2%</div>
            <div class="text-xs text-slate-600 mt-1">Mandatory threshold (2031): 6%</div>
            <div class="mt-2 inline-block px-2 py-0.5 rounded bg-blue-200/80 text-blue-900 text-[10px] font-bold">Compliant</div>
          </div>
        </div>
      </div>

      <!-- Live Health & Safety -->
      <div class="neo-surface p-6 sm:p-8">
        <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
          <span class="w-6 h-6 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center text-xs font-bold">3</span>
          <span>State of Health (SOH) & Dismantling Safety</span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div class="p-4 bg-white/70 rounded-xl border border-slate-200 space-y-2">
            <div class="font-bold text-slate-900 text-sm">State of Health Telemetry</div>
            <p class="text-slate-600">Current SOH: <strong class="text-slate-900 font-mono">99.1%</strong> (Verified BMS Telemetry)</p>
            <p class="text-slate-600">Equivalent Full Cycles: <strong class="text-slate-900 font-mono">68 cycles</strong></p>
            <p class="text-slate-600">Internal Resistance Increase: <strong class="text-slate-900 font-mono">&lt; 1.2%</strong></p>
          </div>

          <div class="p-4 bg-white/70 rounded-xl border border-slate-200 space-y-2">
            <div class="font-bold text-slate-900 text-sm">Dismantling & Extinguishing Data</div>
            <p class="text-slate-600">Extinguishing Agent: <strong class="text-slate-900">Copious Water / F-500 EA</strong></p>
            <p class="text-slate-600">Disassembly Fasteners: <strong class="text-slate-900">24x M8 Torx Plus (Non-destructive)</strong></p>
            <p class="text-slate-600">Coolant Extraction: <strong class="text-slate-900">Port B Drainage before casing release</strong></p>
          </div>
        </div>
      </div>

      <!-- Regulatory Filing & Sovereign Vault Verification -->
      <div class="neo-surface p-6 sm:p-8 bg-slate-50/90 text-xs text-slate-600 space-y-3">
        <div class="font-bold text-slate-900 text-sm">European Sovereign Vault & Regulatory Anchor</div>
        <p>
          This electronic passport record is hosted within EU DPP Provider's sovereign data vault in Frankfurt am Main (Germany) pursuant to Articles 77 & 78 of Regulation (EU) 2023/1542.
        </p>
        <p class="font-mono text-[11px] text-slate-500">
          Digital Link URI: https://eudppprovider.com/01/{gtin}/21/{serial}/<br />
          ZKP Hash Anchor: 0x9f83b28174aa910c2837bc901ef8362d8190cbb37a
        </p>
      </div>

    </div>

    <!-- Bottom Actions -->
    <div class="mt-8 text-center">
      <a href="/battery-passport/" class="neo-pill px-6 py-3 rounded-full text-xs sm:text-sm font-bold text-slate-800 hover:text-cyan-700">
        ← Back to Battery Passport Platform Hub
      </a>
    </div>

  </div>
</Layout>
