---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Request Technical Scoping & Contact Executive Desk | EU DPP Provider"
  description="Contact EU DPP Provider for battery passport technical scoping, enterprise software licensing, or sovereign data vault hosting. Business Desk: info@eudppprovider.com."
>
  <div class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start max-w-6xl mx-auto">
      
      <!-- Left Column: Info & Trust Badges -->
      <div class="space-y-8">
        <div>
          <div class="eyebrow-pill mb-3">Direct Executive & Compliance Desk</div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
            Schedule Technical Scoping & Pilot Consultation
          </h1>
          <p class="mt-4 text-base text-slate-600 leading-relaxed">
            Connect directly with our regulatory compliance engineers to review your battery data readiness, evaluate MES/BMS connectors, and scope private cloud or Frankfurt sovereign vault hosting.
          </p>
        </div>

        <!-- Official Email Box -->
        <div class="neo-surface p-6 sm:p-7 bg-gradient-to-br from-white to-cyan-50/40 border-cyan-200/80">
          <div class="flex items-center gap-3.5 mb-2">
            <div class="w-10 h-10 rounded-2xl bg-cyan-100 text-cyan-700 flex items-center justify-center font-bold text-lg">✉️</div>
            <div>
              <div class="text-[11px] font-mono font-bold text-slate-400 uppercase tracking-wider">Official Inbound & Technical Desk</div>
              <div class="text-lg font-bold font-mono text-cyan-800">
                <a href="mailto:info@eudppprovider.com" class="hover:underline">info@eudppprovider.com</a>
              </div>
            </div>
          </div>
          <p class="text-xs text-slate-500 mt-2">
            SLA: Response within 24 business hours. For RFQ / Tender reviews, please mark <strong>[Tender / Priority Scope]</strong> in the email subject.
          </p>
        </div>

        <!-- Global Operating Centers -->
        <div class="neo-surface p-6 space-y-4">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500">Operating Centers & Facilities</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div class="p-3.5 rounded-xl bg-white/80 border border-slate-200">
              <div class="font-bold text-slate-900 mb-0.5">🇩🇪 EU Cloud & Regulatory Hub</div>
              <div class="text-slate-500">Frankfurt am Main & Munich · Germany</div>
              <div class="text-[11px] text-cyan-600 mt-1 font-mono">ISO 27001 & eIDAS QSeal Ops</div>
            </div>
            <div class="p-3.5 rounded-xl bg-white/80 border border-slate-200">
              <div class="font-bold text-slate-900 mb-0.5">🇨🇳 Supply Chain & MES Hub</div>
              <div class="text-slate-500">Shanghai & Suzhou · China</div>
              <div class="text-[11px] text-green-700 mt-1 font-mono">MES, PLM & BMS Connectors</div>
            </div>
          </div>
        </div>

        <!-- Security & Legal Badges -->
        <div class="neo-surface p-6">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3">Enterprise Architectural Guarantees</h4>
          <div class="grid grid-cols-2 gap-3 text-xs text-slate-700">
            <div class="flex items-center gap-2">
              <span class="text-green-600 font-bold">✓</span>
              <span>ISO/IEC 27001 Data Centers</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-green-600 font-bold">✓</span>
              <span>Zero-Knowledge Proof Shield</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-green-600 font-bold">✓</span>
              <span>eIDAS 2.0 Digital QSeal Support</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-green-600 font-bold">✓</span>
              <span>99.9% High Availability SLA</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Consultation Request Form -->
      <div class="neo-surface p-8 sm:p-10 shadow-xl border-slate-200/80">
        
        <div id="form-header">
          <h3 class="text-xl font-bold text-slate-900 mb-2">Request Technical Scoping Form</h3>
          <p class="text-xs text-slate-500 mb-6">
            Submit your project parameters to receive our technical architecture blueprint and data mapping checklist.
          </p>
        </div>

        <!-- Success Message State (Hidden by default) -->
        <div id="form-success" class="hidden p-6 rounded-2xl bg-green-50 border border-green-200 text-center space-y-4">
          <div class="w-12 h-12 rounded-full bg-green-100 text-green-700 flex items-center justify-center font-bold text-2xl mx-auto">✓</div>
          <h4 class="text-lg font-bold text-green-900">Scoping Request Registered</h4>
          <p class="text-xs text-green-800 leading-relaxed">
            Thank you. Your technical scoping request has been registered under reference:
            <br />
            <strong id="ref-id-display" class="font-mono text-sm text-green-950 bg-green-200/60 px-2 py-0.5 rounded mt-1 inline-block"></strong>
          </p>
          <p class="text-xs text-slate-600">
            Our regulatory solutions team will review your battery specifications and respond within 24 business hours.
          </p>
          <div class="pt-2">
            <a id="email-backup-btn" href="#" class="neo-btn-primary text-xs inline-block">
              Open Pre-filled Email Backup →
            </a>
          </div>
        </div>

        <!-- The Scoping Form -->
        <form id="contact-form" class="space-y-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Your Name & Role *</label>
            <input type="text" id="contact-name" required placeholder="e.g. Dr. Thomas Weber · VP of Quality / Compliance" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm text-slate-900 focus:outline-none focus:border-cyan-500 bg-white" />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Business Work Email *</label>
            <input type="email" id="contact-email" required placeholder="name@company.com" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm text-slate-900 focus:outline-none focus:border-cyan-500 bg-white" />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Company Name & Location *</label>
            <input type="text" id="contact-company" required placeholder="e.g. Apex Battery Technologies GmbH (Germany)" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm text-slate-900 focus:outline-none focus:border-cyan-500 bg-white" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Battery Category</label>
              <select id="contact-type" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-xs sm:text-sm text-slate-800 focus:outline-none focus:border-cyan-500 bg-white">
                <option value="EV Battery Packs">EV Traction Battery (Automotive)</option>
                <option value="LMT Battery Packs">LMT & E-Bike Batteries (≤25kg)</option>
                <option value="Industrial Storage">Industrial & Stationary BESS (>2kWh)</option>
                <option value="Multi-category">Multi-category / Supplier Tier</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Deployment Model</label>
              <select id="contact-model" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-xs sm:text-sm text-slate-800 focus:outline-none focus:border-cyan-500 bg-white">
                <option value="10-Year Managed Sovereign Vault">10-Year Managed Sovereign Vault</option>
                <option value="Enterprise On-Premise Software">Enterprise Software (Private Cloud)</option>
                <option value="Pilot Evaluation Package">Early Adopter Pilot Package</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Project Scope / Specific Inquiries</label>
            <textarea id="contact-message" rows="3" placeholder="Tell us about your estimated annual battery volumes, ERP/MES platforms (e.g. SAP/Siemens), and compliance target dates." class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-xs sm:text-sm text-slate-900 focus:outline-none focus:border-cyan-500 bg-white"></textarea>
          </div>

          <div class="pt-2">
            <button type="submit" id="submit-btn" class="w-full neo-btn-primary py-3.5 text-center flex items-center justify-center gap-2">
              <span id="btn-text">Submit Scoping Request →</span>
            </button>
          </div>

          <div class="text-[11px] text-slate-500 text-center pt-2">
            By submitting, you agree to our <a href="/privacy/" class="underline text-slate-600">Privacy Policy</a>. Data is handled under strict GDPR confidentiality.
          </div>
        </form>

      </div>

    </div>

  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contact-form');
      if (!form) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btnText = document.getElementById('btn-text');
        const submitBtn = document.getElementById('submit-btn');
        if (btnText) btnText.textContent = 'Transmitting Scope...';
        if (submitBtn) submitBtn.setAttribute('disabled', 'true');

        const name = document.getElementById('contact-name')?.value || '';
        const email = document.getElementById('contact-email')?.value || '';
        const company = document.getElementById('contact-company')?.value || '';
        const batteryType = document.getElementById('contact-type')?.value || '';
        const model = document.getElementById('contact-model')?.value || '';
        const message = document.getElementById('contact-message')?.value || '';

        const refId = `INQ-${Date.now().toString(36).toUpperCase()}-${Math.random().toString(36).substring(2, 6).toUpperCase()}`;

        try {
          // Attempt POST to contact API
          await fetch('/api/contact/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email, company, batteryType, model, message, refId })
          }).catch(() => null);
        } catch (_) {}

        // Pre-configure mailto backup URL
        const mailSubject = encodeURIComponent(`[DPP Technical Scoping] ${company} - ${refId}`);
        const mailBody = encodeURIComponent(`Inquiry Reference: ${refId}\nName: ${name}\nEmail: ${email}\nCompany: ${company}\nBattery Category: ${batteryType}\nDeployment Model: ${model}\n\nProject Scope:\n${message}\n\nSubmitted via eudppprovider.com`);
        const mailtoUrl = `mailto:info@eudppprovider.com?subject=${mailSubject}&body=${mailBody}`;

        const emailBackupBtn = document.getElementById('email-backup-btn');
        if (emailBackupBtn) emailBackupBtn.setAttribute('href', mailtoUrl);

        const refIdDisplay = document.getElementById('ref-id-display');
        if (refIdDisplay) refIdDisplay.textContent = refId;

        // Show success state
        form.classList.add('hidden');
        const formHeader = document.getElementById('form-header');
        if (formHeader) formHeader.classList.add('hidden');
        const formSuccess = document.getElementById('form-success');
        if (formSuccess) formSuccess.classList.remove('hidden');
      });
    });
  </script>
</Layout>
