---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Book a Demo & Contact | EU DPP Provider"
  description="Contact EU DPP Provider for technical consultation, software license inquiries, or managed battery passport data hosting services."
>
  <div class="py-24 md:py-32 bg-stone-50">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start max-w-6xl mx-auto">
        
        <!-- Left Column: Info & Trust -->
        <div class="space-y-10">
          <div>
            <span class="text-xs font-mono font-medium text-stone-600 uppercase tracking-widest bg-stone-100 px-3.5 py-1.5 rounded-full border border-stone-200">
              Direct Advisory
            </span>
            <h1 class="text-4xl sm:text-5xl font-semibold text-stone-900 tracking-tight mt-6 mb-4 leading-tight">
              Book a Technical Demo & Compliance Audit
            </h1>
            <p class="text-lg text-stone-500 leading-relaxed font-normal">
              Connect with our EU regulatory specialists and solution architects. We will walk you through live system demos, integration options, and your timeline toward the 2027 enforcement deadline.
            </p>
          </div>

          <div class="space-y-4">
            <div class="bg-white p-6 rounded-2xl border border-stone-200/90 shadow-soft flex items-start gap-4">
              <div class="text-2xl">🎯</div>
              <div>
                <h4 class="font-semibold text-stone-900 text-base">Tailored Architecture Review</h4>
                <p class="text-sm text-stone-500 mt-1 font-normal">Determine whether Enterprise Software License or Managed Data Hosting best aligns with your throughput and IT resources.</p>
              </div>
            </div>

            <div class="bg-white p-6 rounded-2xl border border-stone-200/90 shadow-soft flex items-start gap-4">
              <div class="text-2xl">🌱</div>
              <div>
                <h4 class="font-semibold text-stone-900 text-base">PCF Carbon Footprint Assessment</h4>
                <p class="text-sm text-stone-500 mt-1 font-normal">Review your battery chemistry against European PEFCR methodology benchmarks.</p>
              </div>
            </div>

            <div class="bg-white p-6 rounded-2xl border border-stone-200/90 shadow-soft flex items-start gap-4">
              <div class="text-2xl">🔒</div>
              <div>
                <h4 class="font-semibold text-stone-900 text-base">Confidential NDA Protection</h4>
                <p class="text-sm text-stone-500 mt-1 font-normal">We maintain strict mutual Non-Disclosure Agreements prior to evaluating proprietary product BOMs.</p>
              </div>
            </div>
          </div>

          <div class="pt-6 border-t border-stone-200 text-sm text-stone-500 space-y-1.5 font-normal">
            <div><strong class="text-stone-900 font-semibold">Inquiries:</strong> contact@eudppprovider.com</div>
            <div><strong class="text-stone-900 font-semibold">European Offices:</strong> Frankfurt am Main / Munich, Germany</div>
            <div><strong class="text-stone-900 font-semibold">APAC Hub:</strong> Shanghai, China</div>
          </div>
        </div>

        <!-- Right Column: Interactive Clean Form -->
        <div class="bg-white p-8 sm:p-12 rounded-3xl border border-stone-200 shadow-float">
          <h3 class="text-2xl font-bold text-stone-900 mb-2">Schedule Your Consultation</h3>
          <p class="text-sm text-stone-500 mb-8 font-normal">Fill in the details below. Our team responds within 1 business day.</p>

          <form id="contact-form" class="space-y-5 text-xs">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-medium text-stone-700 mb-1.5 text-xs">Full Name *</label>
                <input type="text" required placeholder="Dr. Johannes Müller" class="w-full px-4 py-3 rounded-xl bg-stone-50 border border-stone-200 text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:border-stone-900 transition-colors text-sm" />
              </div>
              <div>
                <label class="block font-medium text-stone-700 mb-1.5 text-xs">Business Email *</label>
                <input type="email" required placeholder="j.mueller@battery-oem.com" class="w-full px-4 py-3 rounded-xl bg-stone-50 border border-stone-200 text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:border-stone-900 transition-colors text-sm" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-medium text-stone-700 mb-1.5 text-xs">Company *</label>
                <input type="text" required placeholder="Apex Energy Technologies" class="w-full px-4 py-3 rounded-xl bg-stone-50 border border-stone-200 text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:border-stone-900 transition-colors text-sm" />
              </div>
              <div>
                <label class="block font-medium text-stone-700 mb-1.5 text-xs">Country / Region *</label>
                <input type="text" required placeholder="Germany / China / EU" class="w-full px-4 py-3 rounded-xl bg-stone-50 border border-stone-200 text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:border-stone-900 transition-colors text-sm" />
              </div>
            </div>

            <div>
              <label class="block font-medium text-stone-700 mb-1.5 text-xs">Preferred Business Model *</label>
              <select class="w-full px-4 py-3 rounded-xl bg-stone-50 border border-stone-200 text-stone-900 focus:outline-none focus:bg-white focus:border-stone-900 transition-colors text-sm">
                <option value="software">Buy Enterprise DPP Software (On-Premise / Private Cloud)</option>
                <option value="hosting">Delegate Managed DPP Data Vault Hosting</option>
                <option value="both">Undecided / Exploring Both Options</option>
                <option value="pcf">Carbon Footprint (PCF) & LCA Engine Only</option>
              </select>
            </div>

            <div>
              <label class="block font-medium text-stone-700 mb-1.5 text-xs">Battery Category</label>
              <select class="w-full px-4 py-3 rounded-xl bg-stone-50 border border-stone-200 text-stone-900 focus:outline-none focus:bg-white focus:border-stone-900 transition-colors text-sm">
                <option value="ev">Electric Vehicle (EV) Traction Battery</option>
                <option value="storage">Stationary Energy Storage System (BESS >2kWh)</option>
                <option value="lmt">Light Means of Transport (LMT / E-Bike)</option>
                <option value="supplier">Cathode / Anode / Upstream Material Supplier</option>
              </select>
            </div>

            <div>
              <label class="block font-medium text-stone-700 mb-1.5 text-xs">Project Details</label>
              <textarea rows="3" placeholder="Estimated annual battery volume, target export dates, and existing ERP systems..." class="w-full px-4 py-3 rounded-xl bg-stone-50 border border-stone-200 text-stone-900 placeholder-stone-400 focus:outline-none focus:bg-white focus:border-stone-900 transition-colors text-sm"></textarea>
            </div>

            <button type="submit" class="w-full py-4 rounded-xl bg-stone-900 hover:bg-stone-800 text-white font-semibold text-sm shadow-soft hover:shadow-float transition-all">
              Submit Request & Book Consultation &rarr;
            </button>
          </form>

          <div id="form-success" class="hidden p-6 rounded-2xl bg-emerald-50 border border-emerald-200 text-center space-y-2 mt-4">
            <div class="text-emerald-800 text-lg font-bold">✓ Request Received.</div>
            <p class="text-xs text-emerald-700">Our EU regulatory specialist will contact you within 24 hours.</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successBox = document.getElementById('form-success');
  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.classList.add('hidden');
      successBox.classList.remove('hidden');
    });
  }
</script>
