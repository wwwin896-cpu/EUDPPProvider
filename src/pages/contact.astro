---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Book a Demo & Contact Business Desk | EU DPP Provider"
  description="Contact EU DPP Provider for 6-week pilot scoping, software licensing, or managed battery passport data hosting services. Email: info@eudppprovider.com."
>
  <div class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start max-w-6xl mx-auto">
        
        <!-- Left Column: Info & Trust Badges -->
        <div class="space-y-8">
          <div>
            <div class="eyebrow mb-2">Direct Business Desk</div>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
              Start Your 6-Week Battery Passport Pilot
            </h1>
            <p class="mt-4 text-base text-slate-600 leading-relaxed">
              Connect directly with our solutions team to schedule a technical architecture briefing, evaluate your battery data readiness, or explore enterprise licensing and data vault hosting.
            </p>
          </div>

          <!-- Official Email Box -->
          <div class="panel-card p-6 bg-gradient-to-br from-white to-cyan-50/40 border-cyan-200/80">
            <div class="flex items-center gap-3 mb-2">
              <div class="w-9 h-9 rounded-xl bg-cyan-100 text-cyan-700 flex items-center justify-center font-bold text-base">✉️</div>
              <div>
                <div class="text-xs font-mono font-bold text-slate-400 uppercase tracking-wider">Official Executive & Business Desk</div>
                <div class="text-lg font-bold font-mono text-navy-900">info@eudppprovider.com</div>
              </div>
            </div>
            <p class="text-xs text-slate-500 mt-2">
              Guaranteed response within 1 business day. For urgent tender evaluations, please mark [Tender Priority] in the subject.
            </p>
          </div>

          <!-- Global Offices -->
          <div class="panel-card p-6 space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Global Engineering Hubs</h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
              <div class="p-3 bg-slate-50 rounded-xl border border-slate-200">
                <div class="font-bold text-slate-900 mb-0.5">🇩🇪 EU Operations Center</div>
                <div class="text-slate-500">Frankfurt am Main · Germany</div>
                <div class="text-[11px] text-cyan-600 mt-1 font-mono">eIDAS & EU Registry Ops</div>
              </div>
              <div class="p-3 bg-slate-50 rounded-xl border border-slate-200">
                <div class="font-bold text-slate-900 mb-0.5">🇨🇳 Supply Chain Hub</div>
                <div class="text-slate-500">Shanghai · China</div>
                <div class="text-[11px] text-green-700 mt-1 font-mono">MES & Factory Integration</div>
              </div>
            </div>
          </div>

          <!-- Trust Badges -->
          <div class="panel-card p-6">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Enterprise Security Guarantees</h4>
            <div class="grid grid-cols-2 gap-3 text-xs text-slate-600">
              <div class="flex items-center gap-2">
                <span class="text-green-600 font-bold">✓</span>
                <span>ISO 27001 Certified Vault</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-green-600 font-bold">✓</span>
                <span>ZKP Zero-Leak Protection</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-green-600 font-bold">✓</span>
                <span>DigiCert QTSP eIDAS Sign</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-green-600 font-bold">✓</span>
                <span>99.9% High Availability SLA</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Interactive Consultation Request Form -->
        <div class="panel-card p-8 sm:p-10 shadow-xl border-slate-200">
          <h3 class="text-xl font-bold text-slate-900 mb-2">Request Technical Scoping Form</h3>
          <p class="text-xs text-slate-500 mb-6">Fill out your battery specifications to receive our detailed compliance gap template.</p>
          
          <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you. Our compliance architecture team will reach out within 24 hours. You can also email us directly at info@eudppprovider.com');">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Your Name & Role</label>
              <input type="text" required placeholder="e.g. Dr. Thomas Weber · VP of Quality / Compliance" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm text-slate-900 focus:outline-none focus:border-cyan-500" />
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Business Corporate Email</label>
              <input type="email" required placeholder="name@company.com" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm text-slate-900 focus:outline-none focus:border-cyan-500" />
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Company & Country</label>
              <input type="text" required placeholder="e.g. Apex Energy Technologies GmbH" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm text-slate-900 focus:outline-none focus:border-cyan-500" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Battery Category</label>
                <select class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm text-slate-900 focus:outline-none focus:border-cyan-500 bg-white">
                  <option>Electric Vehicle (EV) Pack</option>
                  <option>Industrial BESS (>2kWh)</option>
                  <option>Light Means of Transport (LMT)</option>
                  <option>Battery Cell / Chemistry Maker</option>
                  <option>Raw Material / Upstream Supplier</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Preferred Model</label>
                <select class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm text-slate-900 focus:outline-none focus:border-cyan-500 bg-white">
                  <option>6-Week Single Model Pilot</option>
                  <option>Managed Data Vault (10-Yr SLA)</option>
                  <option>Enterprise Software License</option>
                  <option>eIDAS & NB Registration Bridge</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">Project Context & Estimated Volume</label>
              <textarea rows="3" placeholder="Tell us about your battery models, production sites, or target European delivery timeline..." class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm text-slate-900 focus:outline-none focus:border-cyan-500"></textarea>
            </div>

            <button type="submit" class="w-full py-3.5 rounded-xl bg-cyan-500 hover:bg-cyan-600 text-slate-900 font-bold text-sm transition-all shadow-md">
              Submit Request for Technical Scoping →
            </button>

            <div class="text-center pt-2">
              <span class="text-xs text-slate-400">Prefer direct communication? Email <a href="mailto:info@eudppprovider.com" class="font-mono font-bold text-navy-900 hover:text-cyan-600">info@eudppprovider.com</a></span>
            </div>
          </form>
        </div>

      </div>

    </div>
  </div>
</Layout>
