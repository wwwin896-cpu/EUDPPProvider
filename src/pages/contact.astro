---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Book a Demo & Contact | EU DPP Provider"
  description="Contact EU DPP Provider for technical consultation, software license inquiries, or managed battery passport data hosting services."
>
  <div class="py-16 bg-radial-gradient">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start max-w-6xl mx-auto">
        
        <!-- Left Column: Info & Trust -->
        <div class="space-y-8">
          <div>
            <span class="text-xs font-bold font-mono text-brand-400 uppercase tracking-widest bg-brand-500/10 px-3 py-1 rounded-full border border-brand-500/20">
              Get In Touch
            </span>
            <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mt-4 mb-4">
              Book a Technical Demo & Compliance Audit
            </h1>
            <p class="text-base text-slate-300 leading-relaxed">
              Connect with our EU regulatory specialists and solution architects. We will walk you through live system demos, integration options, and your timeline toward the 2027 enforcement deadline.
            </p>
          </div>

          <div class="space-y-4 text-xs">
            <div class="glass-card p-5 border border-slate-800 flex items-start gap-4">
              <div class="text-2xl">🎯</div>
              <div>
                <h4 class="font-bold text-white text-sm">Tailored Architecture Review</h4>
                <p class="text-slate-400 mt-0.5">Determine whether Enterprise Software License or Managed Data Hosting best aligns with your throughput and IT resources.</p>
              </div>
            </div>

            <div class="glass-card p-5 border border-slate-800 flex items-start gap-4">
              <div class="text-2xl">🌱</div>
              <div>
                <h4 class="font-bold text-white text-sm">PCF Carbon Footprint Assessment</h4>
                <p class="text-slate-400 mt-0.5">Review your battery chemistry against European PEFCR methodology benchmarks.</p>
              </div>
            </div>

            <div class="glass-card p-5 border border-slate-800 flex items-start gap-4">
              <div class="text-2xl">🔒</div>
              <div>
                <h4 class="font-bold text-white text-sm">Confidential NDA Protection</h4>
                <p class="text-slate-400 mt-0.5">We maintain strict mutual Non-Disclosure Agreements prior to evaluating proprietary product BOMs.</p>
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-800 text-xs text-slate-400 space-y-1">
            <div><strong>Direct Inquiries:</strong> contact@eudppprovider.com</div>
            <div><strong>European Offices:</strong> Frankfurt am Main / Munich, Germany</div>
            <div><strong>APAC Operations:</strong> Shanghai / Shenzhen, China</div>
          </div>
        </div>

        <!-- Right Column: Interactive Form -->
        <div class="glass-card p-8 sm:p-10 border border-brand-500/30 bg-slate-900/90 shadow-2xl shadow-brand-950/80">
          <h3 class="text-xl font-bold text-white mb-2">Schedule Your Consultation</h3>
          <p class="text-xs text-slate-400 mb-6">Fill in the details below. Our team responds within 1 business day.</p>

          <form id="contact-form" class="space-y-4 text-xs">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-medium text-slate-300 mb-1">First & Last Name *</label>
                <input type="text" required placeholder="Dr. Johannes Müller" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-brand-500 transition-colors" />
              </div>
              <div>
                <label class="block font-medium text-slate-300 mb-1">Business Email *</label>
                <input type="email" required placeholder="j.mueller@battery-oem.com" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-brand-500 transition-colors" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block font-medium text-slate-300 mb-1">Company / Organization *</label>
                <input type="text" required placeholder="Apex Energy Technologies" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-brand-500 transition-colors" />
              </div>
              <div>
                <label class="block font-medium text-slate-300 mb-1">Country / Region *</label>
                <input type="text" required placeholder="Germany / China / EU" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-brand-500 transition-colors" />
              </div>
            </div>

            <div>
              <label class="block font-medium text-slate-300 mb-1">Preferred Business Solution *</label>
              <select class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 focus:outline-none focus:border-brand-500 transition-colors">
                <option value="software">Buy Enterprise DPP Software (On-Premise / Private Cloud)</option>
                <option value="hosting">Delegate Managed DPP Data Vault Hosting</option>
                <option value="both">Undecided / Exploring Both Options</option>
                <option value="pcf">Carbon Footprint (PCF) & LCA Engine Only</option>
              </select>
            </div>

            <div>
              <label class="block font-medium text-slate-300 mb-1">Battery Category</label>
              <select class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 focus:outline-none focus:border-brand-500 transition-colors">
                <option value="ev">Electric Vehicle (EV) Traction Battery</option>
                <option value="storage">Stationary Energy Storage System (BESS >2kWh)</option>
                <option value="lmt">Light Means of Transport (LMT / E-Bike)</option>
                <option value="supplier">Cathode / Anode / Upstream Material Supplier</option>
              </select>
            </div>

            <div>
              <label class="block font-medium text-slate-300 mb-1">Project Details & Questions</label>
              <textarea rows="3" placeholder="Tell us about your estimated annual battery volume, target export dates, and existing ERP systems..." class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-100 placeholder-slate-500 focus:outline-none focus:border-brand-500 transition-colors"></textarea>
            </div>

            <button type="submit" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-brand-500 via-accent-teal to-accent-emerald text-white font-bold text-sm shadow-xl shadow-brand-500/25 hover:opacity-95 transition-all">
              Submit Request & Book Consultation &rarr;
            </button>
          </form>

          <div id="form-success" class="hidden p-6 rounded-xl bg-emerald-950/30 border border-emerald-500/40 text-center space-y-2 mt-4">
            <div class="text-accent-emerald text-xl font-bold">✓ Thank you! Request Received.</div>
            <p class="text-xs text-slate-300">Our EU regulatory specialist will contact you within 24 hours.</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successBox = document.getElementById('form-success');
  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.classList.add('hidden');
      successBox.classList.remove('hidden');
    });
  }
</script>
