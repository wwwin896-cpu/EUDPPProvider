---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="py-4">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
    
    <!-- OPTION A: Buy DPP Enterprise Software (Private Cloud / On-Premise) -->
    <div class="panel-card p-8 sm:p-10 relative flex flex-col justify-between hover:border-cyan-500/80 transition-all group">
      
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-semibold bg-cyan-100 text-cyan-700 font-mono">
            Model 01 · Software License
          </span>
          <span class="text-xs text-slate-500 font-medium">For Battery Cell & Pack OEMs</span>
        </div>

        <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          {t('pricing.software.title')}
        </h3>
        <p class="text-sm text-slate-500 mt-2 leading-relaxed">
          {t('pricing.software.desc')}
        </p>

        <div class="my-6 border-t border-slate-100"></div>

        <ul class="space-y-3 text-sm text-slate-600">
          <li class="flex items-start gap-2.5">
            <span class="text-cyan-600 font-bold mt-0.5">✓</span>
            <span><strong>100% Code & Data Sovereignty:</strong> Deploy in your own AWS/Azure/Alibaba Cloud EU Region.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-cyan-600 font-bold mt-0.5">✓</span>
            <span><strong>Unlimited Serialization:</strong> Zero per-passport or per-scan surcharge fees.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-cyan-600 font-bold mt-0.5">✓</span>
            <span><strong>MES / ERP / BMS Connectors:</strong> Direct API integration with plant automation.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-cyan-600 font-bold mt-0.5">✓</span>
            <span><strong>Annual Regulatory Updates:</strong> Ongoing updates for delegated EU acts.</span>
          </li>
        </ul>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="text-xs font-mono text-slate-500 uppercase">License Type</div>
          <div class="text-base font-bold text-slate-900">Perpetual / Annual Enterprise</div>
        </div>
        <a
          href={`/${lang === 'en' ? '' : lang + '/'}solutions/software-license`}
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-navy-800 text-white font-semibold text-sm hover:bg-navy-900 transition-colors shadow-sm"
        >
          {t('pricing.software.cta')}
        </a>
      </div>

    </div>

    <!-- OPTION B: Managed DPP Data Vault (Turnkey Cloud Hosting) -->
    <div class="panel-card p-8 sm:p-10 relative flex flex-col justify-between border-green-500/40 bg-gradient-to-b from-white to-green-50/20 hover:border-green-500 transition-all group">
      
      <div>
        <div class="flex items-center justify-between mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700 font-mono">
            Model 02 · Managed Vault
          </span>
          <span class="text-xs text-green-700 font-bold">Fastest Time-to-Market</span>
        </div>

        <h3 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          {t('pricing.hosting.title')}
        </h3>
        <p class="text-sm text-slate-500 mt-2 leading-relaxed">
          {t('pricing.hosting.desc')}
        </p>

        <div class="my-6 border-t border-slate-100"></div>

        <ul class="space-y-3 text-sm text-slate-600">
          <li class="flex items-start gap-2.5">
            <span class="text-green-600 font-bold mt-0.5">✓</span>
            <span><strong>Turnkey EU Sovereign Vault:</strong> Hosted in ISO 27001 certified Frankfurt/Munich nodes.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-green-600 font-bold mt-0.5">✓</span>
            <span><strong>ZKP Trade Secret Shield:</strong> Prove compliance without exposing raw BOM or pricing.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-green-600 font-bold mt-0.5">✓</span>
            <span><strong>Full-Service PCF Calculation:</strong> Our LCA engineers handle PEFCR data modeling.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-green-600 font-bold mt-0.5">✓</span>
            <span><strong>Dedicated SLA & Support:</strong> 99.99% uptime guarantee with GS1 QR resolution.</span>
          </li>
        </ul>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="text-xs font-mono text-slate-500 uppercase">Billing Structure</div>
          <div class="text-base font-bold text-green-700">Tiered Volume / Predictable SaaS</div>
        </div>
        <a
          href={`/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting`}
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-green-700 text-white font-semibold text-sm hover:bg-green-800 transition-colors shadow-sm"
        >
          {t('pricing.hosting.cta')}
        </a>
      </div>

    </div>

  </div>
</div>
