---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
  
  <!-- Option 1: Buy DPP Software -->
  <div class="neo-surface p-8 sm:p-10 flex flex-col justify-between group hover:scale-[1.01] transition-all">
    <div>
      <div class="flex items-center justify-between mb-4">
        <span class="eyebrow-pill">Model 01 · Software License</span>
        <span class="text-xs font-mono text-slate-500">For Cell & Pack OEMs</span>
      </div>

      <h3 class="text-2xl font-bold text-slate-900 tracking-tight">
        {t('pricing.software.title')}
      </h3>
      <p class="text-xs text-slate-500 mt-2 leading-relaxed">
        {t('pricing.software.desc')}
      </p>

      <div class="my-6 border-t border-slate-200/80"></div>

      <ul class="space-y-2.5 text-xs text-slate-600">
        <li class="flex items-center gap-2">
          <span class="text-cyan-600 font-bold">✓</span>
          <span><strong>100% Code & Data Sovereignty:</strong> Deploy in your private cloud</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="text-cyan-600 font-bold">✓</span>
          <span><strong>Unlimited Serialization:</strong> Zero per-passport scan surcharge</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="text-cyan-600 font-bold">✓</span>
          <span><strong>Plant Connectors:</strong> Direct API to MES / ERP / BMS lines</span>
        </li>
      </ul>
    </div>

    <div class="mt-8 pt-6 border-t border-slate-200/80 flex items-center justify-between">
      <div>
        <div class="text-[10px] font-mono text-slate-400 uppercase">Deployment</div>
        <div class="text-sm font-bold text-slate-900">Perpetual / Annual License</div>
      </div>
      <a
        href={`/${lang === 'en' ? '' : lang + '/'}solutions/software-license`}
        class="neo-pill px-5 py-2.5 rounded-full text-xs font-bold text-navy-900 hover:text-cyan-600 transition-colors"
      >
        {t('pricing.software.cta')} →
      </a>
    </div>
  </div>

  <!-- Option 2: Managed Data Vault -->
  <div class="neo-surface p-8 sm:p-10 flex flex-col justify-between group hover:scale-[1.01] transition-all border-green-500/30">
    <div>
      <div class="flex items-center justify-between mb-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-800 font-mono">
          Model 02 · Managed Vault
        </span>
        <span class="text-xs font-bold text-green-700">10-Year Guarantee</span>
      </div>

      <h3 class="text-2xl font-bold text-slate-900 tracking-tight">
        {t('pricing.hosting.title')}
      </h3>
      <p class="text-xs text-slate-500 mt-2 leading-relaxed">
        {t('pricing.hosting.desc')}
      </p>

      <div class="my-6 border-t border-slate-200/80"></div>

      <ul class="space-y-2.5 text-xs text-slate-600">
        <li class="flex items-center gap-2">
          <span class="text-green-600 font-bold">✓</span>
          <span><strong>Sovereign EU Cloud:</strong> ISO 27001 nodes in Frankfurt & Munich</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="text-green-600 font-bold">✓</span>
          <span><strong>ZKP Secret Shield:</strong> Zero-leak formula & supplier protection</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="text-green-600 font-bold">✓</span>
          <span><strong>Full Registry Service:</strong> EU Login, QSeal & UPI sync handled</span>
        </li>
      </ul>
    </div>

    <div class="mt-8 pt-6 border-t border-slate-200/80 flex items-center justify-between">
      <div>
        <div class="text-[10px] font-mono text-slate-400 uppercase">Service Model</div>
        <div class="text-sm font-bold text-green-700">Turnkey 10-Yr SLA</div>
      </div>
      <a
        href={`/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting`}
        class="neo-pill px-5 py-2.5 rounded-full text-xs font-bold text-green-800 hover:text-green-900 transition-colors"
      >
        {t('pricing.hosting.cta')} →
      </a>
    </div>
  </div>

</div>
