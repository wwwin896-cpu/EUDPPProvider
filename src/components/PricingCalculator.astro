---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="max-w-5xl mx-auto space-y-12">
  
  <!-- Interactive Calculator Engine Card -->
  <div class="neo-surface p-8 sm:p-10 border-2 border-cyan-500/30">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-200">
      <div>
        <div class="eyebrow-pill mb-1">Interactive Configuration Engine</div>
        <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900">
          EU Battery Passport Cost Estimator
        </h3>
      </div>
      <div class="px-3 py-1 bg-cyan-100 text-cyan-800 rounded-full font-mono text-xs font-bold">
        Formula Version 2026.4
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-8 items-start">
      
      <!-- Input Controls -->
      <div class="space-y-6">
        <div>
          <div class="flex justify-between items-center mb-2">
            <label class="text-xs font-bold uppercase tracking-wider text-slate-700">Annual Battery Pack Volume</label>
            <span id="volume-val-display" class="font-mono text-sm font-extrabold text-cyan-800 bg-cyan-50 px-2 py-0.5 rounded border border-cyan-200">25,000 packs/yr</span>
          </div>
          <input 
            type="range" 
            id="calc-volume" 
            min="1000" 
            max="200000" 
            step="1000" 
            value="25000" 
            class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-cyan-600" 
          />
          <div class="flex justify-between text-[10px] text-slate-400 font-mono mt-1">
            <span>1K (Pilot / Low-vol)</span>
            <span>50K (Medium)</span>
            <span>200K+ (High-vol OEM)</span>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Battery Category & Form Factor</label>
          <div class="grid grid-cols-3 gap-2 text-xs">
            <button type="button" class="calc-cat-btn py-2 px-2.5 rounded-xl border border-cyan-500 bg-cyan-50 text-cyan-900 font-bold text-center" data-cat="ev">
              🚗 EV Packs
            </button>
            <button type="button" class="calc-cat-btn py-2 px-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 font-medium text-center hover:bg-slate-50" data-cat="lmt">
              🚲 LMT (≤25kg)
            </button>
            <button type="button" class="calc-cat-btn py-2 px-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 font-medium text-center hover:bg-slate-50" data-cat="storage">
              🏭 BESS (&gt;2kWh)
            </button>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Delivery & Architecture Preference</label>
          <div class="grid grid-cols-2 gap-2 text-xs">
            <button type="button" class="calc-mode-btn py-2.5 px-3 rounded-xl border border-cyan-500 bg-cyan-50 text-cyan-900 font-bold text-center" data-mode="vault">
              ☁️ Managed 10-Yr Vault (Frankfurt)
            </button>
            <button type="button" class="calc-mode-btn py-2.5 px-3 rounded-xl border border-slate-200 bg-white text-slate-700 font-medium text-center hover:bg-slate-50" data-mode="software">
              🏢 Enterprise Software (On-Prem)
            </button>
          </div>
        </div>
      </div>

      <!-- Output Summary Box -->
      <div class="p-6 sm:p-7 rounded-2xl bg-gradient-to-br from-[#F4F8FA] to-cyan-50/60 border border-cyan-200 space-y-4">
        <div>
          <div class="text-[11px] font-mono font-bold text-slate-500 uppercase tracking-wider">Estimated Annual Commitment</div>
          <div id="calc-price-display" class="text-3xl sm:text-4xl font-extrabold text-navy-900 font-mono mt-1 text-slate-900">
            €12,500 – €18,000 <span class="text-xs font-normal text-slate-500">/ yr</span>
          </div>
          <div class="text-[11px] text-cyan-800 font-mono mt-0.5">Approx. <span id="calc-per-pack" class="font-bold">€0.50 – €0.72</span> per battery pack</div>
        </div>

        <div class="pt-3 border-t border-slate-200/80 space-y-2 text-xs text-slate-700">
          <div class="flex justify-between">
            <span class="text-slate-500">10-Year Archival SLA:</span>
            <span class="font-bold text-slate-900">Guaranteed 99.9% Uptime</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Regulatory Updates:</span>
            <span class="font-bold text-slate-900">Included (30-day schema patch)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500">Zero-Knowledge Proofs:</span>
            <span class="font-bold text-green-700">Active (Full Formulation Shield)</span>
          </div>
        </div>

        <div class="pt-3">
          <a id="calc-cta-btn" href="/contact/" class="w-full neo-btn-primary py-3 text-center block text-xs font-bold">
            Lock in Estimate & Scoping Call →
          </a>
          <p class="text-[10px] text-slate-400 text-center mt-2">
            Non-binding budgetary estimate. Final quote subject to MES connector complexity.
          </p>
        </div>
      </div>

    </div>
  </div>

</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const volumeSlider = document.getElementById('calc-volume');
    const volumeDisplay = document.getElementById('volume-val-display');
    const priceDisplay = document.getElementById('calc-price-display');
    const perPackDisplay = document.getElementById('calc-per-pack');
    const ctaBtn = document.getElementById('calc-cta-btn');

    let currentCat = 'ev';
    let currentMode = 'vault';

    function recalculate() {
      const vol = parseInt(volumeSlider?.value || '25000', 10);
      if (volumeDisplay) volumeDisplay.textContent = `${vol.toLocaleString()} packs/yr`;

      let baseLow = 4800;
      let baseHigh = 7500;

      if (currentMode === 'vault') {
        if (vol <= 5000) {
          baseLow = 4800;
          baseHigh = 6800;
        } else if (vol <= 25000) {
          baseLow = 9500;
          baseHigh = 14500;
        } else if (vol <= 100000) {
          baseLow = 18000;
          baseHigh = 28000;
        } else {
          baseLow = 36000;
          baseHigh = 55000;
        }
      } else {
        // Enterprise on-premise
        baseLow = 25000;
        baseHigh = 45000;
      }

      if (currentCat === 'storage') {
        baseLow = Math.round(baseLow * 1.15);
        baseHigh = Math.round(baseHigh * 1.15);
      } else if (currentCat === 'lmt') {
        baseLow = Math.round(baseLow * 0.85);
        baseHigh = Math.round(baseHigh * 0.85);
      }

      const unitLow = (baseLow / vol).toFixed(2);
      const unitHigh = (baseHigh / vol).toFixed(2);

      if (priceDisplay) {
        if (currentMode === 'software') {
          priceDisplay.innerHTML = `€${baseLow.toLocaleString()} – €${baseHigh.toLocaleString()} <span class="text-xs font-normal text-slate-500">/ annual license</span>`;
        } else {
          priceDisplay.innerHTML = `€${baseLow.toLocaleString()} – €${baseHigh.toLocaleString()} <span class="text-xs font-normal text-slate-500">/ yr</span>`;
        }
      }

      if (perPackDisplay) {
        perPackDisplay.textContent = `€${unitLow} – €${unitHigh}`;
      }

      if (ctaBtn) {
        ctaBtn.setAttribute('href', `/contact/?vol=${vol}&cat=${currentCat}&mode=${currentMode}`);
      }
    }

    if (volumeSlider) {
      volumeSlider.addEventListener('input', recalculate);
    }

    document.querySelectorAll('.calc-cat-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.calc-cat-btn').forEach(b => {
          b.className = 'calc-cat-btn py-2 px-2.5 rounded-xl border border-slate-200 bg-white text-slate-700 font-medium text-center hover:bg-slate-50';
        });
        const target = e.currentTarget;
        target.className = 'calc-cat-btn py-2 px-2.5 rounded-xl border border-cyan-500 bg-cyan-50 text-cyan-900 font-bold text-center';
        currentCat = target.getAttribute('data-cat') || 'ev';
        recalculate();
      });
    });

    document.querySelectorAll('.calc-mode-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.calc-mode-btn').forEach(b => {
          b.className = 'calc-mode-btn py-2.5 px-3 rounded-xl border border-slate-200 bg-white text-slate-700 font-medium text-center hover:bg-slate-50';
        });
        const target = e.currentTarget;
        target.className = 'calc-mode-btn py-2.5 px-3 rounded-xl border border-cyan-500 bg-cyan-50 text-cyan-900 font-bold text-center';
        currentMode = target.getAttribute('data-mode') || 'vault';
        recalculate();
      });
    });

    recalculate();
  });
</script>
