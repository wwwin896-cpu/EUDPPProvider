    title: 'How It Works: Real-Time DPP Generation Workflow',
    subtitle: 'Watch how enterprise data declaration automatically verifies against EU Annex XIII rules and renders a compliant Digital Battery Passport in milliseconds.',
    scene1Title: '01. EV Traction Battery (NMC 811)',
    scene1Desc: '82kWh · 800V Architecture · Class A Carbon Rating · SOH 99.2%',
    scene2Title: '02. Industrial Storage (BESS LFP)',
    scene2Desc: '372kWh · 1500V Container · Co-Free 0% Recycled Li · ISO 14067',
    scene3Title: '03. E-Bike Pack (LMT 48V)',
    scene3Desc: '750Wh · 2/3-Wheeler Module · Batch SGTIN QR · CE DoC Attached',
    actionBtn: 'Launch Full Interactive Simulator →',
    autoPlayNote: 'Continuous Real-Time Simulation Loop (Click any tab to pause)'
  },
  zh: {
    badge: '解决方案实时动态演示',
