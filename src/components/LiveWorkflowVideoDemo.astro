    scene1Title: '01. EV-Traktionsbatterie (NMC 811)',
    scene1Desc: '82kWh · 800V-System · CO₂-Klasse A · SOH 99,2% BMS-Telemetrie',
    scene2Title: '02. BESS-Industriespeicher (LFP)',
    scene2Desc: '372kWh · 1500V-Container · Kobaltfrei 0% · ISO 14067 LCA',
    scene3Title: '03. E-Bike-Akku (LMT 48V)',
    scene3Desc: '750Wh · Leichtmobilität · SGTIN-Chargencode · eIDAS 2.0 Siegel',
    actionBtn: 'Interaktiven Simulator öffnen →',
    autoPlayNote: 'Automatischer Echtzeit-Demonstrations-Loop (Klick pausiert)'
  },
  fr: {
    badge: 'Démonstration Vidéo en Direct',
    title: 'Fonctionnement : Workflow de Génération DPP en Temps Réel',
    subtitle: 'Découvrez comment les données d’entreprise sont validées selon l’Annexe XIII de l’UE et génèrent un passeport batterie en quelques millisecondes.',
    scene1Title: '01. Batterie de Traction VE (NMC 811)',
    scene1Desc: '82kWh · 800V · Empreinte Carbone Classe A · SOH 99,2%',
    scene2Title: '02. Stockage Industriel BESS (LFP)',
    scene2Desc: '372kWh · Conteneur 1500V · Sans Cobalt · Dépôt Registre UE',
    scene3Title: '03. Batterie VAE (LMT 48V)',
    scene3Desc: '750Wh · Mobilité Légère · Code SGTIN Lot · Sceau DoC eIDAS',
    actionBtn: 'Lancer le Simulateur Interactif →',
    autoPlayNote: 'Boucle de démonstration continue (Cliquez pour mettre en pause)'
  },
  nl: {
    badge: 'Live Oplossingsdemonstratie',
    title: 'Hoe het werkt: Realtime DPP Generatie Workflow',
    subtitle: 'Bekijk hoe bedrijfsgegevens direct worden gevalideerd tegen EU Bijlage XIII regels en resulteren in een digitaal batterijpaspoort.',
    scene1Title: '01. EV-Tractiebatterij (NMC 811)',
    scene1Desc: '82kWh · 800V Systeem · CO₂-Klasse A · SOH 99,2% BMS Data',
    scene2Title: '02. BESS Opslagsysteem (LFP)',
    scene2Desc: '372kWh · 1500V Container · Kobaltvrij 0% · ISO 14067 LCA',
    scene3Title: '03. E-Bike Accu (LMT 48V)',
    scene3Desc: '750Wh · Lichte Mobiliteit · Batch SGTIN QR · eIDAS Zegel',
    actionBtn: 'Open Interactieve Simulator →',
    autoPlayNote: 'Doorlopende demonstratie-loop (Klik om te pauzeren)'
