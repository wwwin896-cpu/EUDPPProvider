};

const tLocal = translations[lang as keyof typeof translations] || translations.en;
---

<section class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  
  <!-- Header -->
  <div class="text-center max-w-3xl mx-auto mb-10">
    <div class="eyebrow-pill mb-3 mx-auto">
      <span class="w-2 h-2 rounded-full bg-cyan-600 animate-pulse"></span>
      <span>{tLocal.badge}</span>
    </div>
    <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
      {tLocal.title}
    </h2>
    <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
      {tLocal.subtitle}
    </p>
  </div>

  <!-- Video Player Shell (Neomorphic Video Frame) -->
  <div class="neo-surface p-4 sm:p-8 rounded-3xl border border-white/80 shadow-2xl relative overflow-hidden">
    
    <!-- Video Player Top Bar with Timeline Controls -->
    <div class="neo-well p-3 sm:p-4 rounded-2xl flex flex-wrap items-center justify-between gap-4 mb-6">
      
      <!-- Left: Live Status & Controls -->
      <div class="flex items-center gap-3">
        <button id="btn-toggle-play" onclick="toggleAutoPlay()" class="w-8 h-8 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white flex items-center justify-center text-xs shadow-sm transition-all">
          <span id="icon-play-state">⏸</span>
        </button>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-slate-900">Live Workflow Player</span>
            <span class="px-2 py-0.2 rounded-full bg-red-100 text-red-700 text-[10px] font-mono font-bold flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-ping"></span>
              <span>AUTO LOOP</span>
            </span>
          </div>
          <div class="text-[10px] text-slate-500 font-mono mt-0.5">
            {tLocal.autoPlayNote}
          </div>
        </div>
      </div>

      <!-- Center / Right: 3 Scene Progress Indicators -->
      <div class="flex items-center gap-2 sm:gap-3 text-xs">
        <button onclick="jumpToScene(1)" id="scene-nav-1" class="scene-tab px-3 py-1.5 rounded-xl bg-cyan-600 text-white font-bold text-xs transition-all shadow-sm">
          🚗 1. EV Pack
        </button>
        <button onclick="jumpToScene(2)" id="scene-nav-2" class="scene-tab px-3 py-1.5 rounded-xl bg-white/90 text-slate-700 font-medium text-xs hover:bg-slate-100 transition-all border border-slate-200">
          ⚡ 2. BESS Storage
        </button>
        <button onclick="jumpToScene(3)" id="scene-nav-3" class="scene-tab px-3 py-1.5 rounded-xl bg-white/90 text-slate-700 font-medium text-xs hover:bg-slate-100 transition-all border border-slate-200">
          🚲 3. E-Bike LMT
        </button>
      </div>

    </div>

    <!-- Active Scene Progress Bar (Animates 0% to 100% every 5 seconds) -->
    <div class="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden mb-8">
      <div id="timeline-progress" class="bg-gradient-to-r from-cyan-500 to-blue-600 h-full w-0 transition-all duration-100 ease-linear"></div>
    </div>

    <!-- Main Live Demonstration Canvas (Left: Simulated Operator Actions, Right: Live Mobile Output) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center bg-slate-50/60 p-4 sm:p-8 rounded-2xl border border-slate-200/80">
      
      <!-- Left: Operator Action Terminal (7 Cols) -->
      <div class="lg:col-span-7 space-y-4">
        
        <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100">
            <div class="text-xs font-bold text-slate-900 flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-cyan-500"></span>
              <span id="demo-stage-title">Step 1: Product Serialization & Formulation Entry</span>
            </div>
            <span id="demo-stage-badge" class="px-2 py-0.5 rounded bg-green-100 text-green-800 text-[10px] font-mono font-bold">
              ✓ Rule Verified
            </span>
          </div>

          <!-- Operator Action Highlight Box -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/70">
              <div class="text-[10px] text-slate-400 uppercase font-mono">Product Identification</div>
              <div id="demo-model-val" class="font-bold text-slate-900 text-sm mt-0.5 transition-all">Apex HyperDrive 82kWh</div>
              <div id="demo-serial-val" class="text-[11px] font-mono text-cyan-700 mt-1">SN: BP-2027-EU-88902</div>
            </div>

            <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/70">
              <div class="text-[10px] text-slate-400 uppercase font-mono">Cathode Chemistry & Recycled</div>
              <div id="demo-chem-val" class="font-bold text-slate-900 text-sm mt-0.5">NMC 811 (High-Nickel)</div>
              <div id="demo-recycled-val" class="text-[11px] font-mono text-purple-700 mt-1">Co: 18.4% | Li: 8.2% (ZKP Proof)</div>
            </div>
          </div>

          <!-- Live Compliance Check Indicators -->
          <div class="p-3 rounded-xl bg-gradient-to-r from-cyan-50 to-blue-50 border border-cyan-200 text-xs space-y-1.5">
            <div class="flex items-center justify-between">
              <span class="text-slate-700 font-medium">Annex XIII Statutory Validation:</span>
              <span class="text-green-700 font-bold font-mono">100% Passed</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-700 font-medium">Carbon Footprint Performance:</span>
              <span id="demo-pcf-val" class="text-cyan-800 font-bold font-mono">51.2 kg CO₂e/kWh (Class A)</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-700 font-medium">DG GROW Central Registry Filing:</span>
              <span class="text-blue-700 font-bold font-mono">Ready for eIDAS QSeal</span>
            </div>
          </div>

        </div>

        <!-- Description Note for Current Scenario -->
        <div class="p-4 rounded-xl bg-white/80 border border-slate-200 text-xs text-slate-600 leading-relaxed flex items-center justify-between gap-4">
          <div>
            <div id="demo-scene-name" class="font-bold text-slate-900">{tLocal.scene1Title}</div>
            <div id="demo-scene-desc" class="text-slate-500 mt-0.5">{tLocal.scene1Desc}</div>
          </div>
          <a href={`/${lang === 'en' ? '' : lang + '/'}portal-simulator/`} class="neo-btn-primary text-xs py-2 px-3.5 whitespace-nowrap hidden sm:inline-flex">
            <span>{tLocal.actionBtn}</span>
          </a>
        </div>

      </div>

      <!-- Right: Real-time Output Mobile Display (5 Cols) -->
      <div class="lg:col-span-5">
        <div class="max-w-[320px] mx-auto rounded-[32px] bg-slate-900 p-3 shadow-2xl border-4 border-slate-800">
          
          <!-- Screen Header -->
          <div class="w-20 h-3 bg-slate-800 rounded-full mx-auto mb-2"></div>

          <!-- Smartphone Inner Screen -->
          <div class="rounded-[22px] bg-[#F8FAFC] p-3 text-slate-800 space-y-2.5 text-xs">
            
            <div class="flex items-center justify-between pb-1.5 border-b border-slate-200">
              <div class="flex items-center gap-1">
                <span>🇪🇺</span>
                <span class="text-[9px] font-extrabold uppercase text-slate-900">Digital Battery Passport</span>
              </div>
              <span class="px-1 py-0.2 rounded bg-green-100 text-green-800 text-[8px] font-mono font-bold">LIVE RESOLVER</span>
            </div>

            <!-- Dynamic Product Header -->
            <div class="bg-white p-2.5 rounded-xl border border-slate-200 shadow-sm space-y-1">
              <div id="phone-category" class="text-[9px] font-mono text-cyan-700 font-bold">Electric Vehicle Traction</div>
              <div id="phone-model" class="text-xs font-bold text-slate-900 leading-tight">Apex HyperDrive Traction Battery</div>
              <div class="text-[9px] font-mono text-slate-500 bg-slate-50 p-1 rounded border border-slate-100">
                SN: <span id="phone-serial" class="font-bold text-slate-800">BP-2027-EU-88902</span>
              </div>
            </div>

            <!-- QR Code Matrix Animation -->
            <div class="bg-white p-2 rounded-xl border border-slate-200 text-center space-y-1 shadow-sm">
              <div class="w-16 h-16 mx-auto bg-slate-50 border border-slate-200 rounded-lg flex items-center justify-center p-1">
                <svg viewBox="0 0 100 100" class="w-full h-full text-slate-900" fill="currentColor">
                  <rect x="0" y="0" width="30" height="30" />
                  <rect x="5" y="5" width="20" height="20" fill="white" />
                  <rect x="10" y="10" width="10" height="10" />
                  <rect x="70" y="0" width="30" height="30" />
                  <rect x="75" y="5" width="20" height="20" fill="white" />
                  <rect x="80" y="10" width="10" height="10" />
                  <rect x="0" y="70" width="30" height="30" />
                  <rect x="5" y="75" width="20" height="20" fill="white" />
                  <rect x="10" y="80" width="10" height="10" />
                  <rect x="35" y="20" width="10" height="20" />
                  <rect x="55" y="35" width="20" height="15" />
                  <rect x="35" y="65" width="25" height="15" />
                </svg>
              </div>
              <div id="phone-uri" class="text-[8px] font-mono text-cyan-800 truncate bg-slate-50 p-1 rounded border border-slate-200">
                https://eudppprovider.com/01/.../21/...
              </div>
            </div>

            <!-- Badges -->
            <div class="grid grid-cols-2 gap-1.5 text-center">
              <div class="bg-white p-1.5 rounded-lg border border-slate-200 shadow-sm">
                <div class="text-[8px] text-slate-400 uppercase font-mono">Carbon Class</div>
                <div id="phone-class-badge" class="text-[10px] font-extrabold text-green-700 mt-0.5">Class A (Top 15%)</div>
              </div>
              <div class="bg-white p-1.5 rounded-lg border border-slate-200 shadow-sm">
                <div class="text-[8px] text-slate-400 uppercase font-mono">State of Health</div>
                <div id="phone-soh" class="text-[10px] font-bold text-cyan-800 mt-0.5">99.2% SOH</div>
              </div>
            </div>

            <!-- eIDAS Seal -->
            <div class="p-1.5 rounded-lg bg-green-50 border border-green-200 text-center text-[8px] text-green-800 font-mono font-bold">
              🔒 eIDAS 2.0 Qualified Seal Validated
            </div>

          </div>

        </div>
      </div>

    </div>

  </div>

</section>

<script is:inline>
  let currentScene = 1;
  let isPlaying = true;
  let sceneTimer = null;
  let progressInterval = null;
  let progressPercent = 0;
  const SCENE_DURATION_MS = 5000;

  const sceneData = [
    {
      id: 1,
      title: '01. EV Traction Battery (NMC 811)',
      desc: '82kWh · 800V Architecture · Class A Carbon Rating · SOH 99.2%',
      model: 'Apex HyperDrive Traction Battery (82kWh)',
      serial: 'BP-2027-EU-88902',
      gtin: '04012345999991',
      category: 'Electric Vehicle Traction (EV)',
      chem: 'NMC 811 (High-Nickel)',
      recycled: 'Co: 18.4% | Li: 8.2% (ZKP Shielded)',
      pcf: '51.2 kg CO₂e/kWh (Class A)',
      pcfBadge: 'Class A (Top 15%)',
      soh: '99.2% SOH (BMS Live)'
    },
    {
      id: 2,
      title: '02. Industrial Storage (BESS LFP)',
      desc: '372kWh · 1500V Container · Co-Free 0% Recycled Li · ISO 14067',
      model: 'GridVault Industrial BESS 372kWh Container',
      serial: 'BESS-1500V-372KWH',
      gtin: '06978453010036',
      category: 'Industrial Stationary Storage (BESS)',
      chem: 'LFP (Lithium Iron Phosphate)',
      recycled: 'Cobalt-Free (0%) | Li: 11.5%',
      pcf: '42.1 kg CO₂e/kWh (Class A)',
      pcfBadge: 'Class A (Low Carbon)',
      soh: '99.8% SOH (Nominal)'
    },
    {
      id: 3,
      title: '03. E-Bike Pack (LMT 48V)',
      desc: '750Wh · 2/3-Wheeler Module · Batch SGTIN QR · CE DoC Attached',
      model: 'UrbanCommute 48V E-Bike Pack (750Wh)',
      serial: 'LMT-48V-750WH-001',
      gtin: '06978453010029',
      category: 'Light Means of Transport (LMT)',
      chem: 'NMC 622 Cylindrical Cells',
      recycled: 'Co: 14.2% | Li: 6.5%',
      pcf: '48.6 kg CO₂e/kWh (Class B)',
      pcfBadge: 'Class B Rating',
      soh: '98.5% SOH (Verified)'
    }
  ];

  function renderScene(sceneIndex) {
    const data = sceneData[sceneIndex - 1];
    if (!data) return;

    // Update Nav Buttons
    for (let i = 1; i <= 3; i++) {
      const btn = document.getElementById(`scene-nav-${i}`);
      if (btn) {
        if (i === sceneIndex) {
          btn.className = 'scene-tab px-3 py-1.5 rounded-xl bg-cyan-600 text-white font-bold text-xs transition-all shadow-sm';
        } else {
          btn.className = 'scene-tab px-3 py-1.5 rounded-xl bg-white/90 text-slate-700 font-medium text-xs hover:bg-slate-100 transition-all border border-slate-200';
        }
      }
    }

    // Update Left Terminal Content
    const dModel = document.getElementById('demo-model-val');
    const dSerial = document.getElementById('demo-serial-val');
    const dChem = document.getElementById('demo-chem-val');
    const dRecycled = document.getElementById('demo-recycled-val');
    const dPcf = document.getElementById('demo-pcf-val');
    const dSceneName = document.getElementById('demo-scene-name');
    const dSceneDesc = document.getElementById('demo-scene-desc');

    if (dModel) dModel.innerText = data.model;
    if (dSerial) dSerial.innerText = `SN: ${data.serial}`;
    if (dChem) dChem.innerText = data.chem;
    if (dRecycled) dRecycled.innerText = data.recycled;
    if (dPcf) dPcf.innerText = data.pcf;
    if (dSceneName) dSceneName.innerText = data.title;
    if (dSceneDesc) dSceneDesc.innerText = data.desc;

    // Update Right Phone Output
    const pCat = document.getElementById('phone-category');
    const pModel = document.getElementById('phone-model');
    const pSerial = document.getElementById('phone-serial');
    const pUri = document.getElementById('phone-uri');
    const pClassBadge = document.getElementById('phone-class-badge');
    const pSoh = document.getElementById('phone-soh');

    if (pCat) pCat.innerText = data.category;
    if (pModel) pModel.innerText = data.model;
    if (pSerial) pSerial.innerText = data.serial;
    if (pUri) pUri.innerText = `https://eudppprovider.com/01/${data.gtin}/21/${data.serial}/`;
    if (pClassBadge) pClassBadge.innerText = data.pcfBadge;
    if (pSoh) pSoh.innerText = data.soh;
  }

  function startProgressLoop() {
    progressPercent = 0;
    const intervalMs = 50;
    const step = (100 / (SCENE_DURATION_MS / intervalMs));

    if (progressInterval) clearInterval(progressInterval);

    progressInterval = setInterval(() => {
      if (!isPlaying) return;
      progressPercent += step;
      const bar = document.getElementById('timeline-progress');
      if (bar) bar.style.width = `${Math.min(progressPercent, 100)}%`;

      if (progressPercent >= 100) {
        progressPercent = 0;
        currentScene = currentScene >= 3 ? 1 : currentScene + 1;
        renderScene(currentScene);
      }
    }, intervalMs);
  }

  function jumpToScene(sceneNum) {
    currentScene = sceneNum;
    progressPercent = 0;
    const bar = document.getElementById('timeline-progress');
    if (bar) bar.style.width = '0%';
    renderScene(currentScene);
  }

  function toggleAutoPlay() {
    isPlaying = !isPlaying;
    const icon = document.getElementById('icon-play-state');
    if (icon) icon.innerText = isPlaying ? '⏸' : '▶';
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderScene(1);
    startProgressLoop();
  });
</script>
