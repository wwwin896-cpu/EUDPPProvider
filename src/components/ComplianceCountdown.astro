---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const milestones = [
  {
    date: 'Aug 2025',
    title: 'Carbon Footprint Declaration',
    desc: 'Mandatory PCF lifecycle reporting for EV batteries.',
    status: 'Step 1'
  },
  {
    date: '18 Feb 2027',
    title: 'Battery Passport Mandatory',
    desc: 'Article 77 & 78: Full Digital Product Passport required for EV, LMT & BESS (>2kWh).',
    status: 'Legal Deadline',
    highlight: true
  },
  {
    date: 'Aug 2028',
    title: 'Recycled Content Quotas',
    desc: 'Documented recycled shares for Co, Li, Ni, and Lead.',
    status: 'Step 3'
  },
  {
    date: 'Feb 2030',
    title: 'Supply Chain Due Diligence',
    desc: 'OECD-aligned third-party audits for critical minerals.',
    status: 'Step 4'
  }
];
---

<div class="bg-white border border-stone-200/90 rounded-3xl p-8 sm:p-12 shadow-soft relative">
  
  <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 pb-10 border-b border-stone-200/70">
    <div class="max-w-xl">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-medium bg-amber-50 text-amber-800 border border-amber-200/80 mb-3.5">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
        EU Regulation 2023/1542 Enforcement Clock
      </div>
      <h3 class="text-2xl sm:text-3xl font-semibold text-stone-900 tracking-tight">
        Countdown to Mandatory Battery Passports (18 Feb 2027)
      </h3>
      <p class="text-base text-stone-500 mt-2 font-normal leading-relaxed">
        All EV, LMT, and industrial batteries (&gt;2kWh) entering the European Union must carry an accessible digital passport.
      </p>
    </div>

    <!-- Minimalist Clean Timer (Large Expressive Numbers) -->
    <div id="countdown-timer" class="grid grid-cols-4 gap-3 sm:gap-4 text-center w-full lg:w-auto">
      <div class="bg-stone-50/90 border border-stone-200/80 rounded-2xl p-4 sm:p-5 min-w-[85px] sm:min-w-[100px]">
        <span id="days" class="text-3xl sm:text-4xl font-semibold font-mono text-stone-900">000</span>
        <span class="block text-xs uppercase tracking-wider text-stone-400 font-medium mt-1">Days</span>
      </div>
      <div class="bg-stone-50/90 border border-stone-200/80 rounded-2xl p-4 sm:p-5 min-w-[85px] sm:min-w-[100px]">
        <span id="hours" class="text-3xl sm:text-4xl font-semibold font-mono text-stone-800">00</span>
        <span class="block text-xs uppercase tracking-wider text-stone-400 font-medium mt-1">Hours</span>
      </div>
      <div class="bg-stone-50/90 border border-stone-200/80 rounded-2xl p-4 sm:p-5 min-w-[85px] sm:min-w-[100px]">
        <span id="mins" class="text-3xl sm:text-4xl font-semibold font-mono text-stone-800">00</span>
        <span class="block text-xs uppercase tracking-wider text-stone-400 font-medium mt-1">Mins</span>
      </div>
      <div class="bg-stone-50/90 border border-stone-200/80 rounded-2xl p-4 sm:p-5 min-w-[85px] sm:min-w-[100px]">
        <span id="secs" class="text-3xl sm:text-4xl font-semibold font-mono text-emerald-700">00</span>
        <span class="block text-xs uppercase tracking-wider text-stone-400 font-medium mt-1">Secs</span>
      </div>
    </div>
  </div>

  <!-- Regulatory Milestones (Airy Horizontal Cards) -->
  <div class="pt-8">
    <div class="text-xs font-semibold text-stone-400 uppercase tracking-wider mb-5">
      Official European Regulatory Roadmap
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {milestones.map((m) => (
        <div class={`p-5 rounded-2xl border transition-all ${m.highlight ? 'bg-stone-900 text-white border-stone-900 shadow-md' : 'bg-stone-50/70 border-stone-200/80 text-stone-800'}`}>
          <div class="flex items-center justify-between mb-3">
            <span class={`text-xs font-mono font-bold ${m.highlight ? 'text-emerald-400' : 'text-stone-500'}`}>{m.date}</span>
            <span class={`text-[10px] font-medium px-2.5 py-0.5 rounded-full ${m.highlight ? 'bg-white/15 text-stone-100' : 'bg-stone-200/80 text-stone-600'}`}>
              {m.status}
            </span>
          </div>
          <div class={`text-base font-semibold ${m.highlight ? 'text-white' : 'text-stone-900'}`}>{m.title}</div>
          <div class={`text-xs mt-1.5 leading-relaxed font-normal ${m.highlight ? 'text-stone-300' : 'text-stone-500'}`}>{m.desc}</div>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  function updateCountdown() {
    const targetDate = new Date('2027-02-18T00:00:00Z').getTime();
    const now = new Date().getTime();
    const diff = targetDate - now;

    if (diff <= 0) return;

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const secs = Math.floor((diff % (1000 * 60)) / 1000);

    const dEl = document.getElementById('days');
    const hEl = document.getElementById('hours');
    const mEl = document.getElementById('mins');
    const sEl = document.getElementById('secs');

    if (dEl) dEl.textContent = String(days).padStart(3, '0');
    if (hEl) hEl.textContent = String(hours).padStart(2, '0');
    if (mEl) mEl.textContent = String(mins).padStart(2, '0');
    if (sEl) sEl.textContent = String(secs).padStart(2, '0');
  }

  updateCountdown();
  setInterval(updateCountdown, 1000);
</script>
