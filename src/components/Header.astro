---
import { getLangFromUrl, useTranslations, languages } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;

function switchLanguageUrl(targetLang: string) {
  let path = currentPath;
  if (lang !== 'en') {
    path = path.replace(`/${lang}`, '') || '/';
  }
  if (targetLang === 'en') {
    return path;
  }
  return `/${targetLang}${path === '/' ? '' : path}`;
}

const navLinks = [
  { href: `/${lang === 'en' ? '' : lang + '/'}solutions/ev-battery-passport`, label: t('nav.evBattery') },
  { href: `/${lang === 'en' ? '' : lang + '/'}solutions/storage-battery-passport`, label: t('nav.storageBattery') },
  { href: `/${lang === 'en' ? '' : lang + '/'}solutions/software-license`, label: t('nav.software') },
  { href: `/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting`, label: t('nav.hosting') },
  { href: `/${lang === 'en' ? '' : lang + '/'}platform/carbon-footprint-engine`, label: t('nav.pcf') },
  { href: `/${lang === 'en' ? '' : lang + '/'}compliance/eu-battery-regulation-2023-1542`, label: t('nav.regulation') },
  { href: `/${lang === 'en' ? '' : lang + '/'}pricing`, label: t('nav.pricing') },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo Lockup -->
      <a href={`/${lang === 'en' ? '' : lang}`} class="flex items-center group py-2">
        <img 
          src="/eudpp_logo_light.svg" 
          alt="EU DPP Provider - Digital Product Passport System" 
          class="h-10 sm:h-11 w-auto object-contain transition-transform group-hover:opacity-90"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2">
        
        <!-- Solutions Dropdown -->
        <div class="relative group">
          <button class="inline-flex items-center px-3.5 py-2 text-sm font-medium text-slate-700 hover:text-navy-900 rounded-lg hover:bg-slate-100 transition-colors">
            <span>{t('nav.solutions')}</span>
            <svg class="ml-1.5 w-4 h-4 text-slate-500 group-hover:text-navy-900 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <div class="absolute left-0 mt-1 w-72 rounded-xl bg-white shadow-xl border border-slate-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 p-2 z-50">
            <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/ev-battery-passport`} class="block p-3 rounded-lg hover:bg-slate-50 transition-colors">
              <div class="text-sm font-semibold text-slate-900">{t('nav.evBattery')}</div>
              <div class="text-xs text-slate-500 mt-0.5">EV battery pack compliance & OEM linking</div>
            </a>
            <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/storage-battery-passport`} class="block p-3 rounded-lg hover:bg-slate-50 transition-colors">
              <div class="text-sm font-semibold text-slate-900">{t('nav.storageBattery')}</div>
              <div class="text-xs text-slate-500 mt-0.5">Industrial & stationary BESS (>2kWh)</div>
            </a>
            <div class="my-1 border-t border-slate-100"></div>
            <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/software-license`} class="block p-3 rounded-lg hover:bg-cyan-50/50 transition-colors">
              <div class="text-sm font-semibold text-cyan-600 flex items-center justify-between">
                <span>{t('nav.software')}</span>
                <span class="text-[10px] uppercase font-bold tracking-wider px-1.5 py-0.5 bg-cyan-100 text-cyan-700 rounded">On-Prem</span>
              </div>
              <div class="text-xs text-slate-500 mt-0.5">Enterprise software license & private cloud</div>
            </a>
            <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting`} class="block p-3 rounded-lg hover:bg-green-50/50 transition-colors">
              <div class="text-sm font-semibold text-green-700 flex items-center justify-between">
                <span>{t('nav.hosting')}</span>
                <span class="text-[10px] uppercase font-bold tracking-wider px-1.5 py-0.5 bg-green-100 text-green-700 rounded">Vault</span>
              </div>
              <div class="text-xs text-slate-500 mt-0.5">Turnkey EU sovereign data vault & ZKP shield</div>
            </a>
          </div>
        </div>

        <!-- Platform Links -->
        <a href={`/${lang === 'en' ? '' : lang + '/'}platform/carbon-footprint-engine`} class="px-3 py-2 text-sm font-medium text-slate-700 hover:text-navy-900 rounded-lg hover:bg-slate-100 transition-colors">
          {t('nav.pcf')}
        </a>
        <a href={`/${lang === 'en' ? '' : lang + '/'}platform/gs1-qr-serialization`} class="px-3 py-2 text-sm font-medium text-slate-700 hover:text-navy-900 rounded-lg hover:bg-slate-100 transition-colors">
          {t('nav.gs1')}
        </a>
        <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-battery-regulation-2023-1542`} class="px-3 py-2 text-sm font-medium text-slate-700 hover:text-navy-900 rounded-lg hover:bg-slate-100 transition-colors">
          {t('nav.regulation')}
        </a>
        <a href={`/${lang === 'en' ? '' : lang + '/'}pricing`} class="px-3 py-2 text-sm font-medium text-slate-700 hover:text-navy-900 rounded-lg hover:bg-slate-100 transition-colors">
          {t('nav.pricing')}
        </a>
      </nav>

      <!-- Right CTAs & Language Switcher -->
      <div class="flex items-center space-x-3">
        
        <!-- Language Switcher Pill -->
        <div class="relative group">
          <button class="inline-flex items-center px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg border border-slate-200 transition-colors">
            <svg class="w-3.5 h-3.5 mr-1.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
            </svg>
            <span>{languages[lang]}</span>
            <svg class="ml-1 w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <div class="absolute right-0 mt-1 w-36 rounded-xl bg-white shadow-lg border border-slate-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 p-1.5 z-50">
            {Object.entries(languages).map(([l, name]) => (
              <a
                href={switchLanguageUrl(l)}
                class={`block px-3 py-2 text-xs font-medium rounded-lg transition-colors ${
                  lang === l ? 'bg-cyan-50 text-cyan-600 font-bold' : 'text-slate-700 hover:bg-slate-50'
                }`}
              >
                {name}
              </a>
            ))}
          </div>
        </div>

        <!-- Book a Demo Button (Exact Cyan-500 per spec) -->
        <a
          href={`/${lang === 'en' ? '' : lang + '/'}contact`}
          class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold rounded-lg bg-cyan-500 hover:bg-cyan-600 text-slate-900 transition-all shadow-sm hover:shadow"
        >
          <span>{t('hero.cta.primary')}</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

      </div>

    </div>
  </div>
</header>
