---
import { getLangFromUrl, useTranslations, languages } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;

// Function to switch language keeping current route
function switchLanguageUrl(targetLang: string) {
  let path = currentPath;
  if (lang !== 'en') {
    path = path.replace(`/${lang}`, '') || '/';
  }
  if (targetLang === 'en') {
    return path;
  }
  return `/${targetLang}${path === '/' ? '' : path}`;
}

const navLinks = [
  { href: `/${lang === 'en' ? '' : lang + '/'}`, label: t('nav.home') },
  {
    label: t('nav.solutions'),
    dropdown: [
      { href: `/${lang === 'en' ? '' : lang + '/'}solutions/ev-battery-passport`, label: t('nav.evBattery'), desc: 'Passenger & Commercial EV Pack Passports' },
      { href: `/${lang === 'en' ? '' : lang + '/'}solutions/storage-battery-passport`, label: t('nav.storageBattery'), desc: 'Industrial & BESS Storage (>2kWh)' },
      { href: `/${lang === 'en' ? '' : lang + '/'}solutions/software-license`, label: t('nav.software'), desc: 'On-premise / Private Cloud License' },
      { href: `/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting`, label: t('nav.hosting'), desc: 'Turnkey Data Hosting & ZKP Vault' },
    ]
  },
  {
    label: t('nav.platform'),
    dropdown: [
      { href: `/${lang === 'en' ? '' : lang + '/'}platform/carbon-footprint-engine`, label: t('nav.pcf'), desc: 'LCA Modeling & PEFCR-Compliant Reports' },
      { href: `/${lang === 'en' ? '' : lang + '/'}platform/gs1-qr-serialization`, label: t('nav.gs1'), desc: 'High-speed 2D Barcode & Resolver' },
    ]
  },
  { href: `/${lang === 'en' ? '' : lang + '/'}compliance/eu-battery-regulation-2023-1542`, label: t('nav.regulation') },
  { href: `/${lang === 'en' ? '' : lang + '/'}pricing`, label: t('nav.pricing') },
];
---

<header class="sticky top-0 z-50 bg-slate-950/80 backdrop-blur-lg border-b border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href={`/${lang === 'en' ? '' : lang + '/'}`} class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-brand-500 to-accent-emerald flex items-center justify-center p-0.5 shadow-lg shadow-brand-500/20 group-hover:scale-105 transition-transform">
          <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
            <svg class="w-5 h-5 text-brand-400 group-hover:text-accent-emerald transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
        </div>
        <div class="flex flex-col">
          <span class="text-lg font-bold tracking-tight text-white flex items-center gap-1.5">
            EU DPP Provider
            <span class="text-[10px] font-semibold bg-brand-500/20 text-brand-400 px-1.5 py-0.5 rounded border border-brand-500/30">
              EU 2023/1542
            </span>
          </span>
          <span class="text-[11px] text-slate-400 -mt-0.5 font-medium">Digital Product Passport & Hosting</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1">
        {navLinks.map((link) => (
          link.dropdown ? (
            <div class="relative group">
              <button class="px-3.5 py-2 text-sm font-medium text-slate-300 hover:text-white rounded-lg hover:bg-slate-900 transition-colors flex items-center gap-1.5">
                {link.label}
                <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-slate-300 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 mt-1 w-72 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 p-2 z-50">
                {link.dropdown.map((sub) => (
                  <a href={sub.href} class="block p-2.5 rounded-xl hover:bg-slate-800/80 transition-colors group/item">
                    <div class="text-sm font-semibold text-slate-200 group-hover/item:text-brand-400">{sub.label}</div>
                    <div class="text-xs text-slate-400 mt-0.5">{sub.desc}</div>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a href={link.href} class="px-3.5 py-2 text-sm font-medium text-slate-300 hover:text-white rounded-lg hover:bg-slate-900 transition-colors">
              {link.label}
            </a>
          )
        ))}
      </nav>

      <!-- Right CTAs & Language Switcher -->
      <div class="flex items-center gap-3">
        <!-- Language Switcher Dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium text-slate-300 bg-slate-900 hover:bg-slate-800 border border-slate-800 rounded-lg transition-colors">
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{languages[lang as keyof typeof languages] || 'English'}</span>
            <svg class="w-3 h-3 text-slate-500 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute right-0 mt-1 w-36 rounded-xl bg-slate-900 border border-slate-800 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 p-1 z-50">
            {Object.entries(languages).map(([key, label]) => (
              <a
                href={switchLanguageUrl(key)}
                class={`flex items-center justify-between px-3 py-1.5 text-xs rounded-lg transition-colors ${
                  lang === key ? 'bg-brand-500/20 text-brand-400 font-semibold' : 'text-slate-300 hover:bg-slate-800'
                }`}
              >
                <span>{label}</span>
                {lang === key && <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>}
              </a>
            ))}
          </div>
        </div>

        <!-- CTA Button -->
        <a
          href={`/${lang === 'en' ? '' : lang + '/'}contact`}
          class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-sm font-semibold rounded-xl bg-gradient-to-r from-brand-500 to-accent-teal text-white hover:opacity-95 shadow-lg shadow-brand-500/25 transition-all hover:scale-[1.02]"
        >
          {t('nav.contact')}
        </a>

        <!-- Mobile Menu Toggle -->
        <button id="mobile-menu-btn" class="lg:hidden p-2 text-slate-400 hover:text-white rounded-lg hover:bg-slate-900" aria-label="Toggle menu">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-800 bg-slate-950 p-4 space-y-3">
    <a href={`/${lang === 'en' ? '' : lang + '/'}`} class="block text-sm font-medium text-slate-200 py-1">{t('nav.home')}</a>
    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">{t('nav.solutions')}</div>
    <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/ev-battery-passport`} class="block pl-3 text-sm text-slate-300 py-1">{t('nav.evBattery')}</a>
    <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/storage-battery-passport`} class="block pl-3 text-sm text-slate-300 py-1">{t('nav.storageBattery')}</a>
    <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/software-license`} class="block pl-3 text-sm text-slate-300 py-1">{t('nav.software')}</a>
    <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting`} class="block pl-3 text-sm text-slate-300 py-1">{t('nav.hosting')}</a>
    <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">{t('nav.platform')}</div>
    <a href={`/${lang === 'en' ? '' : lang + '/'}platform/carbon-footprint-engine`} class="block pl-3 text-sm text-slate-300 py-1">{t('nav.pcf')}</a>
    <a href={`/${lang === 'en' ? '' : lang + '/'}platform/gs1-qr-serialization`} class="block pl-3 text-sm text-slate-300 py-1">{t('nav.gs1')}</a>
    <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-battery-regulation-2023-1542`} class="block text-sm font-medium text-slate-200 py-1">{t('nav.regulation')}</a>
    <a href={`/${lang === 'en' ? '' : lang + '/'}pricing`} class="block text-sm font-medium text-slate-200 py-1">{t('nav.pricing')}</a>
    <a href={`/${lang === 'en' ? '' : lang + '/'}contact`} class="block text-center py-2.5 rounded-xl bg-brand-500 text-white font-semibold text-sm mt-3">{t('nav.contact')}</a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
