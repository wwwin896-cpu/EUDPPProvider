---
import { getLangFromUrl, useTranslations, languages } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;

function switchLanguageUrl(targetLang: string) {
  let path = currentPath;
  if (lang !== 'en') {
    path = path.replace(`/${lang}`, '') || '/';
  }
  if (targetLang === 'en') {
    return path;
  }
  return `/${targetLang}${path === '/' ? '' : path}`;
}
---

<header class="sticky top-3 z-50 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto transition-all">
  
  <!-- Floating Centered Neomorphic Navbar Island -->
  <div class="bg-[#F0F4F8]/90 backdrop-blur-xl rounded-full px-5 sm:px-7 py-3 border border-white/80 shadow-[8px_8px_24px_rgba(209,217,230,0.7),-8px_-8px_24px_rgba(255,255,255,0.95)] flex items-center justify-between gap-4">
    
    <!-- Left: Brand Logo -->
    <a href={`/${lang === 'en' ? '' : lang}`} class="flex items-center flex-shrink-0 group">
      <img 
        src="/eudpp_logo_light.svg" 
        alt="EU DPP Provider" 
        class="h-9 sm:h-10 w-auto object-contain transition-transform group-hover:scale-[1.02]"
      />
    </a>

    <!-- Center: Clean Minimal Menu Items -->
    <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
      
      <!-- Solutions Dropdown -->
      <div class="relative group">
        <button class="px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-slate-700 hover:text-cyan-700 rounded-full hover:bg-white/60 transition-all flex items-center gap-1.5">
          <span>{t('nav.solutions')}</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-cyan-700 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute left-1/2 -translate-x-1/2 mt-3 w-84 rounded-2xl bg-[#F0F4F8]/95 backdrop-blur-xl border border-white/80 shadow-[10px_10px_30px_rgba(209,217,230,0.8),-10px_-10px_30px_rgba(255,255,255,0.95)] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 p-3 z-50">
          <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/ev-battery-passport`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all">
            <div class="text-xs font-bold text-slate-900">{t('nav.evBattery')}</div>
            <div class="text-[11px] text-slate-500 mt-0.5">EV battery pack compliance & OEM linking</div>
          </a>
          
          <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/lmt-battery-passport`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all">
            <div class="text-xs font-bold text-slate-900 flex items-center justify-between">
              <span>{t('nav.lmtBattery')}</span>
              <span class="text-[10px] px-1.5 py-0.2 bg-cyan-100 text-cyan-800 rounded font-mono">E-Bike</span>
            </div>
            <div class="text-[11px] text-slate-500 mt-0.5">Light mobility & 2/3-wheeler traction packs</div>
          </a>

          <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/storage-battery-passport`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all">
            <div class="text-xs font-bold text-slate-900">{t('nav.storageBattery')}</div>
            <div class="text-[11px] text-slate-500 mt-0.5">Industrial & stationary BESS (>2kWh)</div>
          </a>
          <div class="my-1.5 border-t border-slate-200/60"></div>
          <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/software-license`} class="block p-2.5 rounded-xl hover:bg-cyan-100/40 transition-all">
            <div class="text-xs font-bold text-cyan-800 flex items-center justify-between">
              <span>{t('nav.software')}</span>
              <span class="text-[10px] px-1.5 py-0.5 bg-cyan-200/70 text-cyan-800 rounded font-mono">On-Prem</span>
            </div>
          </a>
          <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting`} class="block p-2.5 rounded-xl hover:bg-green-100/40 transition-all">
            <div class="text-xs font-bold text-green-800 flex items-center justify-between">
              <span>{t('nav.hosting')}</span>
              <span class="text-[10px] px-1.5 py-0.5 bg-green-200/70 text-green-800 rounded font-mono">10-Yr SLA</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Compliance Dropdown -->
      <div class="relative group">
        <button class="px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-slate-700 hover:text-cyan-700 rounded-full hover:bg-white/60 transition-all flex items-center gap-1.5">
          <span>Regulation & Registry</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-cyan-700 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute left-1/2 -translate-x-1/2 mt-3 w-80 rounded-2xl bg-[#F0F4F8]/95 backdrop-blur-xl border border-white/80 shadow-[10px_10px_30px_rgba(209,217,230,0.8),-10px_-10px_30px_rgba(255,255,255,0.95)] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 p-3 z-50">
          <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-battery-regulation-2023-1542`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all">
            <div class="text-xs font-bold text-slate-900">{t('nav.regulation')}</div>
            <div class="text-[11px] text-slate-500 mt-0.5">EU 2023/1542 Article 77/78 Full Analysis</div>
          </a>
          <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-dpp-registry-guide`} class="block p-2.5 rounded-xl hover:bg-amber-50/70 transition-all">
            <div class="text-xs font-bold text-amber-800 flex items-center justify-between">
              <span>{t('nav.registry')}</span>
              <span class="text-[10px] px-1.5 py-0.5 bg-amber-200/80 text-amber-900 rounded font-mono">eIDAS 2.0</span>
            </div>
            <div class="text-[11px] text-slate-500 mt-0.5">Official DG GROW Registry enrolment SOP</div>
          </a>
        </div>
      </div>

      <!-- Core Links -->
      <a href={`/${lang === 'en' ? '' : lang + '/'}platform/carbon-footprint-engine`} class="px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-slate-700 hover:text-cyan-700 rounded-full hover:bg-white/60 transition-all">
        Technology
      </a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}about`} class="px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-slate-700 hover:text-cyan-700 rounded-full hover:bg-white/60 transition-all">
        {t('nav.about')}
      </a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}pricing`} class="px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-slate-700 hover:text-cyan-700 rounded-full hover:bg-white/60 transition-all">
        {t('nav.pricing')}
      </a>
    </nav>

    <!-- Right: Language Pill & Primary Action Button -->
    <div class="flex items-center gap-2.5">
      
      <!-- Language Switcher Pill -->
      <div class="relative group">
        <button class="neo-pill px-3 py-1.5 rounded-full text-xs font-bold text-slate-700 flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
          <span>{languages[lang]}</span>
        </button>

        <div class="absolute right-0 mt-2 w-36 rounded-2xl bg-[#F0F4F8] border border-white/80 shadow-[6px_6px_16px_rgba(209,217,230,0.8),-6px_-6px_16px_rgba(255,255,255,0.9)] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 p-2 z-50">
          {Object.entries(languages).map(([l, name]) => (
            <a
              href={switchLanguageUrl(l)}
              class={`block px-3 py-1.5 text-xs font-bold rounded-xl transition-all ${
                lang === l ? 'bg-[#E6ECF2] text-cyan-600 shadow-inner' : 'text-slate-700 hover:bg-white/60'
              }`}
            >
              {name}
            </a>
          ))}
        </div>
      </div>

      <!-- Action Button -->
      <a
        href={`/${lang === 'en' ? '' : lang + '/'}contact`}
        class="hidden sm:inline-flex items-center gap-1.5 px-4 sm:px-5 py-2 rounded-full text-xs font-bold uppercase tracking-wider bg-gradient-to-r from-cyan-600 to-cyan-500 hover:from-cyan-500 hover:to-cyan-400 text-white shadow-[3px_3px_10px_rgba(11,127,163,0.3),-2px_-2px_8px_rgba(255,255,255,0.8)] transition-all"
      >
        <span>{t('hero.cta.primary')}</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-nav-toggle"
        aria-label="Toggle Mobile Menu"
        class="md:hidden neo-pill p-2 rounded-full text-slate-700"
      >
        <svg id="mob-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="mob-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

    </div>

  </div>

  <!-- Mobile Neomorphic Slide-Down Menu -->
  <div id="mobile-nav-drawer" class="hidden md:hidden mt-3 neo-surface p-5 space-y-3 transition-all">
    <div class="space-y-1.5">
      <div class="text-[10px] font-bold font-mono uppercase tracking-wider text-slate-400 px-3">Solutions</div>
      <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/ev-battery-passport`} class="block px-3.5 py-2 text-xs font-bold text-slate-800 rounded-xl hover:bg-white/60">
        {t('nav.evBattery')}
      </a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/lmt-battery-passport`} class="block px-3.5 py-2 text-xs font-bold text-slate-800 rounded-xl hover:bg-white/60">
        {t('nav.lmtBattery')}
      </a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/storage-battery-passport`} class="block px-3.5 py-2 text-xs font-bold text-slate-800 rounded-xl hover:bg-white/60">
        {t('nav.storageBattery')}
      </a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/software-license`} class="block px-3.5 py-2 text-xs font-bold text-cyan-800 rounded-xl hover:bg-cyan-50">
        {t('nav.software')}
      </a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting`} class="block px-3.5 py-2 text-xs font-bold text-green-800 rounded-xl hover:bg-green-50">
        {t('nav.hosting')}
      </a>

      <div class="my-2 border-t border-slate-200"></div>

      <div class="text-[10px] font-bold font-mono uppercase tracking-wider text-slate-400 px-3">Compliance & Info</div>
      <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-battery-regulation-2023-1542`} class="block px-3.5 py-2 text-xs font-bold text-slate-800 rounded-xl hover:bg-white/60">
        {t('nav.regulation')}
      </a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-dpp-registry-guide`} class="block px-3.5 py-2 text-xs font-bold text-amber-800 rounded-xl hover:bg-amber-50">
        {t('nav.registry')}
      </a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}about`} class="block px-3.5 py-2 text-xs font-bold text-slate-800 rounded-xl hover:bg-white/60">
        {t('nav.about')}
      </a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}pricing`} class="block px-3.5 py-2 text-xs font-bold text-slate-800 rounded-xl hover:bg-white/60">
        {t('nav.pricing')}
      </a>
    </div>

    <!-- Mobile Quick Email Box -->
    <div class="neo-well p-3 text-center">
      <div class="text-[11px] text-slate-500 font-medium">Official Business Desk</div>
      <a href="mailto:info@eudppprovider.com" class="text-xs font-bold font-mono text-navy-900 hover:text-cyan-600">info@eudppprovider.com</a>
    </div>

    <!-- Mobile CTA -->
    <a
      href={`/${lang === 'en' ? '' : lang + '/'}contact`}
      class="block w-full text-center py-2.5 rounded-full bg-cyan-600 text-white font-bold text-xs shadow-md"
    >
      {t('hero.cta.primary')} →
    </a>
  </div>

</header>

<script is:inline>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');
  const iconOpen = document.getElementById('mob-icon-open');
  const iconClose = document.getElementById('mob-icon-close');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = drawer.classList.contains('hidden');
      if (isHidden) {
        drawer.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        drawer.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });
  }
</script>
