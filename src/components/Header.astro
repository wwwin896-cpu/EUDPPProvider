---
import { getLangFromUrl, useTranslations, languages } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;

function switchLanguageUrl(targetLang: string) {
  let path = currentPath;
  if (lang !== 'en') {
    path = path.replace(`/${lang}`, '') || '/';
  }
  if (targetLang === 'en') {
    return path;
  }
  return `/${targetLang}${path === '/' ? '' : path}`;
}

const navLinks = [
  { href: `/${lang === 'en' ? '' : lang + '/'}`, label: t('nav.home') },
  {
    label: t('nav.solutions'),
    dropdown: [
      { href: `/${lang === 'en' ? '' : lang + '/'}solutions/ev-battery-passport`, label: t('nav.evBattery'), desc: 'Passenger & Commercial EV Packs' },
      { href: `/${lang === 'en' ? '' : lang + '/'}solutions/storage-battery-passport`, label: t('nav.storageBattery'), desc: 'Industrial & BESS Storage (>2kWh)' },
      { href: `/${lang === 'en' ? '' : lang + '/'}solutions/software-license`, label: t('nav.software'), desc: 'On-premise & Private Cloud License' },
      { href: `/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting`, label: t('nav.hosting'), desc: 'Turnkey Data Hosting & ZKP Vault' },
    ]
  },
  {
    label: t('nav.platform'),
    dropdown: [
      { href: `/${lang === 'en' ? '' : lang + '/'}platform/carbon-footprint-engine`, label: t('nav.pcf'), desc: 'LCA Modeling & PEFCR-Compliant Engine' },
      { href: `/${lang === 'en' ? '' : lang + '/'}platform/gs1-qr-serialization`, label: t('nav.gs1'), desc: 'GS1 Digital Link & High-Speed Barcode' },
    ]
  },
  { href: `/${lang === 'en' ? '' : lang + '/'}compliance/eu-battery-regulation-2023-1542`, label: t('nav.regulation') },
  { href: `/${lang === 'en' ? '' : lang + '/'}pricing`, label: t('nav.pricing') },
];
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-stone-200/80 transition-all">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between h-20">
      
      <!-- Minimalist Brand Logo -->
      <a href={`/${lang === 'en' ? '' : lang + '/'}`} class="flex items-center gap-3.5 group">
        <div class="w-9 h-9 rounded-xl bg-stone-900 flex items-center justify-center text-white font-bold text-sm shadow-sm group-hover:bg-emerald-800 transition-colors">
          EU
        </div>
        <div class="flex flex-col">
          <span class="text-base font-semibold tracking-tight text-stone-900 flex items-center gap-2">
            EU DPP Provider
            <span class="text-[10px] font-mono font-medium bg-stone-100 text-stone-600 px-1.5 py-0.5 rounded border border-stone-200/80">
              EU 2023/1542
            </span>
          </span>
          <span class="text-[11px] text-stone-400 font-normal">Digital Product Passport Platform</span>
        </div>
      </a>

      <!-- Desktop Navigation (Minimalist European Spacing) -->
      <nav class="hidden lg:flex items-center gap-1.5">
        {navLinks.map((link) => (
          link.dropdown ? (
            <div class="relative group">
              <button class="px-3.5 py-2 text-sm font-medium text-stone-600 hover:text-stone-900 rounded-xl hover:bg-stone-100/80 transition-colors flex items-center gap-1.5">
                {link.label}
                <svg class="w-3.5 h-3.5 text-stone-400 group-hover:text-stone-700 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute left-0 mt-2 w-80 rounded-2xl bg-white border border-stone-200 shadow-float opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 p-2.5 z-50">
                {link.dropdown.map((sub) => (
                  <a href={sub.href} class="block p-3 rounded-xl hover:bg-stone-50 transition-colors group/item">
                    <div class="text-sm font-semibold text-stone-800 group-hover/item:text-emerald-800">{sub.label}</div>
                    <div class="text-xs text-stone-400 mt-0.5">{sub.desc}</div>
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a href={link.href} class="px-3.5 py-2 text-sm font-medium text-stone-600 hover:text-stone-900 rounded-xl hover:bg-stone-100/80 transition-colors">
              {link.label}
            </a>
          )
        ))}
      </nav>

      <!-- Right Actions: Language Switcher & Crisp CTA -->
      <div class="flex items-center gap-3.5">
        
        <!-- Minimal Language Selector -->
        <div class="relative group">
          <button class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-stone-700 bg-stone-100/90 hover:bg-stone-200/80 border border-stone-200/80 rounded-xl transition-colors">
            <svg class="w-3.5 h-3.5 text-stone-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{languages[lang as keyof typeof languages] || 'English'}</span>
            <svg class="w-3 h-3 text-stone-400 group-hover:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute right-0 mt-2 w-36 rounded-2xl bg-white border border-stone-200 shadow-float opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 p-1.5 z-50">
            {Object.entries(languages).map(([key, label]) => (
              <a
                href={switchLanguageUrl(key)}
                class={`flex items-center justify-between px-3 py-2 text-xs rounded-xl transition-colors ${
                  lang === key ? 'bg-stone-900 text-white font-medium' : 'text-stone-700 hover:bg-stone-100'
                }`}
              >
                <span>{label}</span>
                {lang === key && <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>}
              </a>
            ))}
          </div>
        </div>

        <!-- Solid Minimalist Button -->
        <a
          href={`/${lang === 'en' ? '' : lang + '/'}contact`}
          class="hidden sm:inline-flex items-center justify-center px-4.5 py-2 text-sm font-medium rounded-xl bg-stone-900 text-white hover:bg-stone-800 shadow-sm transition-all hover:scale-[1.01]"
        >
          {t('nav.contact')}
        </a>

        <!-- Mobile Toggle -->
        <button id="mobile-menu-btn" class="lg:hidden p-2 text-stone-600 hover:text-stone-900 rounded-xl hover:bg-stone-100" aria-label="Toggle menu">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-stone-200 bg-white p-6 space-y-4">
    <a href={`/${lang === 'en' ? '' : lang + '/'}`} class="block text-base font-medium text-stone-900">{t('nav.home')}</a>
    <div class="text-xs font-semibold text-stone-400 uppercase tracking-wider">{t('nav.solutions')}</div>
    <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/ev-battery-passport`} class="block pl-3 text-sm text-stone-600 py-1">{t('nav.evBattery')}</a>
    <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/storage-battery-passport`} class="block pl-3 text-sm text-stone-600 py-1">{t('nav.storageBattery')}</a>
    <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/software-license`} class="block pl-3 text-sm text-stone-600 py-1">{t('nav.software')}</a>
    <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting`} class="block pl-3 text-sm text-stone-600 py-1">{t('nav.hosting')}</a>
    <div class="text-xs font-semibold text-stone-400 uppercase tracking-wider">{t('nav.platform')}</div>
    <a href={`/${lang === 'en' ? '' : lang + '/'}platform/carbon-footprint-engine`} class="block pl-3 text-sm text-stone-600 py-1">{t('nav.pcf')}</a>
    <a href={`/${lang === 'en' ? '' : lang + '/'}platform/gs1-qr-serialization`} class="block pl-3 text-sm text-stone-600 py-1">{t('nav.gs1')}</a>
    <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-battery-regulation-2023-1542`} class="block text-base font-medium text-stone-900">{t('nav.regulation')}</a>
    <a href={`/${lang === 'en' ? '' : lang + '/'}pricing`} class="block text-base font-medium text-stone-900">{t('nav.pricing')}</a>
    <a href={`/${lang === 'en' ? '' : lang + '/'}contact`} class="block text-center py-3 rounded-xl bg-stone-900 text-white font-medium text-sm mt-4">{t('nav.contact')}</a>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
