---
import { getLangFromUrl, useTranslations, languages } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;

function switchLanguageUrl(targetLang: string) {
  let path = currentPath;
  if (lang !== 'en') {
    path = path.replace(new RegExp(`^/${lang}(/|$)`), '/') || '/';
  }
  if (targetLang === 'en') {
    return path.endsWith('/') ? path : `${path}/`;
  }
  const cleanPath = path === '/' ? '/' : (path.endsWith('/') ? path : `${path}/`);
  return `/${targetLang}${cleanPath === '/' ? '/' : cleanPath}`;
}
---

<header class="sticky top-3 z-50 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto transition-all">
  
  <!-- Floating Centered Neomorphic Navbar Island -->
  <div class="bg-[#F0F4F8]/90 backdrop-blur-xl rounded-full px-5 sm:px-7 py-3 border border-white/80 shadow-[8px_8px_24px_rgba(209,217,230,0.7),-8px_-8px_24px_rgba(255,255,255,0.95)] flex items-center justify-between gap-4">
    
    <!-- Left: Brand Logo -->
    <a href={`/${lang === 'en' ? '' : lang + '/'}`} class="flex items-center flex-shrink-0 group">
      <img 
        src="/eudpp_logo_light.svg" 
        alt="EU DPP Provider" 
        class="h-9 sm:h-10 w-auto object-contain transition-transform group-hover:scale-[1.02]"
      />
    </a>

    <!-- Center: Clean Minimal Menu Items -->
    <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
      
      <!-- Solutions Dropdown -->
      <div class="relative group">
        <button class="px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-slate-700 hover:text-cyan-700 rounded-full hover:bg-white/60 transition-all flex items-center gap-1.5">
          <span>{t('nav.solutions')}</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-cyan-700 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute left-1/2 -translate-x-1/2 mt-3 w-84 rounded-2xl bg-[#F0F4F8]/95 backdrop-blur-xl border border-white/80 shadow-[10px_10px_30px_rgba(209,217,230,0.8),-10px_-10px_30px_rgba(255,255,255,0.95)] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 p-3 z-50">
          <a href={`/${lang === 'en' ? '' : lang + '/'}battery-passport/`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all border-b border-slate-200/50 mb-1">
            <div class="text-xs font-bold text-cyan-800 flex items-center justify-between">
              <span>Battery Passport Platform Hub</span>
              <span class="text-[10px] px-1.5 py-0.2 bg-cyan-100 text-cyan-800 rounded font-mono">Overview</span>
            </div>
            <div class="text-[11px] text-slate-500 mt-0.5">Core platform, carbon engine & data vault</div>
          </a>

          <a href={`/${lang === 'en' ? '' : lang + '/'}pilot-program/`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all border-b border-slate-200/50 mb-1">
            <div class="text-xs font-bold text-green-800 flex items-center justify-between">
              <span>Early Adopter Pilot Program</span>
              <span class="text-[10px] px-1.5 py-0.2 bg-green-100 text-green-800 rounded font-mono">2026-2027</span>
            </div>
            <div class="text-[11px] text-slate-500 mt-0.5">1-3 Pack models, sandbox & pre-validation</div>
          </a>

          <a href={`/${lang === 'en' ? '' : lang + '/'}portal-simulator/`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all border-b border-slate-200/50 mb-1">
            <div class="text-xs font-bold text-purple-800 flex items-center justify-between">
              <span>Portal Simulator</span>
              <span class="text-[10px] px-1.5 py-0.2 bg-purple-100 text-purple-800 rounded font-mono">Sandbox</span>
            </div>
            <div class="text-[11px] text-slate-500 mt-0.5">Interactive 7-domain data declaration simulator</div>
          </a>

          <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/ev-battery-passport/`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all">
            <div class="text-xs font-bold text-slate-900">{t('nav.evBattery')}</div>
            <div class="text-[11px] text-slate-500 mt-0.5">EV battery pack compliance & OEM linking</div>
          </a>
          
          <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/lmt-battery-passport/`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all">
            <div class="text-xs font-bold text-slate-900 flex items-center justify-between">
              <span>{t('nav.lmtBattery')}</span>
              <span class="text-[10px] px-1.5 py-0.2 bg-cyan-100 text-cyan-800 rounded font-mono">E-Bike</span>
            </div>
            <div class="text-[11px] text-slate-500 mt-0.5">Light mobility & 2/3-wheeler traction packs</div>
          </a>

          <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/storage-battery-passport/`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all">
            <div class="text-xs font-bold text-slate-900">{t('nav.storageBattery')}</div>
            <div class="text-[11px] text-slate-500 mt-0.5">Industrial & stationary BESS (>2kWh)</div>
          </a>
          <div class="my-1.5 border-t border-slate-200/60"></div>
          <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/software-license/`} class="block p-2.5 rounded-xl hover:bg-cyan-100/40 transition-all">
            <div class="text-xs font-bold text-cyan-800 flex items-center justify-between">
              <span>{t('nav.software')}</span>
              <span class="text-[10px] px-1.5 py-0.5 bg-cyan-200/70 text-cyan-800 rounded font-mono">On-Prem</span>
            </div>
          </a>
          <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting/`} class="block p-2.5 rounded-xl hover:bg-green-100/40 transition-all">
            <div class="text-xs font-bold text-green-800 flex items-center justify-between">
              <span>{t('nav.hosting')}</span>
              <span class="text-[10px] px-1.5 py-0.5 bg-green-200/70 text-green-800 rounded font-mono">10-Yr SLA</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Compliance Dropdown -->
      <div class="relative group">
        <button class="px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-slate-700 hover:text-cyan-700 rounded-full hover:bg-white/60 transition-all flex items-center gap-1.5">
          <span>Regulation & Standards</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-cyan-700 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute left-1/2 -translate-x-1/2 mt-3 w-80 rounded-2xl bg-[#F0F4F8]/95 backdrop-blur-xl border border-white/80 shadow-[10px_10px_30px_rgba(209,217,230,0.8),-10px_-10px_30px_rgba(255,255,255,0.95)] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 p-3 z-50">
          <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-battery-regulation-2023-1542/`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all">
            <div class="text-xs font-bold text-slate-900">{t('nav.regulation')}</div>
            <div class="text-[11px] text-slate-500 mt-0.5">Articles 77-78 mandates & timeline</div>
          </a>
          <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/data-requirements/`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all">
            <div class="text-xs font-bold text-cyan-800 flex items-center justify-between">
              <span>90+ Data Requirements</span>
              <span class="text-[10px] px-1.5 py-0.5 bg-cyan-100 text-cyan-800 rounded font-mono">Annex XIII</span>
            </div>
            <div class="text-[11px] text-slate-500 mt-0.5">Full field checklist & role access tiers</div>
          </a>
          <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/en-standards-guide/`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all">
            <div class="text-xs font-bold text-slate-900">EN 18220 / 18219 Guide</div>
            <div class="text-[11px] text-slate-500 mt-0.5">Laser marking, 2D QR specs & UPI</div>
          </a>
          <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-dpp-registry-guide/`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all">
            <div class="text-xs font-bold text-slate-900">{t('nav.registry')}</div>
            <div class="text-[11px] text-slate-500 mt-0.5">DG GROW EU Central Registry filing</div>
          </a>
        </div>
      </div>

      <!-- Technology Dropdown -->
      <div class="relative group">
        <button class="px-3.5 py-2 text-xs font-bold uppercase tracking-wider text-slate-700 hover:text-cyan-700 rounded-full hover:bg-white/60 transition-all flex items-center gap-1.5">
          <span>{t('nav.platform')}</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-cyan-700 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute left-1/2 -translate-x-1/2 mt-3 w-72 rounded-2xl bg-[#F0F4F8]/95 backdrop-blur-xl border border-white/80 shadow-[10px_10px_30px_rgba(209,217,230,0.8),-10px_-10px_30px_rgba(255,255,255,0.95)] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 p-3 z-50">
          <a href={`/${lang === 'en' ? '' : lang + '/'}platform/carbon-footprint-engine/`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all">
            <div class="text-xs font-bold text-slate-900">{t('nav.pcf')}</div>
            <div class="text-[11px] text-slate-500 mt-0.5">PEFCR Scope 1-3 lifecycle emission calculation</div>
          </a>
          <a href={`/${lang === 'en' ? '' : lang + '/'}platform/gs1-qr-serialization/`} class="block p-2.5 rounded-xl hover:bg-white/70 transition-all">
            <div class="text-xs font-bold text-slate-900">{t('nav.gs1')}</div>
            <div class="text-[11px] text-slate-500 mt-0.5">Laser-marked 2D QR codes & resolver</div>
          </a>
        </div>
      </div>

      <!-- Single Links -->
      <a href={`/${lang === 'en' ? '' : lang + '/'}about/`} class="px-3 py-2 text-xs font-bold uppercase tracking-wider text-slate-700 hover:text-cyan-700 rounded-full hover:bg-white/60 transition-all">
        {t('nav.about')}
      </a>

      <a href={`/${lang === 'en' ? '' : lang + '/'}pricing/`} class="px-3 py-2 text-xs font-bold uppercase tracking-wider text-slate-700 hover:text-cyan-700 rounded-full hover:bg-white/60 transition-all">
        {t('nav.pricing')}
      </a>

    </nav>

    <!-- Right: Language Switcher & Contact Button -->
    <div class="flex items-center gap-2 sm:gap-3">
      
      <!-- Language Dropdown -->
      <div class="relative group">
        <button class="px-3 py-1.5 rounded-full text-xs font-medium text-slate-700 bg-white/70 hover:bg-white border border-slate-200/90 shadow-sm flex items-center gap-1.5 transition-all">
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
          <span class="font-bold">{languages[lang]}</span>
          <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div class="absolute right-0 mt-2 w-36 rounded-2xl bg-[#F0F4F8]/95 backdrop-blur-xl border border-white/80 shadow-[8px_8px_24px_rgba(209,217,230,0.8),-8px_-8px_24px_rgba(255,255,255,0.95)] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 p-2 z-50">
          {Object.entries(languages).map(([key, label]) => (
            <a
              href={switchLanguageUrl(key)}
              class={`block px-3 py-1.5 rounded-xl text-xs font-medium transition-colors ${
                lang === key
                  ? 'bg-cyan-600 text-white font-bold'
                  : 'text-slate-700 hover:bg-white/80'
              }`}
            >
              {label}
            </a>
          ))}
        </div>
      </div>

      <!-- Action Button -->
      <a
        href={`/${lang === 'en' ? '' : lang + '/'}contact/`}
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2 rounded-full bg-cyan-700 hover:bg-cyan-800 text-white text-xs font-bold shadow-md hover:shadow-lg transition-all hover:scale-[1.02]"
      >
        <span>{t('hero.cta.primary')}</span>
        <span>→</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-full text-slate-700 hover:bg-white/60 focus:outline-none"
        aria-label="Toggle Menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>

    </div>

  </div>

  <!-- Mobile Drawer Menu -->
  <div 
    id="mobile-menu"
    class="md:hidden hidden mt-3 p-5 rounded-3xl bg-[#F0F4F8]/95 backdrop-blur-2xl border border-white/80 shadow-2xl space-y-4"
  >
    <div class="space-y-2 text-xs font-bold text-slate-800">
      <div class="text-[10px] uppercase tracking-wider text-slate-400 font-mono">Solutions</div>
      <a href={`/${lang === 'en' ? '' : lang + '/'}battery-passport/`} class="block py-1.5 px-3 rounded-lg hover:bg-white">Battery Passport Hub</a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}pilot-program/`} class="block py-1.5 px-3 rounded-lg hover:bg-white text-green-800 font-bold">Early Adopter Pilot Program</a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/ev-battery-passport/`} class="block py-1.5 px-3 rounded-lg hover:bg-white">{t('nav.evBattery')}</a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/lmt-battery-passport/`} class="block py-1.5 px-3 rounded-lg hover:bg-white">{t('nav.lmtBattery')}</a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/storage-battery-passport/`} class="block py-1.5 px-3 rounded-lg hover:bg-white">{t('nav.storageBattery')}</a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/software-license/`} class="block py-1.5 px-3 rounded-lg hover:bg-white">{t('nav.software')}</a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting/`} class="block py-1.5 px-3 rounded-lg hover:bg-white">{t('nav.hosting')}</a>

      <div class="text-[10px] uppercase tracking-wider text-slate-400 font-mono pt-2">Regulation & Standards</div>
      <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-battery-regulation-2023-1542/`} class="block py-1.5 px-3 rounded-lg hover:bg-white">{t('nav.regulation')}</a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/data-requirements/`} class="block py-1.5 px-3 rounded-lg hover:bg-white">90+ Data Requirements</a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/en-standards-guide/`} class="block py-1.5 px-3 rounded-lg hover:bg-white">EN 18220 / 18219 Standards</a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-dpp-registry-guide/`} class="block py-1.5 px-3 rounded-lg hover:bg-white">{t('nav.registry')}</a>

      <div class="text-[10px] uppercase tracking-wider text-slate-400 font-mono pt-2">Technology & Platform</div>
      <a href={`/${lang === 'en' ? '' : lang + '/'}platform/carbon-footprint-engine/`} class="block py-1.5 px-3 rounded-lg hover:bg-white">{t('nav.pcf')}</a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}platform/gs1-qr-serialization/`} class="block py-1.5 px-3 rounded-lg hover:bg-white">{t('nav.gs1')}</a>

      <div class="text-[10px] uppercase tracking-wider text-slate-400 font-mono pt-2">Company & Commercial</div>
      <a href={`/${lang === 'en' ? '' : lang + '/'}about/`} class="block py-1.5 px-3 rounded-lg hover:bg-white">{t('nav.about')}</a>
      <a href={`/${lang === 'en' ? '' : lang + '/'}pricing/`} class="block py-1.5 px-3 rounded-lg hover:bg-white">{t('nav.pricing')}</a>
    </div>

    <div class="pt-2 border-t border-slate-200">
      <a
        href={`/${lang === 'en' ? '' : lang + '/'}contact/`}
        class="block w-full py-2.5 rounded-xl bg-cyan-700 text-white text-xs font-bold text-center shadow-md"
      >
        {t('hero.cta.primary')} →
      </a>
    </div>
  </div>

</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
      });
    }
  });
</script>
