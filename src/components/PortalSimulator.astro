  </div>

  <!-- Simulated Output Card (Appears after clicking Publish) -->
  <div id="sim-output-card" class="mt-8 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-navy-900 to-slate-900 text-white shadow-2xl border border-cyan-500/40 hidden space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-white/10">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-green-400 animate-pulse"></span>
        <h4 class="text-base font-bold text-cyan-400 font-mono">{tLocal.qrTitle}</h4>
      </div>
      <span class="px-2.5 py-0.5 rounded-full bg-green-500/20 text-green-300 text-[10px] font-mono border border-green-500/30">
        {tLocal.registryReady}
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-center text-xs">
      <div class="space-y-2">
        <div class="text-slate-400 font-mono text-[11px]">Resolver URI (GS1 Digital Link Syntax):</div>
        <div id="out-resolver-uri" class="p-3 rounded-xl bg-black/40 font-mono text-cyan-300 font-bold break-all border border-cyan-500/30">
          https://eudppprovider.com/01/04012345999991/21/BP-2027-EU-88902/
        </div>
        <div class="text-slate-400 font-mono text-[11px] pt-1">
          DG GROW Central Registry Anchor: <span class="text-green-400 font-bold">UPI-EU-2026-88902-BAT</span>
        </div>
      </div>

      <div class="p-4 rounded-xl bg-white/10 border border-white/10 text-center space-y-2">
        <div class="text-[11px] text-slate-300 font-mono">2D Barcode Data Carrier Ready (EN 18220:2026)</div>
        <a id="out-link-btn" href="/01/04012345999991/21/BP-2027-EU-88902/" class="inline-block px-5 py-2.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-xs transition-all shadow-md">
          Open Live GS1 Resolver Preview →
        </a>
      </div>
