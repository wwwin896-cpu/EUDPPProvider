const tLocal = translations[lang as keyof typeof translations] || translations.en;
---

<div class="neo-surface p-6 sm:p-10 border border-white/80 shadow-2xl rounded-3xl">
  
  <!-- Simulator Top Bar (Enterprise Console Look) -->
  <div class="neo-well p-4 sm:p-5 flex flex-wrap items-center justify-between gap-4 mb-8">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-cyan-600 to-blue-700 text-white flex items-center justify-center font-bold text-lg shadow-md">
        ⚡
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-sm font-bold text-slate-900">EU DPP Enterprise Management Console</span>
          <span class="px-2 py-0.5 rounded-full bg-cyan-100 text-cyan-800 text-[10px] font-mono font-bold">Sandbox Mode</span>
        </div>
        <div class="text-[11px] text-slate-500 font-mono mt-0.5">
          Tenant: <span class="text-slate-800 font-medium">SUZHOU GEEKTION TECH / OEM-NODE-01</span> · Session ID: <span class="text-cyan-700 font-bold">#SBX-2026-DPP</span>
        </div>
      </div>
    </div>

    <!-- Preset Selector Buttons -->
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="text-slate-500 text-[11px] font-bold mr-1 hidden sm:inline">{tLocal.presetLabel}</span>
      <button onclick="loadPreset('ev')" class="px-3 py-1.5 rounded-xl bg-white/90 border border-slate-200 text-slate-800 font-medium hover:border-cyan-500 hover:text-cyan-700 transition-all shadow-sm">
        {tLocal.presetEV}
      </button>
      <button onclick="loadPreset('bess')" class="px-3 py-1.5 rounded-xl bg-white/90 border border-slate-200 text-slate-800 font-medium hover:border-green-500 hover:text-green-700 transition-all shadow-sm">
        {tLocal.presetBESS}
      </button>
      <button onclick="loadPreset('lmt')" class="px-3 py-1.5 rounded-xl bg-white/90 border border-slate-200 text-slate-800 font-medium hover:border-purple-500 hover:text-purple-700 transition-all shadow-sm">
        {tLocal.presetLMT}
      </button>
    </div>
  </div>

  <!-- Step Navigation Tabs (7 Statutory Domains) -->
  <div class="flex overflow-x-auto gap-2 pb-2 mb-6 scrollbar-thin">
    <button id="sim-tab-1" onclick="switchSimTab(1)" class="sim-tab-btn neo-pill-active px-4 py-2.5 rounded-2xl text-xs font-bold whitespace-nowrap">
      {tLocal.tab1}
    </button>
    <button id="sim-tab-2" onclick="switchSimTab(2)" class="sim-tab-btn neo-pill px-4 py-2.5 rounded-2xl text-xs font-bold text-slate-700 whitespace-nowrap">
      {tLocal.tab2}
    </button>
    <button id="sim-tab-3" onclick="switchSimTab(3)" class="sim-tab-btn neo-pill px-4 py-2.5 rounded-2xl text-xs font-bold text-slate-700 whitespace-nowrap">
      {tLocal.tab3}
    </button>
    <button id="sim-tab-4" onclick="switchSimTab(4)" class="sim-tab-btn neo-pill px-4 py-2.5 rounded-2xl text-xs font-bold text-slate-700 whitespace-nowrap">
      {tLocal.tab4}
    </button>
    <button id="sim-tab-5" onclick="switchSimTab(5)" class="sim-tab-btn neo-pill px-4 py-2.5 rounded-2xl text-xs font-bold text-slate-700 whitespace-nowrap">
      {tLocal.tab5}
    </button>
    <button id="sim-tab-6" onclick="switchSimTab(6)" class="sim-tab-btn neo-pill px-4 py-2.5 rounded-2xl text-xs font-bold text-slate-700 whitespace-nowrap">
      {tLocal.tab6}
    </button>
    <button id="sim-tab-7" onclick="switchSimTab(7)" class="sim-tab-btn neo-pill px-4 py-2.5 rounded-2xl text-xs font-bold text-slate-700 whitespace-nowrap">
      {tLocal.tab7}
    </button>
  </div>

  <!-- Form Content Area -->
  <div class="p-6 sm:p-8 rounded-2xl bg-white/80 border border-slate-200/90 shadow-sm min-h-[380px]">
    
    <!-- Tab 1: Identity & UPI -->
    <div id="sim-view-1" class="sim-view space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200">
        <div>
          <h4 class="text-base font-bold text-slate-900">Domain 1: Battery Product Identification & GS1 Serialization</h4>
          <p class="text-xs text-slate-500">Mandatory attributes under Annex XIII, Section 1 (EN 18220 / EN 18219 UPI standards).</p>
        </div>
        <span class="px-2.5 py-1 rounded-full bg-green-100 text-green-800 text-[10px] font-mono font-bold">Rule: Mandatory (Public)</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Global Trade Item Number (GTIN-14)</label>
          <input id="field-gtin" type="text" value="04012345999991" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-slate-900 bg-white" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Unique Serial Identifier (SGTIN / SN)</label>
          <input id="field-serial" type="text" value="BP-2027-EU-88902" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-slate-900 bg-white" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Battery Category</label>
          <select id="field-category" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-slate-900 bg-white font-medium">
            <option value="EV">Electric Vehicle (EV) Traction Battery</option>
            <option value="BESS">Stationary Energy Storage System (BESS >2kWh)</option>
            <option value="LMT">Light Means of Transport (LMT ≤25kg)</option>
            <option value="Industrial">Other Industrial Battery (>2kWh)</option>
          </select>
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Model & Trade Name</label>
          <input id="field-model" type="text" value="High-Energy NMC 811 Traction Battery System" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-slate-900 bg-white" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Manufacturing Location</label>
          <input id="field-factory" type="text" value="Jiangsu Giga-Factory #02 · China" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-slate-900 bg-white" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Manufacturing Date</label>
          <input id="field-mfg-date" type="text" value="2026-10-15" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-slate-900 bg-white" />
        </div>
      </div>
    </div>

    <!-- Tab 2: Materials & Chemistry -->
    <div id="sim-view-2" class="sim-view hidden space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200">
        <div>
          <h4 class="text-base font-bold text-slate-900">Domain 2: Material Chemistry, Critical Raw Materials & Recycled Share</h4>
          <p class="text-xs text-slate-500">Recycled content targets (Article 8) & Critical Raw Materials declaration.</p>
        </div>
        <span class="px-2.5 py-1 rounded-full bg-purple-100 text-purple-800 text-[10px] font-mono font-bold">ZKP Formula Protection</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Cathode Chemistry</label>
          <input id="field-chemistry" type="text" value="NMC 811 (LiNi0.8Mn0.1Co0.1O2)" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-slate-900 bg-white" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Recycled Cobalt (Co) %</label>
          <input id="field-recycled-co" type="text" value="18.4%" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-cyan-700 font-bold bg-white" />
          <span class="text-[10px] text-slate-400">2031 Mandatory: ≥16%</span>
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Recycled Lithium (Li) %</label>
          <input id="field-recycled-li" type="text" value="8.2%" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-blue-700 font-bold bg-white" />
          <span class="text-[10px] text-slate-400">2031 Mandatory: ≥6%</span>
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Recycled Nickel (Ni) %</label>
          <input id="field-recycled-ni" type="text" value="12.5%" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-green-700 font-bold bg-white" />
          <span class="text-[10px] text-slate-400">2031 Mandatory: ≥6%</span>
        </div>
      </div>

      <div class="p-3.5 rounded-xl bg-purple-50/70 border border-purple-200 text-xs text-purple-900 flex items-center justify-between">
        <span>🛡️ <strong>Zero-Knowledge Cryptographic Shield:</strong> Raw supplier pricing and binder additives remain private; only proof of compliance is published.</span>
        <span class="font-mono text-purple-700 font-bold">ZKP-Active</span>
      </div>
    </div>

    <!-- Tab 3: Carbon Footprint (PCF) -->
    <div id="sim-view-3" class="sim-view hidden space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200">
        <div>
          <h4 class="text-base font-bold text-slate-900">Domain 3: Product Carbon Footprint (PCF) & Due Diligence</h4>
          <p class="text-xs text-slate-500">ISO 14067 / PEFCR Scope 1-3 lifecycle carbon intensity & performance class.</p>
        </div>
        <span class="px-2.5 py-1 rounded-full bg-green-100 text-green-800 text-[10px] font-mono font-bold">Class A-E Label</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Total Carbon Footprint (kg CO₂e/kWh)</label>
          <input id="field-pcf" type="text" value="51.2" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-green-700 font-extrabold text-base bg-white" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Carbon Performance Class</label>
          <select id="field-pcf-class" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-slate-900 bg-white font-bold">
            <option value="A" selected>Class A (Top 15% Carbon Efficiency)</option>
            <option value="B">Class B</option>
            <option value="C">Class C</option>
            <option value="D">Class D</option>
            <option value="E">Class E</option>
          </select>
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">LCA Verification Standard</label>
          <input type="text" readonly value="ISO 14067 & EU PEFCR Baseline" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-slate-500 bg-slate-50" />
        </div>
      </div>
    </div>

    <!-- Tab 4: Performance & Durability -->
    <div id="sim-view-4" class="sim-view hidden space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200">
        <div>
          <h4 class="text-base font-bold text-slate-900">Domain 4: Performance, Durability & Electrical Characteristics</h4>
          <p class="text-xs text-slate-500">Rated energy, round-trip efficiency, and calendar/cycle life benchmarks.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Rated Usable Energy (kWh)</label>
          <input id="field-energy" type="text" value="82.0" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-slate-900 bg-white" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Nominal Voltage (V)</label>
          <input id="field-voltage" type="text" value="800" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-slate-900 bg-white" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Expected Cycle Life (80% SOH)</label>
          <input id="field-cycles" type="text" value="3,500 Cycles" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-slate-900 bg-white" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Round-trip Energy Efficiency</label>
          <input id="field-efficiency" type="text" value="95.4%" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-slate-900 bg-white" />
        </div>
      </div>
    </div>

    <!-- Tab 5: BMS Telematics -->
    <div id="sim-view-5" class="sim-view hidden space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200">
        <div>
          <h4 class="text-base font-bold text-slate-900">Domain 5: Dynamic BMS Telematics & State of Health (SOH)</h4>
          <p class="text-xs text-slate-500">Live API ingestion for in-use parameters under Article 78.</p>
        </div>
        <span class="px-2.5 py-1 rounded-full bg-blue-100 text-blue-800 text-[10px] font-mono font-bold">API Ingestion Ready</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Current State of Health (SOH %)</label>
          <input id="field-soh" type="text" value="99.1%" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-cyan-800 font-bold bg-white" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Equivalent Full Cycles (EFC)</label>
          <input id="field-efc" type="text" value="68 cycles" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-slate-900 bg-white" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Internal Resistance Rise (%)</label>
          <input id="field-resistance" type="text" value="+0.4%" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-slate-900 bg-white" />
        </div>
      </div>
    </div>

    <!-- Tab 6: Safety & Dismantling -->
    <div id="sim-view-6" class="sim-view hidden space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200">
        <div>
          <h4 class="text-base font-bold text-slate-900">Domain 6: Dismantling Safety, Extinguishing Agents & Waste Guidance</h4>
          <p class="text-xs text-slate-500">Role-based access view for certified dismantling and recycling operators.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Recommended Extinguishing Agent</label>
          <input id="field-extinguish" type="text" value="Copious Water / F-500 Encapsulator" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-slate-900 bg-white" />
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Enclosure Dismantling Fasteners</label>
          <input id="field-fasteners" type="text" value="24x M8 Torx Plus (Torque: 28 Nm)" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-slate-900 bg-white" />
        </div>
      </div>
    </div>

    <!-- Tab 7: eIDAS QSeal & Filing -->
    <div id="sim-view-7" class="sim-view hidden space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-slate-200">
        <div>
          <h4 class="text-base font-bold text-slate-900">Domain 7: Conformity Dossier (DoC) & eIDAS 2.0 Qualified Seal</h4>
          <p class="text-xs text-slate-500">Attach EU Declaration of Conformity and trigger PAdES digital seal.</p>
        </div>
        <span class="px-2.5 py-1 rounded-full bg-green-100 text-green-800 text-[10px] font-mono font-bold">eIDAS 2.0 QSeal</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div>
          <label class="block font-bold text-slate-700 mb-1">EU Declaration of Conformity (DoC File)</label>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between font-mono">
            <span>DOC-2023-1542-APEX-SIGNED.pdf</span>
            <span class="text-green-700 font-bold">✓ Attached</span>
          </div>
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1">Qualified Trust Service Provider (QTSP)</label>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between font-mono">
            <span>D-Trust / DigiCert EU Trust List</span>
            <span class="text-cyan-700 font-bold">QES Active</span>
