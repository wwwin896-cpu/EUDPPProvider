---

<div class="neo-surface p-6 sm:p-10 border border-white/80 shadow-2xl rounded-3xl">
  
  <!-- Top Scenario Presets Switcher -->
  <div class="neo-well p-4 sm:p-5 flex flex-wrap items-center justify-between gap-4 mb-8">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-cyan-600 to-blue-700 text-white flex items-center justify-center font-bold text-lg shadow-md">
        ⚡
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-sm font-bold text-slate-900">EU DPP Enterprise Generator Console</span>
          <span class="px-2 py-0.5 rounded-full bg-cyan-100 text-cyan-800 text-[10px] font-mono font-bold">Live Synced</span>
        </div>
        <div class="text-[11px] text-slate-500 font-mono mt-0.5">
          {tLocal.syncNotice}
        </div>
      </div>
    </div>

    <!-- Quick Buttons -->
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="text-slate-500 text-[11px] font-bold mr-1 hidden sm:inline">{tLocal.presetLabel}</span>
      <button onclick="applyPreset('ev')" class="preset-btn px-3 py-1.5 rounded-xl bg-white/90 border border-slate-300 text-slate-800 font-bold hover:border-cyan-500 hover:text-cyan-700 transition-all shadow-sm">
        {tLocal.presetEV}
      </button>
      <button onclick="applyPreset('bess')" class="preset-btn px-3 py-1.5 rounded-xl bg-white/90 border border-slate-300 text-slate-800 font-bold hover:border-green-500 hover:text-green-700 transition-all shadow-sm">
        {tLocal.presetBESS}
      </button>
      <button onclick="applyPreset('lmt')" class="preset-btn px-3 py-1.5 rounded-xl bg-white/90 border border-slate-300 text-slate-800 font-bold hover:border-purple-500 hover:text-purple-700 transition-all shadow-sm">
        {tLocal.presetLMT}
      </button>
    </div>
  </div>

  <!-- Main Split-Screen Layout: Left Input, Right Mobile Passport Output -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Left Column: Simple & Clear Enterprise Input Terminal (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      
      <div class="flex items-center justify-between pb-3 border-b border-slate-200">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-cyan-500"></span>
          <h3 class="text-base font-bold text-slate-900">{tLocal.leftHeader}</h3>
        </div>
        <span class="text-[11px] font-mono text-cyan-700 font-bold bg-cyan-50 px-2.5 py-1 rounded-lg border border-cyan-200">
          Annex XIII Ready
        </span>
      </div>

      <!-- Section 1: Identity -->
      <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center justify-between">
          <span>{tLocal.groupGeneral}</span>
          <span class="text-[10px] text-green-700 font-mono">Public Verified</span>
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Product / Model Name</label>
            <input id="in-model" type="text" value="Apex HyperDrive Traction Battery" oninput="updateLivePassport()" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-slate-900 bg-slate-50 focus:bg-white focus:border-cyan-500 outline-none" />
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Unique Serial (SGTIN / SN)</label>
            <input id="in-serial" type="text" value="BP-2027-EU-88902" oninput="updateLivePassport()" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-slate-900 bg-slate-50 focus:bg-white focus:border-cyan-500 outline-none" />
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Global Trade Item Number (GTIN-14)</label>
            <input id="in-gtin" type="text" value="04012345999991" oninput="updateLivePassport()" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-slate-900 bg-slate-50 focus:bg-white focus:border-cyan-500 outline-none" />
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Battery Category</label>
            <select id="in-category" onchange="updateLivePassport()" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-slate-900 bg-slate-50 focus:bg-white focus:border-cyan-500 outline-none font-medium">
              <option value="Electric Vehicle (EV) · Category M1/N1">Electric Vehicle (EV) Traction</option>
              <option value="Industrial Energy Storage (BESS >2kWh)">Stationary Storage (BESS >2kWh)</option>
              <option value="Light Means of Transport (LMT ≤25kg)">LMT / E-Bike Pack (≤25kg)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Section 2: Chemistry & Recycled -->
      <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center justify-between">
          <span>{tLocal.groupChem}</span>
          <span class="text-[10px] text-purple-700 font-mono">ZKP Shielded</span>
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Cathode Chemistry</label>
            <select id="in-chemistry" onchange="updateLivePassport()" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-slate-900 bg-slate-50 focus:bg-white focus:border-cyan-500 outline-none font-medium">
              <option value="NMC 811 (LiNi0.8Mn0.1Co0.1O2)">NMC 811</option>
              <option value="LFP (Lithium Iron Phosphate)">LFP (Iron Phosphate)</option>
              <option value="Sodium-ion (Na-ion)">Sodium-ion</option>
              <option value="NMC 622">NMC 622</option>
            </select>
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Recycled Cobalt (Co) %</label>
            <input id="in-co" type="text" value="18.4%" oninput="updateLivePassport()" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-cyan-700 font-bold bg-slate-50 focus:bg-white focus:border-cyan-500 outline-none" />
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Recycled Lithium (Li) %</label>
            <input id="in-li" type="text" value="8.2%" oninput="updateLivePassport()" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-blue-700 font-bold bg-slate-50 focus:bg-white focus:border-cyan-500 outline-none" />
          </div>
        </div>
      </div>

      <!-- Section 3: Carbon Footprint (PCF) & Durability -->
      <div class="p-5 rounded-2xl bg-white border border-slate-200/90 shadow-sm space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center justify-between">
          <span>{tLocal.groupPcf}</span>
          <span class="text-[10px] text-green-700 font-mono">ISO 14067 LCA</span>
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Carbon Intensity (kg CO₂e/kWh)</label>
            <input id="in-pcf" type="text" value="51.2" oninput="updateLivePassport()" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-green-700 font-extrabold text-sm bg-slate-50 focus:bg-white focus:border-cyan-500 outline-none" />
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Carbon Class Label</label>
            <select id="in-pcf-class" onchange="updateLivePassport()" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-bold text-slate-900 bg-slate-50 focus:bg-white focus:border-cyan-500 outline-none">
              <option value="A" selected>Class A (Top 15%)</option>
              <option value="B">Class B</option>
              <option value="C">Class C</option>
              <option value="D">Class D</option>
              <option value="E">Class E</option>
            </select>
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">State of Health (SOH %)</label>
            <input id="in-soh" type="text" value="99.2%" oninput="updateLivePassport()" class="w-full px-3 py-2 rounded-xl border border-slate-300 font-mono text-cyan-800 font-bold bg-slate-50 focus:bg-white focus:border-cyan-500 outline-none" />
          </div>
        </div>
      </div>

      <!-- Action Footer -->
      <div class="p-4 rounded-2xl bg-cyan-50/70 border border-cyan-200 flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="space-y-0.5">
          <div class="font-bold text-slate-900 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-green-500"></span>
            <span>{tLocal.eidasValid}</span>
          </div>
          <div class="text-[11px] text-slate-500 font-mono">{tLocal.zkpProtected}</div>
        </div>
        <a id="btn-open-full" href="/01/04012345999991/21/BP-2027-EU-88902/" target="_blank" class="neo-btn-primary text-xs py-2 px-4 flex items-center gap-1.5">
          <span>{tLocal.openFullBtn}</span>
        </a>
      </div>

    </div>

    <!-- Right Column: Live Mobile Battery Passport Visual Terminal (5 cols) -->
    <div class="lg:col-span-5">
      
      <div class="flex items-center justify-between pb-3 border-b border-slate-200 mb-4">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-green-500 animate-pulse"></span>
          <h3 class="text-base font-bold text-slate-900">{tLocal.rightHeader}</h3>
        </div>
        <span class="text-[10px] font-mono text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
          GS1 2D Data Matrix
        </span>
      </div>

      <!-- Realistic Smartphone Mockup -->
      <div class="max-w-[360px] mx-auto rounded-[36px] bg-slate-900 p-3.5 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.3)] border-4 border-slate-800 relative">
        
        <!-- Phone Camera Notch / Speaker -->
        <div class="w-24 h-4 bg-slate-800 rounded-full mx-auto mb-2 flex items-center justify-center">
          <div class="w-2 h-2 rounded-full bg-slate-900 mr-2"></div>
          <div class="w-8 h-1 bg-slate-900 rounded-full"></div>
        </div>

        <!-- Phone Screen Content (Light Theme Battery Passport) -->
        <div class="rounded-[26px] bg-[#F8FAFC] p-4 text-slate-800 space-y-3.5 max-h-[580px] overflow-y-auto scrollbar-thin">
          
          <!-- Screen Header -->
          <div class="flex items-center justify-between pb-2 border-b border-slate-200">
            <div class="flex items-center gap-1.5">
              <span class="text-base">🇪🇺</span>
              <span class="text-[10px] font-extrabold uppercase tracking-tight text-slate-900">EU Digital Battery Passport</span>
            </div>
            <span class="px-1.5 py-0.2 rounded bg-green-100 text-green-800 text-[9px] font-mono font-bold">REG-2023/1542</span>
          </div>

          <!-- Product Title & Serial Pill -->
          <div class="bg-white p-3 rounded-2xl border border-slate-200 shadow-sm space-y-1.5">
            <div class="text-[10px] font-mono text-cyan-700 font-bold flex items-center justify-between">
              <span id="disp-category">Electric Vehicle (EV) · Category M1</span>
              <span class="text-slate-400 font-mono text-[9px]">SGTIN</span>
            </div>
            <div id="disp-model" class="text-xs font-bold text-slate-900 leading-snug">
              Apex HyperDrive Traction Battery
            </div>
            <div class="flex items-center gap-1 text-[10px] font-mono text-slate-500 bg-slate-50 p-1.5 rounded-lg border border-slate-100 break-all">
              <span class="text-slate-400">SN:</span>
              <span id="disp-serial" class="text-slate-800 font-bold">BP-2027-EU-88902</span>
            </div>
          </div>

          <!-- Dynamic 2D QR Code & GS1 URI Box -->
          <div class="bg-white p-3 rounded-2xl border border-slate-200 shadow-sm text-center space-y-2">
            <div class="w-24 h-24 mx-auto bg-slate-50 border border-slate-200 rounded-xl flex items-center justify-center p-2 relative group">
              <!-- Visual Mock QR Matrix -->
              <svg viewBox="0 0 100 100" class="w-full h-full text-slate-900" fill="currentColor">
                <rect x="0" y="0" width="30" height="30" />
                <rect x="5" y="5" width="20" height="20" fill="white" />
                <rect x="10" y="10" width="10" height="10" />
                <rect x="70" y="0" width="30" height="30" />
                <rect x="75" y="5" width="20" height="20" fill="white" />
                <rect x="80" y="10" width="10" height="10" />
                <rect x="0" y="70" width="30" height="30" />
                <rect x="5" y="75" width="20" height="20" fill="white" />
                <rect x="10" y="80" width="10" height="10" />
                <rect x="35" y="10" width="10" height="10" />
                <rect x="50" y="20" width="10" height="15" />
                <rect x="35" y="45" width="30" height="10" />
                <rect x="45" y="65" width="15" height="15" />
                <rect x="70" y="40" width="20" height="10" />
                <rect x="75" y="70" width="15" height="20" />
              </svg>
            </div>
            <div class="text-[9px] font-mono text-cyan-800 break-all bg-slate-50 p-1.5 rounded-lg border border-slate-200">
              <span id="disp-uri">https://eudppprovider.com/01/04012345999991/21/BP-2027-EU-88902/</span>
            </div>
          </div>

          <!-- Live Compliance KPI Badges -->
          <div class="grid grid-cols-2 gap-2 text-center text-xs">
            <div class="bg-white p-2.5 rounded-xl border border-slate-200 shadow-sm">
              <div class="text-[9px] text-slate-400 font-mono uppercase">Carbon Rating</div>
              <div class="flex items-center justify-center gap-1 mt-0.5">
                <span id="disp-pcf-badge" class="px-2 py-0.2 rounded-full bg-green-100 text-green-800 font-extrabold text-xs">Class A</span>
              </div>
              <div id="disp-pcf" class="text-[10px] font-mono text-slate-600 mt-0.5">51.2 kg CO₂e/kWh</div>
            </div>

            <div class="bg-white p-2.5 rounded-xl border border-slate-200 shadow-sm">
              <div class="text-[9px] text-slate-400 font-mono uppercase">State of Health</div>
              <div id="disp-soh" class="text-xs font-bold text-cyan-800 mt-0.5">99.2% SOH</div>
              <div class="text-[9px] text-green-700 font-mono">BMS Nominal</div>
            </div>
          </div>

          <!-- Chemistry & Recycled Content Share -->
          <div class="bg-white p-3 rounded-2xl border border-slate-200 shadow-sm space-y-1.5 text-xs">
            <div class="text-[9px] font-mono text-slate-400 uppercase flex items-center justify-between">
              <span>Chemistry & Recycled Share</span>
              <span class="text-purple-700 font-bold">ZKP Valid</span>
            </div>
            <div id="disp-chemistry" class="font-bold text-[11px] text-slate-800 font-mono">
              NMC 811 (LiNi0.8Mn0.1Co0.1O2)
            </div>
            <div class="grid grid-cols-2 gap-1.5 text-[10px] pt-1">
              <div class="bg-slate-50 p-1.5 rounded border border-slate-100">
                <span class="text-slate-400">Recycled Co:</span>
                <span id="disp-co" class="font-bold text-cyan-800 ml-1">18.4%</span>
              </div>
              <div class="bg-slate-50 p-1.5 rounded border border-slate-100">
                <span class="text-slate-400">Recycled Li:</span>
                <span id="disp-li" class="font-bold text-blue-800 ml-1">8.2%</span>
              </div>
            </div>
          </div>

          <!-- eIDAS Seal Badge -->
          <div class="p-2 rounded-xl bg-green-50 border border-green-200 text-center">
            <div class="text-[9px] text-green-900 font-mono font-bold flex items-center justify-center gap-1">
              <span>🔒 eIDAS 2.0 Qualified Seal Verified</span>
            </div>
            <div class="text-[8px] text-green-700 font-mono mt-0.5">D-Trust QTSP · DG GROW Central Registry Anchored</div>
          </div>

        </div>

      </div>

    </div>

  </div>

</div>

<script is:inline>
  function updateLivePassport() {
    const model = document.getElementById('in-model')?.value || 'Battery System';
    const serial = document.getElementById('in-serial')?.value || 'SN-DEMO-001';
    const gtin = document.getElementById('in-gtin')?.value || '04012345999991';
    const category = document.getElementById('in-category')?.value || 'Electric Vehicle (EV)';
    const chemistry = document.getElementById('in-chemistry')?.value || 'NMC 811';
    const co = document.getElementById('in-co')?.value || '18.4%';
    const li = document.getElementById('in-li')?.value || '8.2%';
    const pcf = document.getElementById('in-pcf')?.value || '51.2';
    const pcfClass = document.getElementById('in-pcf-class')?.value || 'A';
    const soh = document.getElementById('in-soh')?.value || '99.2%';

    // Update screen elements
    const dispModel = document.getElementById('disp-model');
    const dispSerial = document.getElementById('disp-serial');
    const dispCategory = document.getElementById('disp-category');
    const dispChemistry = document.getElementById('disp-chemistry');
    const dispCo = document.getElementById('disp-co');
    const dispLi = document.getElementById('disp-li');
    const dispPcf = document.getElementById('disp-pcf');
    const dispPcfBadge = document.getElementById('disp-pcf-badge');
    const dispSoh = document.getElementById('disp-soh');
    const dispUri = document.getElementById('disp-uri');
    const btnOpenFull = document.getElementById('btn-open-full');

    const uri = `https://eudppprovider.com/01/${gtin}/21/${serial}/`;
    const localUri = `/01/${gtin}/21/${serial}/`;

    if (dispModel) dispModel.innerText = model;
    if (dispSerial) dispSerial.innerText = serial;
    if (dispCategory) dispCategory.innerText = category;
    if (dispChemistry) dispChemistry.innerText = chemistry;
    if (dispCo) dispCo.innerText = co;
    if (dispLi) dispLi.innerText = li;
    if (dispPcf) dispPcf.innerText = `${pcf} kg CO₂e/kWh`;
    if (dispPcfBadge) {
      dispPcfBadge.innerText = `Class ${pcfClass}`;
      if (pcfClass === 'A') {
        dispPcfBadge.className = 'px-2 py-0.2 rounded-full bg-green-100 text-green-800 font-extrabold text-xs';
      } else if (pcfClass === 'B') {
        dispPcfBadge.className = 'px-2 py-0.2 rounded-full bg-blue-100 text-blue-800 font-extrabold text-xs';
      } else {
        dispPcfBadge.className = 'px-2 py-0.2 rounded-full bg-amber-100 text-amber-800 font-extrabold text-xs';
      }
    }
    if (dispSoh) dispSoh.innerText = `${soh} SOH`;
    if (dispUri) dispUri.innerText = uri;
    if (btnOpenFull) btnOpenFull.href = localUri;
  }

  function applyPreset(type) {
    const inModel = document.getElementById('in-model');
    const inSerial = document.getElementById('in-serial');
    const inGtin = document.getElementById('in-gtin');
    const inCategory = document.getElementById('in-category');
    const inChemistry = document.getElementById('in-chemistry');
    const inCo = document.getElementById('in-co');
    const inLi = document.getElementById('in-li');
    const inPcf = document.getElementById('in-pcf');
    const inPcfClass = document.getElementById('in-pcf-class');
    const inSoh = document.getElementById('in-soh');

    if (type === 'ev') {
      if (inModel) inModel.value = 'Apex HyperDrive Traction Battery (82kWh)';
      if (inSerial) inSerial.value = 'BP-2027-EU-88902';
      if (inGtin) inGtin.value = '04012345999991';
      if (inCategory) inCategory.value = 'Electric Vehicle (EV) · Category M1/N1';
      if (inChemistry) inChemistry.value = 'NMC 811 (LiNi0.8Mn0.1Co0.1O2)';
      if (inCo) inCo.value = '18.4%';
      if (inLi) inLi.value = '8.2%';
      if (inPcf) inPcf.value = '51.2';
      if (inPcfClass) inPcfClass.value = 'A';
      if (inSoh) inSoh.value = '99.2%';
    } else if (type === 'bess') {
      if (inModel) inModel.value = 'GridVault Industrial BESS 372kWh Container';
      if (inSerial) inSerial.value = 'BESS-1500V-372KWH';
      if (inGtin) inGtin.value = '06978453010036';
      if (inCategory) inCategory.value = 'Industrial Energy Storage (BESS >2kWh)';
      if (inChemistry) inChemistry.value = 'LFP (Lithium Iron Phosphate)';
      if (inCo) inCo.value = '0.0% (Co-Free)';
      if (inLi) inLi.value = '11.5%';
      if (inPcf) inPcf.value = '42.1';
      if (inPcfClass) inPcfClass.value = 'A';
      if (inSoh) inSoh.value = '99.8%';
    } else if (type === 'lmt') {
      if (inModel) inModel.value = 'UrbanCommute 48V E-Bike Pack (750Wh)';
      if (inSerial) inSerial.value = 'LMT-48V-750WH-001';
      if (inGtin) inGtin.value = '06978453010029';
      if (inCategory) inCategory.value = 'Light Means of Transport (LMT ≤25kg)';
      if (inChemistry) inChemistry.value = 'NMC 622';
      if (inCo) inCo.value = '14.2%';
      if (inLi) inLi.value = '6.5%';
      if (inPcf) inPcf.value = '48.6';
      if (inPcfClass) inPcfClass.value = 'B';
      if (inSoh) inSoh.value = '98.5%';
    }

    updateLivePassport();
  }

  // Initialize live bindings on page load
  document.addEventListener('DOMContentLoaded', () => {
    updateLivePassport();
  });
</script>
