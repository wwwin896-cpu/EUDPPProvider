</div>

<script is:inline>
  function switchSimTab(tabNumber) {
    for (let i = 1; i <= 7; i++) {
      const view = document.getElementById(`sim-view-${i}`);
      const btn = document.getElementById(`sim-tab-${i}`);
      if (view && btn) {
        if (i === tabNumber) {
          view.classList.remove('hidden');
          btn.className = 'sim-tab-btn neo-pill-active px-4 py-2.5 rounded-2xl text-xs font-bold whitespace-nowrap';
        } else {
          view.classList.add('hidden');
          btn.className = 'sim-tab-btn neo-pill px-4 py-2.5 rounded-2xl text-xs font-bold text-slate-700 whitespace-nowrap';
        }
      }
    }
  }

  function loadPreset(type) {
    const gtin = document.getElementById('field-gtin');
    const serial = document.getElementById('field-serial');
    const category = document.getElementById('field-category');
    const model = document.getElementById('field-model');
    const chemistry = document.getElementById('field-chemistry');
    const pcf = document.getElementById('field-pcf');
    const energy = document.getElementById('field-energy');
    const voltage = document.getElementById('field-voltage');

    if (type === 'ev') {
      if (gtin) gtin.value = '04012345999991';
      if (serial) serial.value = 'BP-2027-EU-88902';
      if (category) category.value = 'EV';
      if (model) model.value = 'High-Energy NMC 811 Traction Battery System';
      if (chemistry) chemistry.value = 'NMC 811 (LiNi0.8Mn0.1Co0.1O2)';
      if (pcf) pcf.value = '51.2';
      if (energy) energy.value = '82.0';
      if (voltage) voltage.value = '800';
    } else if (type === 'bess') {
      if (gtin) gtin.value = '06978453010036';
      if (serial) serial.value = 'BESS-1500V-372KWH';
      if (category) category.value = 'BESS';
      if (model) model.value = 'Industrial Storage Container BESS 372kWh';
      if (chemistry) chemistry.value = 'LFP (Lithium Iron Phosphate)';
      if (pcf) pcf.value = '42.1';
      if (energy) energy.value = '372.0';
      if (voltage) voltage.value = '1500';
    } else if (type === 'lmt') {
      if (gtin) gtin.value = '06978453010029';
      if (serial) serial.value = 'LMT-48V-750WH-001';
      if (category) category.value = 'LMT';
      if (model) model.value = 'City Commuter E-Bike Battery Module';
      if (chemistry) chemistry.value = 'NMC 21700 Cylindrical Cells';
      if (pcf) pcf.value = '48.6';
      if (energy) energy.value = '0.75';
      if (voltage) voltage.value = '48';
    }
  }

  function publishSimPassport() {
    const gtin = document.getElementById('field-gtin')?.value || '04012345999991';
    const serial = document.getElementById('field-serial')?.value || 'BP-2027-EU-88902';
    
    const outputCard = document.getElementById('sim-output-card');
    const resolverUri = document.getElementById('out-resolver-uri');
    const linkBtn = document.getElementById('out-link-btn');

    const uri = `https://eudppprovider.com/01/${gtin}/21/${serial}/`;
    
    if (resolverUri) resolverUri.innerText = uri;
    if (linkBtn) linkBtn.href = `/01/${gtin}/21/${serial}/`;
    if (outputCard) {
      outputCard.classList.remove('hidden');
      outputCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }
</script>
