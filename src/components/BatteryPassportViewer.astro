---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="bg-white border border-stone-200/90 rounded-3xl overflow-hidden shadow-card">
  
  <!-- Top Mockup Device Header (Refined Apple/Minimal Style) -->
  <div class="bg-stone-50 px-6 sm:px-8 py-4 border-b border-stone-200/80 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1.5">
        <div class="w-2.5 h-2.5 rounded-full bg-stone-300"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-stone-300"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-stone-300"></div>
      </div>
      <div class="ml-2 font-mono text-xs text-stone-600 bg-white px-3.5 py-1.5 rounded-xl border border-stone-200/80 flex items-center gap-2 shadow-xs">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span class="truncate max-w-[280px] sm:max-w-md">https://id.eudppprovider.com/01/04012345678901/21/BP-2027-EU-88902</span>
      </div>
    </div>
    <div class="flex items-center gap-2 text-xs font-mono text-stone-500">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      GS1 Digital Link Verified
    </div>
  </div>

  <!-- Role View Selector Tabs (Minimalist Segmented Control) -->
  <div class="bg-stone-50/50 p-2 border-b border-stone-200/70 grid grid-cols-2 sm:grid-cols-4 gap-1.5">
    <button class="passport-tab-btn active px-4 py-2.5 rounded-xl text-xs font-semibold text-center transition-all bg-white text-stone-900 border border-stone-200 shadow-xs" data-target="view-public">
      🌐 {t('viewer.tab.public')}
    </button>
    <button class="passport-tab-btn px-4 py-2.5 rounded-xl text-xs font-semibold text-center transition-all text-stone-500 hover:text-stone-900 hover:bg-stone-100/80 border border-transparent" data-target="view-customs">
      🏛️ {t('viewer.tab.customs')}
    </button>
    <button class="passport-tab-btn px-4 py-2.5 rounded-xl text-xs font-semibold text-center transition-all text-stone-500 hover:text-stone-900 hover:bg-stone-100/80 border border-transparent" data-target="view-recycler">
      ♻️ {t('viewer.tab.recycler')}
    </button>
    <button class="passport-tab-btn px-4 py-2.5 rounded-xl text-xs font-semibold text-center transition-all text-stone-500 hover:text-stone-900 hover:bg-stone-100/80 border border-transparent" data-target="view-oem">
      ⚡ {t('viewer.tab.oem')}
    </button>
  </div>

  <!-- Content Container (Spacious, Crisp & High-Contrast) -->
  <div class="p-8 sm:p-12 bg-white min-h-[480px]">

    <!-- 1. PUBLIC / CONSUMER VIEW -->
    <div id="view-public" class="passport-view space-y-8">
      
      <!-- Battery Hero Header -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 p-6 sm:p-8 rounded-2xl bg-stone-50/80 border border-stone-200/80">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="px-2.5 py-0.5 rounded-md text-[11px] font-bold bg-stone-200 text-stone-800">EV TRACTION PACK</span>
            <span class="text-xs font-mono text-stone-500">UID: BP-88902-EU</span>
          </div>
          <h4 class="text-xl sm:text-2xl font-bold text-stone-900">ApexVolt High-Density NMC 811 Pack</h4>
          <p class="text-xs text-stone-500 mt-1">Manufacturer: Apex Energy Technologies Europe GmbH (Munich)</p>
        </div>
        <div class="text-left sm:text-right sm:border-l sm:border-stone-200 sm:pl-8">
          <div class="text-xs text-stone-400 uppercase tracking-wider font-medium">Rated Capacity</div>
          <div class="text-3xl font-extrabold font-mono text-stone-900">82.4 <span class="text-sm font-normal text-stone-500">kWh</span></div>
        </div>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6">
        <div class="p-5 rounded-2xl bg-white border border-stone-200/90 shadow-xs">
          <div class="text-xs text-stone-500 font-medium">Carbon Footprint (PCF)</div>
          <div class="text-2xl font-bold font-mono text-emerald-700 mt-1.5">68.2 <span class="text-xs text-stone-400 font-sans">kg CO₂e/kWh</span></div>
          <div class="text-[11px] text-emerald-700 font-medium mt-1">Class A Rating (PEFCR)</div>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-stone-200/90 shadow-xs">
          <div class="text-xs text-stone-500 font-medium">Recycled Content</div>
          <div class="text-2xl font-bold font-mono text-stone-900 mt-1.5">16.8%</div>
          <div class="text-[11px] text-stone-500 mt-1">Co: 18% | Li: 12% | Ni: 15%</div>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-stone-200/90 shadow-xs">
          <div class="text-xs text-stone-500 font-medium">Expected Lifetime</div>
          <div class="text-2xl font-bold font-mono text-stone-900 mt-1.5">3,000 <span class="text-xs text-stone-400 font-sans">Cycles</span></div>
          <div class="text-[11px] text-stone-500 mt-1">8 Years / 160,000 km</div>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-stone-200/90 shadow-xs">
          <div class="text-xs text-stone-500 font-medium">Recyclability Rate</div>
          <div class="text-2xl font-bold font-mono text-teal-700 mt-1.5">94.5%</div>
          <div class="text-[11px] text-stone-500 mt-1">EU Directive Compliant</div>
        </div>
      </div>

      <!-- General Consumer Instructions -->
      <div class="p-5 rounded-2xl bg-stone-50 border border-stone-200/80 text-xs text-stone-600 space-y-2">
        <div class="font-semibold text-stone-900 flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Consumer End-of-Life & Safety Information
        </div>
        <p class="leading-relaxed font-normal">
          This battery is designed for closed-loop recycling. At the end of vehicle life, deliver to an authorized treatment facility (ATF) in accordance with Directive 2000/53/EC. Do not dispose of as unsorted municipal waste.
        </p>
      </div>

    </div>

    <!-- 2. CUSTOMS & REGULATORY VIEW -->
    <div id="view-customs" class="passport-view hidden space-y-8">
      
      <div class="p-5 rounded-2xl bg-emerald-50/70 border border-emerald-200 flex items-center justify-between">
        <div class="flex items-center gap-3.5">
          <div class="w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-bold text-sm">✓</div>
          <div>
            <div class="text-base font-bold text-stone-900">EU Conformity & Market Access Granted</div>
            <div class="text-xs text-stone-600">Notified Body Audit: TÜV Rheinland (ID: NB-0035-2026-BATT)</div>
          </div>
        </div>
        <span class="px-3 py-1 rounded-full text-xs font-mono bg-emerald-100 text-emerald-900 font-bold border border-emerald-300">CE MARKED</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
        <div class="p-6 rounded-2xl bg-white border border-stone-200 space-y-3.5 shadow-xs">
          <div class="font-bold text-stone-900 text-sm">Legal Compliance Dossier</div>
          <div class="flex justify-between py-1.5 border-b border-stone-100">
            <span class="text-stone-500">EU Regulation Articles:</span>
            <span class="font-mono text-stone-900 font-medium">Articles 7, 8, 10, 13, 77</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-stone-100">
            <span class="text-stone-500">Declaration of Conformity (DoC):</span>
            <span class="font-mono text-stone-900 font-medium underline cursor-pointer">DoC_APEX_2026_09.pdf</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-stone-100">
            <span class="text-stone-500">UN 38.3 Safety Test:</span>
            <span class="font-mono text-emerald-700 font-semibold">PASSED (Report #TR-8812)</span>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-stone-200 space-y-3.5 shadow-xs">
          <div class="font-bold text-stone-900 text-sm">OECD Supply Chain Due Diligence</div>
          <div class="flex justify-between py-1.5 border-b border-stone-100">
            <span class="text-stone-500">Cobalt Provenance:</span>
            <span class="font-mono text-stone-900 font-medium">RCS Global Audited (Mine ID: DRC-L-44)</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-stone-100">
            <span class="text-stone-500">Lithium Origin:</span>
            <span class="font-mono text-stone-900 font-medium">IRMA Certified (Atacama Brine)</span>
          </div>
          <div class="flex justify-between py-1.5 border-b border-stone-100">
            <span class="text-stone-500">Audit Verification Hash:</span>
            <span class="font-mono text-stone-400 truncate max-w-[150px]">0x8f3a9e...4c21b</span>
          </div>
        </div>
      </div>

    </div>

    <!-- 3. RECYCLER VIEW -->
    <div id="view-recycler" class="passport-view hidden space-y-8">
      <div class="p-6 rounded-2xl bg-stone-50 border border-stone-200/90">
        <h5 class="text-sm font-bold text-stone-900 mb-4">Critical Raw Materials Bill of Materials (Exact Weights)</h5>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
          <div class="bg-white p-4 rounded-xl border border-stone-200 shadow-xs">
            <div class="text-xs text-stone-500">Cobalt (Co)</div>
            <div class="text-xl font-bold font-mono text-stone-900 mt-1">11.45 kg</div>
            <div class="text-[11px] text-stone-400">2.1% of Pack</div>
          </div>
          <div class="bg-white p-4 rounded-xl border border-stone-200 shadow-xs">
            <div class="text-xs text-stone-500">Lithium (Li)</div>
            <div class="text-xl font-bold font-mono text-stone-900 mt-1">7.82 kg</div>
            <div class="text-[11px] text-stone-400">1.4% of Pack</div>
          </div>
          <div class="bg-white p-4 rounded-xl border border-stone-200 shadow-xs">
            <div class="text-xs text-stone-500">Nickel (Ni)</div>
            <div class="text-xl font-bold font-mono text-stone-900 mt-1">48.90 kg</div>
            <div class="text-[11px] text-stone-400">8.9% of Pack</div>
          </div>
          <div class="bg-white p-4 rounded-xl border border-stone-200 shadow-xs">
            <div class="text-xs text-stone-500">Natural Graphite</div>
            <div class="text-xl font-bold font-mono text-stone-900 mt-1">62.30 kg</div>
            <div class="text-[11px] text-stone-400">11.3% of Pack</div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs">
        <div class="p-6 rounded-2xl bg-white border border-stone-200 space-y-2.5">
          <div class="font-bold text-stone-900 text-sm">Dismantling & Extinguishing Guidelines</div>
          <p class="text-stone-600 leading-relaxed">
            Chemistry: LiNi0.8Mn0.1Co0.1O2. High-voltage isolation switch located at Central Tunnel Interface. In case of thermal runaway, use continuous water flooding (minimum 10,000L).
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-white border border-stone-200 space-y-2.5">
          <div class="font-bold text-stone-900 text-sm">Second-Life & Repurposing Readiness</div>
          <p class="text-stone-600 leading-relaxed">
            Standard module architecture (8S4P). Compatible with stationary ESS BESS racking. Pinout diagrams and BMS CAN protocol specification v2.4 attached.
          </p>
        </div>
      </div>
    </div>

    <!-- 4. OEM VIEW -->
    <div id="view-oem" class="passport-view hidden space-y-8">
      
      <div class="p-5 rounded-2xl bg-stone-50 border border-stone-200 grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs">
        <div>
          <div class="text-stone-500">ZKP Privacy Shield</div>
          <div class="text-sm font-bold text-emerald-700 mt-1">Active (Trade Secret Protected)</div>
          <div class="text-[10px] text-stone-400">BOM pricing hidden from 3rd parties</div>
        </div>
        <div>
          <div class="text-stone-500">Real-Time BMS Telemetry Hook</div>
          <div class="text-sm font-bold text-stone-900 mt-1">Connected (SoH: 98.4%)</div>
          <div class="text-[10px] text-stone-400">Daily synchronization cycle</div>
        </div>
        <div>
          <div class="text-stone-500">Digital Signature</div>
          <div class="text-sm font-mono text-stone-900 mt-1 truncate">ECDSA-secp256k1 Signed</div>
          <div class="text-[10px] text-emerald-700">Verifiable Credential (W3C VC)</div>
        </div>
      </div>

      <div class="p-6 rounded-2xl bg-stone-900 border border-stone-800 font-mono text-xs text-stone-300 overflow-x-auto shadow-md">
        <div class="text-stone-400 text-[10px] mb-2 uppercase tracking-wider">// API JSON-LD Payload (Battery Pass Standard v2.1)</div>
        <pre class="text-stone-200 leading-relaxed">
{`{
  "@context": ["https://schema.eudppprovider.com/v1/batterypassport.jsonld"],
  "id": "urn:eudpp:battery:pack:APEX-88902-2027",
  "issuer": "did:eudpp:authority:apex-energy",
  "issuanceDate": "2026-11-14T08:00:00Z",
  "batteryPassportData": {
    "carbonFootprint": {
      "lifecycleGwpTotal": 68.2,
      "performanceClass": "A",
      "pefcrStandard": "PEFCR-Batteries-v2.1"
    },
    "provenance": {
      "zkProofHash": "0x4e9c71a391d8e12b7a8...",
      "dueDiligenceAudited": true
    }
  }
}`}
        </pre>
      </div>

    </div>

  </div>
</div>

<script>
  const tabBtns = document.querySelectorAll('.passport-tab-btn');
  const views = document.querySelectorAll('.passport-view');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => {
        b.classList.remove('active', 'bg-white', 'text-stone-900', 'border-stone-200', 'shadow-xs');
        b.classList.add('text-stone-500', 'border-transparent');
      });
      btn.classList.add('active', 'bg-white', 'text-stone-900', 'border-stone-200', 'shadow-xs');
      btn.classList.remove('text-stone-500', 'border-transparent');

      const targetId = btn.getAttribute('data-target');
      views.forEach(v => {
        if (v.id === targetId) {
          v.classList.remove('hidden');
        } else {
          v.classList.add('hidden');
        }
      });
    });
  });
</script>
