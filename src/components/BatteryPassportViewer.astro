---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="neo-surface p-6 sm:p-8">
  
  <!-- Top Simulated GS1 URL Status Bar (Neomorphic Well) -->
  <div class="neo-well px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3 mb-6">
    <div class="flex items-center gap-2.5">
      <span class="w-2.5 h-2.5 rounded-full bg-green-500 animate-pulse"></span>
      <span class="font-mono text-xs text-slate-700 font-semibold truncate max-w-xs sm:max-w-md">
        https://id.eudppprovider.com/01/04012345999991/21/BP-2027-EU-88902
      </span>
    </div>
    <span class="text-[11px] font-mono font-bold text-green-700 bg-green-100/80 px-2.5 py-0.5 rounded-full">
      eIDAS QSeal Verified
    </span>
  </div>

  <!-- Role Selector Pills (Tactile Neomorphic Tabs) -->
  <div class="flex flex-wrap gap-2 mb-6">
    <button 
      id="tab-btn-public" 
      class="neo-pill-active px-4 py-2 rounded-full text-xs font-bold transition-all"
      onclick="switchPassportRole('public')"
    >
      👁️ Public View
    </button>

    <button 
      id="tab-btn-customs" 
      class="neo-pill px-4 py-2 rounded-full text-xs font-bold text-slate-700 transition-all"
      onclick="switchPassportRole('customs')"
    >
      🏛️ Customs & Authority (DoC)
    </button>

    <button 
      id="tab-btn-recycler" 
      class="neo-pill px-4 py-2 rounded-full text-xs font-bold text-slate-700 transition-all"
      onclick="switchPassportRole('recycler')"
    >
      ♻️ Dismantler / Recycler
    </button>

    <button 
      id="tab-btn-oem" 
      class="neo-pill px-4 py-2 rounded-full text-xs font-bold text-slate-700 transition-all"
      onclick="switchPassportRole('oem')"
    >
      ⚙️ OEM / Cloud BMS
    </button>
  </div>

  <!-- Main Content Card -->
  <div class="p-6 rounded-2xl bg-white/70 border border-white/90 shadow-sm min-h-[320px]">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200/80">
      <div>
        <div class="text-[11px] font-mono text-slate-400 uppercase tracking-wider">Model: APEX-EV-Pack-82kWh · Traction Battery</div>
        <h4 class="text-lg sm:text-xl font-bold text-slate-900 mt-0.5">High-Energy NMC 811 Traction Battery System</h4>
      </div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-green-100 text-green-800 text-xs font-bold self-start sm:self-auto">
        <span>✓ Regulation EU 2023/1542 Conformity Granted</span>
      </div>
    </div>

    <!-- VIEW 1: PUBLIC / CONSUMER VIEW -->
    <div id="view-public" class="role-view pt-5">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        
        <div class="neo-well p-4">
          <div class="text-[11px] font-mono font-bold text-slate-500 uppercase">Carbon Footprint (PCF)</div>
          <div class="text-2xl font-extrabold text-green-700 mt-1">68.4 <span class="text-xs font-normal text-slate-500">kg CO₂e/kWh</span></div>
          <div class="text-[11px] text-slate-600 mt-1">EU Rating: <strong class="text-green-700">Class A (Top 10%)</strong></div>
        </div>

        <div class="neo-well p-4">
          <div class="text-[11px] font-mono font-bold text-slate-500 uppercase">Capacity & Voltage</div>
          <div class="text-2xl font-extrabold text-navy-900 mt-1">82.0 <span class="text-xs font-normal text-slate-500">kWh</span></div>
          <div class="text-[11px] text-slate-600 mt-1">Architecture: <strong class="text-slate-900 font-mono">800V System</strong></div>
        </div>

        <div class="neo-well p-4">
          <div class="text-[11px] font-mono font-bold text-slate-500 uppercase">Circularity Share</div>
          <div class="text-2xl font-extrabold text-cyan-700 mt-1">94.2% <span class="text-xs font-normal text-slate-500">Recyclability</span></div>
          <div class="text-[11px] text-slate-600 mt-1">Recycled Cobalt: <strong class="text-green-700 font-mono">18.5%</strong></div>
        </div>

      </div>
    </div>

    <!-- VIEW 2: CUSTOMS & AUTHORITIES VIEW -->
    <div id="view-customs" class="role-view hidden pt-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="neo-well p-4 space-y-2 text-xs">
          <div class="font-bold text-slate-900 mb-1">Declaration of Conformity (DoC)</div>
          <div class="flex justify-between py-1 border-b border-slate-200/60">
            <span class="text-slate-500">EU DoC File:</span>
            <span class="font-mono font-bold text-cyan-700">DOC-2023-1542-APEX.pdf (Signed)</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-200/60">
            <span class="text-slate-500">Notified Body:</span>
            <span class="font-mono text-slate-800">NB 0123 (TÜV SÜD)</span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-slate-500">Safety Test:</span>
            <span class="font-mono font-bold text-green-700">UN GTR 20 / ECE R100 Passed</span>
          </div>
        </div>

        <div class="neo-well p-4 space-y-2 text-xs">
          <div class="font-bold text-slate-900 mb-1">OECD Supply Chain Due Diligence</div>
          <div class="flex justify-between py-1 border-b border-slate-200/60">
            <span class="text-slate-500">Cobalt Sourcing:</span>
            <span class="font-mono font-bold text-green-700">RMI Audited / Conflict-Free</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-200/60">
            <span class="text-slate-500">Lithium Origin:</span>
            <span class="font-mono text-slate-800">IRMA Certified Origin</span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-slate-500">Human Rights (CSDDD):</span>
            <span class="font-mono font-bold text-green-700">Full 3rd Party Report Attached</span>
          </div>
        </div>
      </div>
    </div>

    <!-- VIEW 3: RECYCLERS VIEW -->
    <div id="view-recycler" class="role-view hidden pt-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="neo-well p-4 text-xs space-y-1.5">
          <div class="font-bold text-slate-900 mb-1">Precious & Critical Raw Materials</div>
          <div class="flex justify-between py-1 border-b border-slate-200/60">
            <span class="text-slate-500">Cobalt (Co):</span>
            <span class="font-mono font-bold text-slate-800">11.45 kg</span>
          </div>
          <div class="flex justify-between py-1 border-b border-slate-200/60">
            <span class="text-slate-500">Lithium (Li):</span>
            <span class="font-mono font-bold text-slate-800">7.20 kg</span>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-slate-500">Nickel (Ni):</span>
            <span class="font-mono font-bold text-slate-800">48.60 kg</span>
          </div>
        </div>

        <div class="neo-well p-4 text-xs space-y-1.5">
          <div class="font-bold text-slate-900 mb-1">Disassembly & Safety Guidance</div>
          <p class="text-slate-600"><strong>Enclosure:</strong> 24x Torx Plus M8 bolts (Torque: 28 Nm). Non-destructive removal.</p>
          <p class="text-slate-600"><strong>Coolant:</strong> 8.5L Water-Glycol. Drain via Port B before dismantling.</p>
        </div>
      </div>
    </div>

    <!-- VIEW 4: OEM / BMS VIEW -->
    <div id="view-oem" class="role-view hidden pt-5">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="neo-well p-4">
          <div class="text-[11px] font-mono font-bold text-slate-500 uppercase">State of Health (SOH)</div>
          <div class="text-2xl font-extrabold text-navy-900 mt-1">98.6%</div>
          <div class="text-[11px] text-slate-600 mt-1">Cycles: <strong class="font-mono text-slate-900">142</strong></div>
        </div>

        <div class="neo-well p-4">
          <div class="text-[11px] font-mono font-bold text-slate-500 uppercase">Vehicle Pairing</div>
          <div class="font-mono text-sm font-bold text-navy-900 mt-1">VIN: WBA11209384...</div>
          <div class="text-[11px] text-slate-600 mt-1">Digital Twin: <strong class="text-green-700">Active</strong></div>
        </div>

        <div class="neo-well p-4">
          <div class="text-[11px] font-mono font-bold text-slate-500 uppercase">ZKP Privacy Status</div>
          <div class="text-base font-bold text-green-700 mt-1">Shield Active</div>
          <div class="text-[11px] text-slate-600 mt-1">BOM Secrets: <strong class="text-slate-500">Zero-Leak</strong></div>
        </div>
      </div>
    </div>

  </div>

  <!-- Illustrative Sample Data Disclaimer -->
  <div class="mt-4 px-4 py-2.5 rounded-xl bg-slate-100/80 border border-slate-200/80 flex items-center justify-between gap-3 text-[11px] text-slate-500">
    <div class="flex items-center gap-1.5">
      <span class="text-amber-600 font-bold">ℹ️</span>
      <span><strong>Illustrative sample data:</strong> Simulated dataset for technical architecture and role-based access demonstration. No official affiliation or certification relationship implied.</span>
    </div>
    <a href="mailto:info@eudppprovider.com" class="text-cyan-700 hover:text-cyan-800 font-bold whitespace-nowrap hidden sm:inline">
      Request Custom Spec Demo →
    </a>
  </div>

</div>

<script is:inline>
  function switchPassportRole(role) {
    const roles = ['public', 'customs', 'recycler', 'oem'];

    roles.forEach(r => {
      const view = document.getElementById(`view-${r}`);
      const btn = document.getElementById(`tab-btn-${r}`);
      if (view && btn) {
        if (r === role) {
          view.classList.remove('hidden');
          btn.className = 'neo-pill-active px-4 py-2 rounded-full text-xs font-bold transition-all';
        } else {
          view.classList.add('hidden');
          btn.className = 'neo-pill px-4 py-2 rounded-full text-xs font-bold text-slate-700 transition-all';
        }
      }
    });
  }
</script>
