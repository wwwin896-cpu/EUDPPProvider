---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-[#E6ECF2] border-t border-slate-300/80 pt-16 pb-12 text-slate-600 text-xs sm:text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-300/80">
      
      <!-- Brand Description -->
      <div class="lg:col-span-2 space-y-3.5">
        <a href={`/${lang === 'en' ? '' : lang}`} class="inline-block">
          <img 
            src="/eudpp_logo_light.svg" 
            alt="EU DPP Provider Logo" 
            class="h-9 w-auto object-contain"
          />
        </a>
        <p class="text-slate-600 text-xs sm:text-sm leading-relaxed max-w-sm pt-1">
          Enterprise Digital Product Passport (DPP) platform & sovereign compliance data vault. Built for global EV, LMT, and industrial battery supply chains under EU Regulation 2023/1542.
        </p>
        <div class="pt-1">
          <div class="text-xs font-mono font-bold text-slate-800">
            Business Desk: <a href="mailto:info@eudppprovider.com" class="text-cyan-700 hover:text-cyan-800">info@eudppprovider.com</a>
          </div>
          <div class="text-[11px] text-slate-500 mt-0.5">Frankfurt · Munich · Shanghai</div>
        </div>
      </div>

      <!-- Solutions Column -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3.5">{t('nav.solutions')}</h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}battery-passport`} class="hover:text-cyan-700 transition-colors font-semibold text-slate-800">
              Battery Passport Hub
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}pilot-program`} class="hover:text-cyan-700 transition-colors font-bold text-cyan-800">
              Early Adopter Pilot Program
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}portal-simulator/`} class="hover:text-purple-700 transition-colors font-bold text-purple-800">
              Portal Simulator (Sandbox)
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/ev-battery-passport`} class="hover:text-cyan-700 transition-colors">
              {t('nav.evBattery')}
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/lmt-battery-passport`} class="hover:text-cyan-700 transition-colors">
              {t('nav.lmtBattery')}
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/storage-battery-passport`} class="hover:text-cyan-700 transition-colors">
              {t('nav.storageBattery')}
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/software-license`} class="hover:text-cyan-700 transition-colors">
              {t('nav.software')}
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting`} class="hover:text-cyan-700 transition-colors">
              {t('nav.hosting')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Platform & Tech -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3.5">{t('nav.platform')}</h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}platform/carbon-footprint-engine`} class="hover:text-cyan-700 transition-colors">
              {t('nav.pcf')}
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}platform/gs1-qr-serialization`} class="hover:text-cyan-700 transition-colors">
              {t('nav.gs1')}
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}pricing`} class="hover:text-cyan-700 transition-colors">
              {t('nav.pricing')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Regulatory & Standards -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 mb-3.5">Regulation & Registry</h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-battery-regulation-2023-1542`} class="hover:text-cyan-700 transition-colors">
              {t('nav.regulation')}
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/data-requirements`} class="hover:text-cyan-700 transition-colors font-medium text-slate-800">
              90+ Mandatory Data Checklist
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/en-standards-guide`} class="hover:text-cyan-700 transition-colors font-medium text-slate-800">
              EN 18220 / 18219 Standards
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-dpp-registry-guide`} class="hover:text-cyan-700 transition-colors">
              {t('nav.registry')}
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}about`} class="hover:text-cyan-700 transition-colors">
              {t('nav.about')}
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}legal-notice`} class="hover:text-cyan-700 transition-colors">
              Legal Notice (Impressum)
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}security`} class="hover:text-cyan-700 transition-colors">
              Security Architecture
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <div>
        © 2026 EU DPP Provider (eudppprovider.com). All rights reserved.
      </div>
      <div class="flex flex-wrap items-center gap-4 sm:gap-6">
        <a href={`/${lang === 'en' ? '' : lang + '/'}privacy`} class="hover:text-slate-700 transition-colors">Privacy Policy</a>
        <a href={`/${lang === 'en' ? '' : lang + '/'}legal-notice`} class="hover:text-slate-700 transition-colors">Legal Notice (Impressum)</a>
        <a href={`/${lang === 'en' ? '' : lang + '/'}security`} class="hover:text-slate-700 transition-colors">Security & Vault</a>
        <a href={`/${lang === 'en' ? '' : lang + '/'}terms`} class="hover:text-slate-700 transition-colors">Terms & SLA</a>
      </div>
    </div>

  </div>
</footer>
