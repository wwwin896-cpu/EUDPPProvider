---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-navy-900 border-t border-navy-800 pt-20 pb-16 text-slate-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 pb-16 border-b border-navy-800">
      
      <!-- Brand Description -->
      <div class="lg:col-span-2 space-y-4">
        <a href={`/${lang === 'en' ? '' : lang}`} class="inline-block">
          <img 
            src="/eudpp_logo_dark.svg" 
            alt="EU DPP Provider Logo" 
            class="h-10 w-auto object-contain"
          />
        </a>
        <p class="text-slate-400 text-sm leading-relaxed max-w-sm pt-2">
          Enterprise Digital Product Passport (DPP) platform & sovereign compliance data vault. Built for global battery supply chains under EU Regulation 2023/1542.
        </p>
        <div class="flex items-center gap-2 pt-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono font-medium bg-navy-800 text-cyan-500 border border-navy-700">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
            EU 2023/1542 Ready
          </span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono font-medium bg-navy-800 text-slate-300 border border-navy-700">
            GS1 Digital Link
          </span>
        </div>
      </div>

      <!-- Solutions Column -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-4">{t('nav.solutions')}</h4>
        <ul class="space-y-3">
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/ev-battery-passport`} class="hover:text-cyan-500 transition-colors">
              {t('nav.evBattery')}
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/storage-battery-passport`} class="hover:text-cyan-500 transition-colors">
              {t('nav.storageBattery')}
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/software-license`} class="hover:text-cyan-500 transition-colors">
              {t('nav.software')}
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting`} class="hover:text-cyan-500 transition-colors">
              {t('nav.hosting')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Platform & Tech -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-4">{t('nav.platform')}</h4>
        <ul class="space-y-3">
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}platform/carbon-footprint-engine`} class="hover:text-cyan-500 transition-colors">
              {t('nav.pcf')}
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}platform/gs1-qr-serialization`} class="hover:text-cyan-500 transition-colors">
              {t('nav.gs1')}
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-battery-regulation-2023-1542`} class="hover:text-cyan-500 transition-colors">
              {t('nav.regulation')}
            </a>
          </li>
          <li>
            <a href={`/${lang === 'en' ? '' : lang + '/'}pricing`} class="hover:text-cyan-500 transition-colors">
              {t('nav.pricing')}
            </a>
          </li>
        </ul>
      </div>

      <!-- Compliance & Standards -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-4">Interoperability</h4>
        <ul class="space-y-3">
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
            <span>Catena-X Aligned</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
            <span>Battery Pass Consortium</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
            <span>Cirpass Architecture</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
            <span>ISO 14040/44 PEFCR</span>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        © 2026 EU DPP Provider (eudppprovider.com). All rights reserved.
      </div>
      <div class="flex items-center space-x-6">
        <a href="#" class="hover:text-slate-400 transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-slate-400 transition-colors">Security & Data Vault</a>
        <a href="#" class="hover:text-slate-400 transition-colors">Terms of Service</a>
      </div>
    </div>

  </div>
</footer>
