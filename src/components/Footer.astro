---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-slate-950 border-t border-slate-900 pt-16 pb-12 text-slate-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-900">
      
      <!-- Company / Brand Column -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-500 to-accent-emerald flex items-center justify-center p-0.5">
            <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
              <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
          </div>
          <span class="text-lg font-bold text-white tracking-tight">EU DPP Provider</span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
          {t('footer.tagline')}
        </p>

        <!-- Compliance & Standard Badges -->
        <div class="pt-2 flex flex-wrap gap-2">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] font-mono bg-slate-900 text-slate-300 border border-slate-800">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-emerald"></span>
            EU 2023/1542
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] font-mono bg-slate-900 text-slate-300 border border-slate-800">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-400"></span>
            GS1 Digital Link
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] font-mono bg-slate-900 text-slate-300 border border-slate-800">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-teal"></span>
            Catena-X Aligned
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] font-mono bg-slate-900 text-slate-300 border border-slate-800">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            ISO 14040/44 LCA
          </span>
        </div>
      </div>

      <!-- Solutions Column -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-slate-200 tracking-wider uppercase">{t('nav.solutions')}</h3>
        <ul class="space-y-2 text-xs">
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}solutions/ev-battery-passport`} class="hover:text-brand-400 transition-colors">{t('nav.evBattery')}</a></li>
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}solutions/storage-battery-passport`} class="hover:text-brand-400 transition-colors">{t('nav.storageBattery')}</a></li>
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}solutions/software-license`} class="hover:text-brand-400 transition-colors">{t('nav.software')}</a></li>
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting`} class="hover:text-brand-400 transition-colors">{t('nav.hosting')}</a></li>
        </ul>
      </div>

      <!-- Platform & Tech -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-slate-200 tracking-wider uppercase">{t('nav.platform')}</h3>
        <ul class="space-y-2 text-xs">
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}platform/carbon-footprint-engine`} class="hover:text-brand-400 transition-colors">{t('nav.pcf')}</a></li>
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}platform/gs1-qr-serialization`} class="hover:text-brand-400 transition-colors">{t('nav.gs1')}</a></li>
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-battery-regulation-2023-1542`} class="hover:text-brand-400 transition-colors">{t('nav.regulation')}</a></li>
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}pricing`} class="hover:text-brand-400 transition-colors">{t('nav.pricing')}</a></li>
        </ul>
      </div>

      <!-- Contact & Office -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-slate-200 tracking-wider uppercase">Contact & Global Support</h3>
        <ul class="space-y-2 text-xs">
          <li class="flex items-center gap-1.5 text-slate-300">
            <svg class="w-3.5 h-3.5 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            contact@eudppprovider.com
          </li>
          <li class="text-slate-400">
            Frankfurt / Munich / Shanghai / Shenzhen
          </li>
          <li class="pt-2">
            <a href={`/${lang === 'en' ? '' : lang + '/'}contact`} class="inline-flex items-center gap-1 text-xs font-semibold text-brand-400 hover:text-brand-300 underline">
              {t('nav.contact')} &rarr;
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <div>
        &copy; {new Date().getFullYear()} EU DPP Provider (eudppprovider.com). {t('footer.rights')}
      </div>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="hover:text-slate-300">Privacy Policy</a>
        <a href="/terms" class="hover:text-slate-300">Terms of Service</a>
        <a href="/security" class="hover:text-slate-300">Data Security & ZKP</a>
      </div>
    </div>

  </div>
</footer>
