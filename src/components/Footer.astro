---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-white border-t border-stone-200/90 pt-20 pb-16 text-stone-600 text-sm">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 pb-16 border-b border-stone-200/80">
      
      <!-- Brand Description -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-xl bg-stone-900 text-white flex items-center justify-center font-bold text-xs">
            EU
          </div>
          <span class="text-lg font-semibold text-stone-900 tracking-tight">EU DPP Provider</span>
        </div>
        <p class="text-sm text-stone-500 leading-relaxed max-w-sm">
          {t('footer.tagline')}
        </p>

        <!-- Compliance Badges (Subtle Minimalist Tags) -->
        <div class="pt-2 flex flex-wrap gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono bg-stone-100 text-stone-700 border border-stone-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
            EU 2023/1542
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono bg-stone-100 text-stone-700 border border-stone-200">
            <span class="w-1.5 h-1.5 rounded-full bg-stone-500"></span>
            GS1 Digital Link
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono bg-stone-100 text-stone-700 border border-stone-200">
            <span class="w-1.5 h-1.5 rounded-full bg-teal-600"></span>
            Catena-X Ready
          </span>
        </div>
      </div>

      <!-- Solutions -->
      <div class="space-y-3.5">
        <h3 class="text-xs font-semibold text-stone-900 tracking-wider uppercase">{t('nav.solutions')}</h3>
        <ul class="space-y-2.5 text-xs text-stone-600">
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}solutions/ev-battery-passport`} class="hover:text-stone-900 transition-colors">{t('nav.evBattery')}</a></li>
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}solutions/storage-battery-passport`} class="hover:text-stone-900 transition-colors">{t('nav.storageBattery')}</a></li>
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}solutions/software-license`} class="hover:text-stone-900 transition-colors">{t('nav.software')}</a></li>
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}solutions/managed-data-hosting`} class="hover:text-stone-900 transition-colors">{t('nav.hosting')}</a></li>
        </ul>
      </div>

      <!-- Platform -->
      <div class="space-y-3.5">
        <h3 class="text-xs font-semibold text-stone-900 tracking-wider uppercase">{t('nav.platform')}</h3>
        <ul class="space-y-2.5 text-xs text-stone-600">
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}platform/carbon-footprint-engine`} class="hover:text-stone-900 transition-colors">{t('nav.pcf')}</a></li>
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}platform/gs1-qr-serialization`} class="hover:text-stone-900 transition-colors">{t('nav.gs1')}</a></li>
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}compliance/eu-battery-regulation-2023-1542`} class="hover:text-stone-900 transition-colors">{t('nav.regulation')}</a></li>
          <li><a href={`/${lang === 'en' ? '' : lang + '/'}pricing`} class="hover:text-stone-900 transition-colors">{t('nav.pricing')}</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="space-y-3.5">
        <h3 class="text-xs font-semibold text-stone-900 tracking-wider uppercase">Offices & Advisory</h3>
        <ul class="space-y-2 text-xs text-stone-600">
          <li class="font-medium text-stone-900">
            contact@eudppprovider.com
          </li>
          <li>
            Frankfurt am Main &bull; Munich &bull; Shanghai
          </li>
          <li class="pt-1">
            <a href={`/${lang === 'en' ? '' : lang + '/'}contact`} class="text-xs font-medium text-stone-900 hover:text-emerald-700 underline underline-offset-2">
              {t('nav.contact')} &rarr;
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-400">
      <div>
        &copy; {new Date().getFullYear()} EU DPP Provider. {t('footer.rights')}
      </div>
      <div class="flex items-center gap-6 text-stone-500">
        <a href="/privacy" class="hover:text-stone-900">Privacy Notice</a>
        <a href="/terms" class="hover:text-stone-900">Terms of Service</a>
        <a href="/security" class="hover:text-stone-900">Security & ZKP Architecture</a>
      </div>
    </div>

  </div>
</footer>
