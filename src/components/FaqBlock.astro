---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  eyebrow?: string;
  heading?: string;
  id?: string;
}

const { items, eyebrow = 'Frequently Asked Questions', heading, id = 'faq' } = Astro.props;
---

{items.length > 0 && (
  <section id={id} class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <div class="eyebrow-pill mb-2 mx-auto">{eyebrow}</div>
      {heading && (
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">{heading}</h2>
      )}
    </div>
    <div class="space-y-3">
      {items.map((item) => (
        <details class="neo-surface p-5 group" data-faq>
          <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
            <h3 class="text-sm sm:text-base font-bold text-slate-900 leading-snug">{item.question}</h3>
            <span class="shrink-0 mt-0.5 text-cyan-700 text-lg leading-none transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-slate-600 leading-relaxed">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}
