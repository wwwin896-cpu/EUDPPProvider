const tLocal = translations[lang as keyof typeof translations] || translations.en;
---

<section class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  
  <!-- Section Title -->
  <div class="text-center max-w-3xl mx-auto mb-16">
    <div class="eyebrow-pill mb-3 mx-auto">
      <span class="w-2 h-2 rounded-full bg-cyan-600 animate-pulse"></span>
      <span>{tLocal.badge}</span>
    </div>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
      {tLocal.title}
    </h2>
    <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed">
      {tLocal.subtitle}
    </p>
  </div>

  <!-- Multi-Category Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
    
    <!-- 01 Batteries (Core Priority) -->
    <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between border-2 border-cyan-500/30 relative overflow-hidden group hover:border-cyan-500/60 transition-all">
      <div class="absolute top-0 right-0 bg-cyan-600 text-white font-mono text-[10px] font-bold px-3 py-1 rounded-bl-xl uppercase tracking-wider">
        Mandatory 2027
      </div>
      <div>
        <div class="w-12 h-12 rounded-2xl bg-cyan-100 text-cyan-800 flex items-center justify-center font-bold text-xl mb-4">
          🔋
        </div>
        <div class="text-[11px] font-mono font-bold text-cyan-700 uppercase tracking-wider">{tLocal.cat1Reg}</div>
        <h3 class="text-xl font-bold text-slate-900 mt-1 mb-2">{tLocal.cat1Title}</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          {tLocal.cat1Desc}
        </p>
      </div>
      <div class="mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between text-xs font-bold">
        <span class="text-slate-500">Annex XIII Ready</span>
        <a href={`/${lang === 'en' ? '' : lang + '/'}battery-passport`} class="text-cyan-700 hover:text-cyan-800 flex items-center gap-1">
          <span>Explore Battery Hub</span> →
        </a>
      </div>
    </div>

    <!-- 02 Industrial BESS -->
    <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between group hover:border-green-500/50 transition-all">
      <div>
        <div class="w-12 h-12 rounded-2xl bg-green-100 text-green-800 flex items-center justify-center font-bold text-xl mb-4">
          ⚡
        </div>
        <div class="text-[11px] font-mono font-bold text-green-700 uppercase tracking-wider">{tLocal.cat4Reg}</div>
        <h3 class="text-xl font-bold text-slate-900 mt-1 mb-2">{tLocal.cat4Title}</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          {tLocal.cat4Desc}
        </p>
      </div>
      <div class="mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between text-xs font-bold">
        <span class="text-slate-500">Telematics & SOH</span>
        <a href={`/${lang === 'en' ? '' : lang + '/'}solutions/storage-battery-passport`} class="text-green-700 hover:text-green-800 flex items-center gap-1">
          <span>Explore BESS</span> →
        </a>
      </div>
    </div>

    <!-- 03 Textiles -->
    <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between group hover:border-purple-500/50 transition-all">
      <div>
        <div class="w-12 h-12 rounded-2xl bg-purple-100 text-purple-800 flex items-center justify-center font-bold text-xl mb-4">
          👕
        </div>
        <div class="text-[11px] font-mono font-bold text-purple-700 uppercase tracking-wider">{tLocal.cat2Reg}</div>
        <h3 class="text-xl font-bold text-slate-900 mt-1 mb-2">{tLocal.cat2Title}</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          {tLocal.cat2Desc}
        </p>
      </div>
      <div class="mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between text-xs font-bold">
        <span class="text-slate-500">Fiber Traceability</span>
        <span class="text-purple-700">ESPR Roadmap</span>
      </div>
    </div>

    <!-- 04 Consumer Electronics -->
    <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between group hover:border-blue-500/50 transition-all">
      <div>
        <div class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-800 flex items-center justify-center font-bold text-xl mb-4">
          📱
        </div>
        <div class="text-[11px] font-mono font-bold text-blue-700 uppercase tracking-wider">{tLocal.cat3Reg}</div>
        <h3 class="text-xl font-bold text-slate-900 mt-1 mb-2">{tLocal.cat3Title}</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          {tLocal.cat3Desc}
        </p>
      </div>
      <div class="mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between text-xs font-bold">
        <span class="text-slate-500">WEEE & Eco-design</span>
        <span class="text-blue-700">ESPR Standard</span>
      </div>
    </div>

    <!-- 05 Construction & Furniture -->
    <div class="neo-surface p-7 sm:p-8 flex flex-col justify-between group hover:border-amber-500/50 transition-all md:col-span-2 lg:col-span-2">
      <div>
        <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center font-bold text-xl mb-4">
          🪵
        </div>
        <div class="text-[11px] font-mono font-bold text-amber-700 uppercase tracking-wider">{tLocal.cat5Reg}</div>
        <h3 class="text-xl font-bold text-slate-900 mt-1 mb-2">{tLocal.cat5Title}</h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          {tLocal.cat5Desc}
        </p>
      </div>
      <div class="mt-6 pt-4 border-t border-slate-200/80 flex items-center justify-between text-xs font-bold">
        <span class="text-slate-500">Declaration of Performance (DoP)</span>
        <span class="text-amber-700">Circular Building</span>
      </div>
    </div>

  </div>

  <!-- Dual Granularity & Trust Boundaries Section -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    
    <!-- Left: Dual Granularity (Batch vs Item) -->
    <div class="neo-surface p-8 sm:p-10 space-y-6">
      <div>
        <div class="eyebrow-pill mb-2">Granularity Flexibility</div>
        <h3 class="text-2xl font-bold text-slate-900">{tLocal.granularityTitle}</h3>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">{tLocal.granularitySubtitle}</p>
      </div>

      <div class="space-y-4">
        <!-- Option A: Batch -->
        <div class="p-4 rounded-2xl bg-white/80 border border-slate-200/80 shadow-sm hover:border-cyan-400/50 transition-all">
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 rounded bg-slate-200 text-slate-800 font-mono text-[10px] font-bold">GTIN + Batch</span>
            <span class="font-bold text-slate-900 text-sm">{tLocal.batchTitle}</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            {tLocal.batchDesc}
          </p>
        </div>

        <!-- Option B: Serialized Item -->
        <div class="p-4 rounded-2xl bg-gradient-to-br from-white to-cyan-50/50 border border-cyan-200/80 shadow-sm hover:border-cyan-400 transition-all">
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2 py-0.5 rounded bg-cyan-600 text-white font-mono text-[10px] font-bold">SGTIN + Serial</span>
            <span class="font-bold text-slate-900 text-sm">{tLocal.itemTitle}</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            {tLocal.itemDesc}
          </p>
        </div>
      </div>
    </div>

    <!-- Right: Verifiable Data Trust Boundaries -->
    <div class="neo-surface p-8 sm:p-10 space-y-6">
      <div>
        <div class="eyebrow-pill mb-2">Data Governance</div>
        <h3 class="text-2xl font-bold text-slate-900">{tLocal.trustTitle}</h3>
